{
  "schema": "jovie-gate-weakening-detector/v1",
  "invariantId": "JOV-INV-045",
  "override": {
    "bodyLine": "^gate-change:\\s+(\\S.*)$",
    "label": "codeowners-approved"
  },
  "scanExclusions": [],
  "selfPaths": [
    "scripts/invariants/gate-weakening-detector.mjs",
