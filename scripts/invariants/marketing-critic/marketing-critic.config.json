{
  "schema": "jovie.marketing-critic-gate/v1",
  "mode": "shadow",
  "promoteToBlocking": false,
  "shadowStartedAt": "2026-10-29",
  "promotionRule": "A detector may move to blocking only when calibrate.mjs reports, for that detector: >=20 labeled defects and >=20 labeled clean routes for its class, precision >=0.9 with the 95% Wilson lower bound also >=0.9, class recall >=0.8, and PR-run observations spanning >=7 distinct days. Flip detectorModes.<id> to blocking and promoteToBlocking to true in the same PR; calibrate.mjs --check fails if a blocking detector does not meet the floors.",
  "hamelFloors": {
    "precisionMin": 0.9,
    "recallMin": 0.8
  },
  "minimums": {
    "positives": 20,
    "negatives": 20,
    "prRunDays": 7
  },
  "detectorModes": {
    "step-numbering": "shadow",
    "desktop-touch-copy": "shadow",
    "coming-soon-copy": "shadow",
    "animated-backdrop": "shadow",
    "saturated-gradient-bg": "shadow",
    "saturated-fold-pixels": "shadow",
    "eyebrow-caps": "shadow",
    "icon-tiles": "shadow",
    "square-focus-ring": "shadow",
    "cookie-overlap": "shadow",
    "repeated-headings": "shadow",
    "vertical-dead-band": "shadow"
  },
  "pixelShareMax": 0.02,
  "widths": [1440, 390],
  "routes": [
