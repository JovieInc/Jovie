[Unit]
Description=Gem (Ubuntu) Symphony Cursor CLI worker health and auto-update

[Service]
Type=oneshot
Environment=GEM_CURSOR_EXECUTABLE=%h/.local/bin/cursor-agent-std
Environment=GEM_CURSOR_BIN=%h/.local/bin/cursor-agent-std
Environment=CURSOR_AGENT_UPDATE=1
Environment=PATH=%h/.local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/cursor-cli-worker reconcile
# 0 ready; 2 typed fail-closed (do not restart-loop); other non-zero fails.
SuccessExitStatus=0 2
Restart=on-failure
RestartSec=30
