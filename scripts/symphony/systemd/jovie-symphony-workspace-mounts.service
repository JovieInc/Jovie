[Unit]
Description=Restore persisted Jovie Symphony workspace bind mounts
After=local-fs.target
RequiresMountsFor=/srv/worktrees /srv/models /srv/cache /srv/scratch /srv/git

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/jovie-symphony-workspace restore-all
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
