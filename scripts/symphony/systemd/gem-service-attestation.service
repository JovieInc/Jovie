[Unit]
Description=Observe source identity of the running official Symphony service
After=symphony-elixir.service
Requires=symphony-elixir.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/symphony/runner-source.env
ExecStart=/bin/sh -ec 'mode="$${GEM_SERVICE_ATTESTATION_MODE:-legacy}"; if [ "$$mode" = legacy ] && [ -n "$${SYMPHONY_RELEASE_PROVENANCE:-}" ] && [ -n "$${JOVIE_CONFIGURATION_SOURCE_ROOT:-}" ] && [ -n "$${JOVIE_CONFIGURATION_SOURCE_REVISION:-}" ] && [ -z "$${SYMPHONY_UPSTREAM_BINDING:-}" ] && [ -z "$${SYMPHONY_UPSTREAM_BINDING_SHA256:-}" ]; then exec /usr/bin/python3 "%h/gem-workspace/scripts/emit-gem-service-attestation.py" --provenance "$${SYMPHONY_RELEASE_PROVENANCE}" --source-root "$${JOVIE_CONFIGURATION_SOURCE_ROOT}" --source-revision "$${JOVIE_CONFIGURATION_SOURCE_REVISION}"; elif [ "$$mode" = upstream-preservation ] && [ -n "$${SYMPHONY_UPSTREAM_BINDING:-}" ] && [ -n "$${SYMPHONY_UPSTREAM_BINDING_SHA256:-}" ] && [ -z "$${SYMPHONY_RELEASE_PROVENANCE:-}" ] && [ -z "$${JOVIE_CONFIGURATION_SOURCE_ROOT:-}" ] && [ -z "$${JOVIE_CONFIGURATION_SOURCE_REVISION:-}" ] && [ -z "$${JOVIE_CONFIGURATION_PROFILE:-}" ]; then exec /usr/bin/python3 "%h/gem-workspace/scripts/emit-gem-service-attestation.py" --upstream-binding "$${SYMPHONY_UPSTREAM_BINDING}" --upstream-binding-sha256 "$${SYMPHONY_UPSTREAM_BINDING_SHA256}"; else exit 78; fi'
Nice=10
