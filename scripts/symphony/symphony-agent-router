#!/usr/bin/env bash
# Codex app-server launcher for the official :4041 Symphony service.
# CLI-only providers run in the isolated fallback worker, which shares this
# launcher's issue lease. They cannot enter the app-server protocol boundary.
set -euo pipefail

home="${SYMPHONY_HOME:-$HOME}"
workspace="${SYMPHONY_WORKSPACE:-$PWD}"
issue="${SYMPHONY_ISSUE_IDENTIFIER:-$(basename "$workspace")}"
# Every provider shares the same issue claim, before any capacity probe. Keep
# descriptor 9 inherited through exec; never unlink its stable pathname.
export SYMPHONY_FALLBACK_LEASE_DIR="${SYMPHONY_FALLBACK_LEASE_DIR:-$home/.local/state/symphony-fallback/leases}"
mkdir -p "$SYMPHONY_FALLBACK_LEASE_DIR"
issue_lock="$SYMPHONY_FALLBACK_LEASE_DIR/$issue.lock"
if [ "${SYMPHONY_ISSUE_LEASE_FD:-}" != "9" ]; then
  exec 9>>"$issue_lock"
fi
if ! python3 - "$issue_lock" <<'PY'
import fcntl, os, sys
try:
    descriptor, path = os.fstat(9), os.stat(sys.argv[1])
    if (descriptor.st_dev, descriptor.st_ino) != (path.st_dev, path.st_ino):
        raise OSError("inherited issue claim has a different inode")
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    raise SystemExit(1)
PY
then
  echo 'SYMPHONY_LAUNCHER_FAILURE schema=symphony-launcher-failure/v1 class=issue-lease-busy retryable=true reason="issue claim unavailable"' >&2
  exit 75
fi
export SYMPHONY_ISSUE_LEASE_FD=9
guard="${SYMPHONY_CAPACITY_GUARD:-$home/.local/bin/symphony-capacity-guard.py}"
codex_probe="${SYMPHONY_CODEX_ACCOUNT_PROBE:-$home/.local/bin/codex-account-probe}"
auto_route="${SYMPHONY_AUTO_ROUTE:-$home/.local/bin/symphony-auto-route.mjs}"
router_hotfix="${SYMPHONY_CODEX_ROUTER:-$home/.local/bin/symphony-codex-router-hotfix}"
state_dir="${SYMPHONY_PROVIDER_ROUTE_STATE_DIR:-$home/.local/state/symphony-provider-router}"

write_receipt() {
  local provider="$1" selected_model="$2" reason="$3" temporary
  mkdir -p "$state_dir"
  temporary="$state_dir/.${issue}.tmp.$$"
  python3 - "$issue" "$provider" "$selected_model" "$reason" "${SYMPHONY_POLICY_GENERATION:-symphony-routing-policy-v1}" >"$temporary" <<'PY'
import datetime, json, sys
print(json.dumps({
  "schema": "symphony-provider-route/v1",
  "authority": "symphony-agent-router",
  "issue": sys.argv[1],
  "provider": sys.argv[2],
  "model": sys.argv[3],
  "reason": sys.argv[4],
  "policyGeneration": sys.argv[5],
  "selectedRoute": {"provider": sys.argv[2], "model": sys.argv[3]},
  "reservation": {
    "authority": "symphony-agent-router",
    "scope": "issue",
    "key": sys.argv[1],
    "status": "held",
  },
  "lease": {
    "authority": "symphony-agent-router",
    "fd": 9,
    "status": "held",
  },
  "observedAt": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
}, sort_keys=True))
PY
  chmod 600 "$temporary"
  mv "$temporary" "$state_dir/$issue.json"
}

launch_codex() {
  set -a
  # Host-owned credential path, never logged.
  # shellcheck disable=SC1090
  . "${SYMPHONY_LINEAR_ENV:-$home/.config/symphony/linear.env}"
  set +a
  export SYMPHONY_CODEX_EXHAUSTED="${SYMPHONY_CODEX_EXHAUSTED:-$home/.local/bin/symphony-codex-exhausted.py}"
  mkdir -p "$workspace/scripts/symphony"
  if ! cmp -s "$router_hotfix" "$workspace/scripts/symphony/symphony-codex-router"; then
    cp "$router_hotfix" "$workspace/scripts/symphony/symphony-codex-router"
    chmod 755 "$workspace/scripts/symphony/symphony-codex-router"
  fi
  touch "${CODEX_ACCOUNTS_STATE:-$home/.codex-accounts/state.json}"
  write_receipt codex routed-subscription "eligible-codex-account"
  export SYMPHONY_ROUTING_USE_MATERIALIZED=1
  # Jovie headless app-server needs no desktop app connectors. Keep this opt-in
  # inside the selected Codex route so other providers retain their own CLI.
  if [ "${SYMPHONY_CODEX_DISABLE_APPS:-0}" = "1" ]; then
    set -- --disable apps "$@"
  fi
  exec "$workspace/scripts/symphony/symphony-codex-router" "$@"
}

prepare_codex_route() {
  if [ -s "$workspace/.symphony-routing.json" ]; then
    return 0
  fi
  node "$auto_route" >/dev/null 2>&1 && [ -s "$workspace/.symphony-routing.json" ]
}

# Codex subscription capacity is the official app-server lane. Reuse the already
# verified workspace receipt so launching an already-leased issue does not
# make a redundant tracker request. A missing receipt may be prepared once;
# failure remains retryable while the isolated CLI fallback lane continues.
if ! "$guard" >/dev/null 2>&1 && [ -x "$codex_probe" ]; then
  # codex-rotate's cooldown file is a cache of provider state, not the source
  # of truth. Revalidate one cooling account under the existing account and
  # state locks before falling through to another provider. The probe changes
  # nothing unless an authenticated useful completion succeeds.
  "$codex_probe" >/dev/null 2>&1 || true
fi
if "$guard" >/dev/null 2>&1 && prepare_codex_route; then
  launch_codex "$@"
fi

echo 'CAPACITY_UNAVAILABLE schema=symphony-provider-capacity/v1 class=provider-capacity retryable=true reason="codex app-server capacity unavailable; CLI-only providers remain isolated"' >&2
exit 75
