#!/usr/bin/env bash
# Ship one already-admitted Linear issue through the canonical model-router fallback.
# Invariant consumer: JOV-INV-011, JOV-INV-012, JOV-INV-022.
set -euo pipefail

ID="${1:?issue identifier required}"
case "$ID" in
  JOV-[0-9]*) TEAM=JOV; REPO=JovieInc/Jovie ;;
  LYB-[0-9]*) TEAM=LYB; REPO=JovieInc/LogYourBody ;;
  *) echo "unsupported issue identifier" >&2; exit 2 ;;
esac

export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:/usr/local/bin:$PATH:/usr/bin:/bin"
RUNTIME_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
SOURCE_ROOT="$(cd "$RUNTIME_DIR/../.." && pwd)"
if [ -f "$RUNTIME_DIR/writer-owned-pr-promotion.mjs" ]; then
  PROMOTION_SCRIPT="$RUNTIME_DIR/writer-owned-pr-promote.sh"
  PROMOTION_LIB="$RUNTIME_DIR/writer-owned-pr-promotion.mjs"
  UPSERT_PR_COMMENT="$RUNTIME_DIR/upsert-pr-comment.sh"
else
  # Direct source-tree execution remains available for development. Atomic
  # installed releases always take the immutable sibling artifacts above.
  PROMOTION_SCRIPT="$SOURCE_ROOT/scripts/writer-owned-pr-promote.sh"
  PROMOTION_LIB="$SOURCE_ROOT/scripts/lib/writer-owned-pr-promotion.mjs"
  UPSERT_PR_COMMENT="$SOURCE_ROOT/scripts/lib/upsert-pr-comment.sh"
fi
# Husky pre-push defaults to 1 vitest worker (laptop). Gem remounts then take
# 20–40 min (live JOV-5220). Override without skipping the gate.
export AUTOMATION_VERIFY_MAX_WORKERS="${AUTOMATION_VERIFY_MAX_WORKERS:-4}"
export AUTOMATION_VERIFY_SHARD_CONCURRENCY="${AUTOMATION_VERIFY_SHARD_CONCURRENCY:-2}"
set -a
# shellcheck disable=SC1091
[ -f "$HOME/.config/symphony/linear.env" ] && . "$HOME/.config/symphony/linear.env"
set +a
: "${LINEAR_API_KEY:?LINEAR_API_KEY is required}"

BRANCH="fallback/${ID}-fix"
WS_ROOT="${GROK_SHIP_WS_ROOT:-$HOME/grok-ship-workspaces}/$TEAM"
WS="$WS_ROOT/$ID"
LOG_DIR="${GROK_SHIP_LOG_DIR:-$HOME/grok-ship-logs}"
LOG="$LOG_DIR/$ID.log"
LEASE_DIR="${SYMPHONY_FALLBACK_LEASE_DIR:-$HOME/.local/state/symphony-fallback/leases}"
RECEIPT_DIR="${SYMPHONY_FALLBACK_RECEIPT_DIR:-$HOME/.local/state/symphony-fallback/receipts}"
mkdir -p "$LOG_DIR" "$WS_ROOT" "$LEASE_DIR" "$RECEIPT_DIR"
: "${SYMPHONY_FALLBACK_SELECTION_B64:?router selection is required}"
: "${SYMPHONY_FALLBACK_ISSUE_REVISION:?issue revision is required}"
: "${SYMPHONY_FALLBACK_BUNDLE_REVISION:?bundle revision is required}"
: "${SYMPHONY_FALLBACK_UNIT:?fallback unit is required}"
LEASE_FILE="$LEASE_DIR/$ID.lock"
exec 9>>"$LEASE_FILE"
if ! flock -n 9; then
  echo "$(date -u +%FT%TZ) $ID duplicate_lease" >> "$LOG"
  exit 0
fi
release_fallback_lease() {
  # Close our descriptor; keep the inode for existing waiters and future owners.
  exec 9>&-
}
trap release_fallback_lease EXIT

SELECTION_JSON="$(SELECTION_B64="$SYMPHONY_FALLBACK_SELECTION_B64" python3 - <<'PY'
import base64, json, os
try:
    payload = json.loads(base64.b64decode(os.environ["SELECTION_B64"], validate=True))
    selected = payload["selected"]
    executor = selected["executor"]
    valid = (
        payload.get("schema_version") == 1
        and payload.get("deterministic_first") is True
        and selected.get("provider") != "codex"
        and isinstance(selected.get("id"), str)
        and isinstance(selected.get("model"), str)
        and isinstance(executor.get("executable"), str)
        and isinstance(executor.get("argv"), list)
        and all(isinstance(value, str) for value in executor["argv"])
    )
except (KeyError, TypeError, ValueError):
    valid = False
if not valid:
    raise SystemExit("invalid router selection")
print(json.dumps(payload, separators=(",", ":")))
PY
)"

REMOUNT=0
EXISTING_NUMBER=""
EXISTING_MERGE_STATE=""
CHANGELOG_ONLY_REMOUNT=0
SKIP_GROK=0
if VERDICT_JSON="$(symphony-codex-exhausted open-pr-verdict "$ID" 2>/dev/null)"; then
  VERDICT="$(python3 -c 'import json,sys; print((json.loads(sys.argv[1]) or {}).get("verdict") or "none")' "$VERDICT_JSON")"
  EXISTING_HEAD="$(python3 -c 'import json,sys; print((json.loads(sys.argv[1]) or {}).get("head") or "")' "$VERDICT_JSON")"
  EXISTING_NUMBER="$(python3 -c 'import json,sys; print((json.loads(sys.argv[1]) or {}).get("number") or "")' "$VERDICT_JSON")"
  EXISTING_MERGE_STATE="$(python3 -c 'import json,sys; print((json.loads(sys.argv[1]) or {}).get("mergeStateStatus") or "")' "$VERDICT_JSON")"
else
  VERDICT=none
  EXISTING_HEAD=""
  EXISTING_MERGE_STATE=""
fi
if [ "$VERDICT" = skip ]; then
  echo "$(date -u +%FT%TZ) $ID open_pr_exists" >> "$LOG"
  exit 0
fi
if [ "$VERDICT" = remount ] && [ -n "$EXISTING_HEAD" ]; then
  BRANCH="$EXISTING_HEAD"
  REMOUNT=1
  echo "$(date -u +%FT%TZ) $ID remount_ci_red pr=$EXISTING_NUMBER head=$BRANCH" >> "$LOG"
fi

# Single admission source of truth: delegate the admission decision to the
# controller's check-admission command, which uses the SAME predicate as the
# reconcile selector (current admission-gate/v1 receipt, no blocked/human hold).
# Remount of an existing DIRTY/CI-red head skips the receipt so leftover
# GitHub work is not starved after Linear's receipt list goes empty.
# exit 0 = admitted (meta JSON on stdout); 1 = not admitted; 2 = unverifiable.
if [ "$REMOUNT" = 1 ]; then
  admission_args=(check-admission "$ID" --remount)
else
  admission_args=(check-admission "$ID")
fi
if ADMISSION_OUT="$(symphony-codex-exhausted "${admission_args[@]}" 2>&1)"; then
  META="$ADMISSION_OUT"
else
  admission_rc=$?
  echo "$(date -u +%FT%TZ) $ID admission_rc=$admission_rc: $(printf '%s' "$ADMISSION_OUT" | tail -n 1)" >> "$LOG"
  if [ "$admission_rc" -eq 2 ]; then
    echo "admission verification failed (Linear unreachable or bundle not installed)" >&2
    exit 2
  fi
  echo "issue is not admitted" >&2
  exit 0
fi

json_value() {
  python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get(sys.argv[2]) or "")' "$META" "$1"
}

TITLE="$(json_value title)"
URL="$(json_value url)"
DESC="$(json_value description)"
ISSUE_UUID="$(json_value id)"
ORIGINAL_STATE_ID="$(json_value original_state_id)"
ORIGINAL_STATE_NAME="$(json_value original_state_name)"
IN_PROGRESS_STATE_ID="$(json_value in_progress_state_id)"
IN_REVIEW_STATE_ID="$(json_value in_review_state_id)"
ISSUE_REVISION="$(json_value issue_revision)"
if [ "$ISSUE_REVISION" != "$SYMPHONY_FALLBACK_ISSUE_REVISION" ]; then
  echo "issue revision changed before lease acquisition" >&2
  exit 2
fi

GEM_FLEET_GATE_RECEIPT="${GEM_FLEET_GATE_RECEIPT:-$HOME/gem-workspace/state/gem-priority-gate/latest.json}" \
REMOUNT="$REMOUNT" \
python3 - <<'PY'
import json, os, pathlib
try:
    receipt = json.loads(pathlib.Path(os.environ["GEM_FLEET_GATE_RECEIPT"]).read_text())
except (OSError, ValueError):
    raise SystemExit("fleet gate unavailable")
admission = receipt.get("workAdmission")
if (
    receipt.get("schema") != "jovie-fleet-gate/v1"
    or receipt.get("state") not in ("GREEN", "AMBER")
    or not isinstance(admission, dict)
    or admission.get("allowed") is not True
):
    raise SystemExit("fleet gate blocks isolated work")
if os.environ.get("REMOUNT") == "1":
    remediation = receipt.get("remediationAdmission")
    if (
        not isinstance(remediation, dict)
        or remediation.get("allowed") is not True
        or remediation.get("pushAllowed") is not True
    ):
        raise SystemExit("fleet gate blocks fallback PR remediation")
else:
    closure = receipt.get("closureAdmission")
    if (
        not isinstance(closure, dict)
        or closure.get("newIssueIntakeAllowed") is not True
        or admission.get("newIssueLeaseAllowed") is not True
    ):
        raise SystemExit("Summer closure stop-line blocks new fallback work")
PY

if [ ! -d "$WS/.git" ]; then
  if [ -e "$WS" ] && [ -n "$(find "$WS" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
    echo "workspace exists without git: $WS" >&2
    exit 2
  fi
  git clone --depth 1 "https://github.com/$REPO.git" "$WS"
fi
if [ "$REMOUNT" != 1 ] && [ -n "$(git -C "$WS" status --porcelain)" ]; then
  echo "workspace has uncommitted changes: $WS" >&2
  exit 2
fi
if [ "$REMOUNT" = 1 ]; then
  # Depth-1 fetches of main and the PR head do not share a merge-base, so
  # `git merge origin/main` fails with unrelated histories and the PR stays DIRTY.
  # Leftover merge/rebase index from a prior remount blocks `git fetch origin main`
  # (live JOV-5041: CHANGELOG.md needs merge). Force-update the remote-tracking
  # PR ref: remounts rewrite history, so a non-plus fetch rejects non-fast-forward
  # (live JOV-4894 on #16211).
  git -C "$WS" merge --abort >/dev/null 2>&1 || true
  git -C "$WS" rebase --abort >/dev/null 2>&1 || true
  git -C "$WS" reset --hard HEAD
  git -C "$WS" fetch origin "+refs/heads/${BRANCH}:refs/remotes/origin/${BRANCH}"
  git -C "$WS" fetch origin main
  git -C "$WS" checkout -B "$BRANCH" "origin/$BRANCH"
  git -C "$WS" reset --hard "origin/$BRANCH"
  if [ "$(git -C "$WS" rev-parse --is-shallow-repository 2>/dev/null || printf true)" = "true" ]; then
    git -C "$WS" fetch --unshallow origin || git -C "$WS" fetch --deepen=200 origin
  fi
  if ! git -C "$WS" merge-base HEAD origin/main >/dev/null 2>&1; then
    git -C "$WS" fetch --deepen=500 origin
  fi
  if ! git -C "$WS" merge --no-edit origin/main; then
    if [ -z "$(git -C "$WS" ls-files -u)" ]; then
      echo "merge origin/main failed without conflicts: $WS" >&2
      exit 2
    fi
    echo "$(date -u +%FT%TZ) $ID remount_merge_conflicts" >> "$LOG"
    unmerged="$(git -C "$WS" diff --name-only --diff-filter=U | sort -u)"
    # Exact-only: mixed product+CHANGELOG conflicts still go to grok. A
    # CHANGELOG-only conflict keeps main's release state and drops the branch
    # artifact. Strip failure must not abort the remount (live JOV-5238 died after
    # remount_merge_conflicts with no START).
    if [ "$unmerged" = "CHANGELOG.md" ]; then
      strip_ok=0
      if git -C "$WS" show :3:CHANGELOG.md > "$WS/CHANGELOG.md"; then
        git -C "$WS" add CHANGELOG.md
        strip_ok=1
      else
        echo "$(date -u +%FT%TZ) $ID remount_changelog_strip_failed" >> "$LOG"
      fi
      if [ "$strip_ok" = 1 ] && [ -z "$(git -C "$WS" ls-files -u)" ]; then
        if GIT_EDITOR=true git -C "$WS" commit --no-edit >"$WS/.changelog.commit.err" 2>&1; then
          echo "$(date -u +%FT%TZ) $ID remount_changelog_stripped" >> "$LOG"
          CHANGELOG_ONLY_REMOUNT=1
        else
          echo "$(date -u +%FT%TZ) $ID remount_changelog_commit_failed $(tr '\n' ' ' < "$WS/.changelog.commit.err")" >> "$LOG"
        fi
        rm -f "$WS/.changelog.commit.err"
      fi
    fi
  fi
  if [ "$CHANGELOG_ONLY_REMOUNT" != 1 ] \
    && [ -z "$(git -C "$WS" ls-files -u)" ] \
    && ! git -C "$WS" diff --quiet origin/main...HEAD -- CHANGELOG.md; then
    if git -C "$WS" restore --source=origin/main -- CHANGELOG.md \
      && git -C "$WS" add CHANGELOG.md \
      && git -C "$WS" commit -m "chore: remove pre-land changelog artifact"; then
      echo "$(date -u +%FT%TZ) $ID remount_changelog_stripped" >> "$LOG"
      CHANGELOG_ONLY_REMOUNT=1
    else
      echo "$(date -u +%FT%TZ) $ID remount_changelog_strip_failed" >> "$LOG"
    fi
  fi
else
  git -C "$WS" fetch --depth 1 origin main
  git -C "$WS" checkout -B "$BRANCH" origin/main
fi

update_state() {
  local state_id="$1"
  ISSUE_UUID="$ISSUE_UUID" STATE_ID="$state_id" python3 - <<'PY'
import json, os, urllib.request
query = "mutation($id:String!,$input:IssueUpdateInput!){issueUpdate(id:$id,input:$input){success}}"
request = urllib.request.Request(
    os.environ.get("LINEAR_API_URL", "https://api.linear.app/graphql"),
    data=json.dumps({"query": query, "variables": {"id": os.environ["ISSUE_UUID"], "input": {"stateId": os.environ["STATE_ID"]}}}).encode(),
    headers={"Authorization": os.environ["LINEAR_API_KEY"], "Content-Type": "application/json"},
)
with urllib.request.urlopen(request, timeout=20) as response:
    payload = json.load(response)
if payload.get("errors") or not ((payload.get("data") or {}).get("issueUpdate") or {}).get("success"):
    raise SystemExit("state update failed")
PY
}

changed_state=0
original_state_lower="$(printf '%s' "$ORIGINAL_STATE_NAME" | tr '[:upper:]' '[:lower:]')"
if [ "$original_state_lower" != "in progress" ]; then
  update_state "$IN_PROGRESS_STATE_ID"
  changed_state=1
fi

if [ "$REMOUNT" = 1 ]; then
  PROMPT="You are fixing failing CI on existing PR ${EXISTING_NUMBER:-unknown} ($BRANCH) for Linear issue $ID in $REPO.

Title: $TITLE
URL: $URL

Description:
$DESC

Work only in this checkout of $BRANCH. Do not open a second PR. Do not reset to main. If the branch is behind or conflicting with origin/main, finish the merge/rebase onto origin/main, then push to the existing head.
Satisfy the issue optimization contract (stable variant identity, exposure, outcome, attribution, eligible context dimensions, hypothesis and primary metric, guardrails, privacy and consent, optimizer owner and cadence, decision writeback, and rollback or control) using the existing analytics, model-experiment, audience event, YouTube experiment, and release-to-revenue surfaces. If the work is non-product or non-optimizable, explicitly declare a justified exception instead of omitting the contract.
Fix the failing checks. If scripts-typecheck exceeds the baseline, fix the new TypeScript errors; do not regenerate the baseline unless the errors are genuinely pre-existing on main.
Do not weaken or skip gates. Do not merge, deploy, remove queue-deferred, or run gh pr ready directly. If the PR must leave draft, run env REPO=$REPO GITHUB_REPOSITORY=$REPO bash $PROMOTION_SCRIPT only after exact-head author proof is complete. If blocked, write BLOCKER.md with the exact reason and exit. Start now."
else
  PROMPT="You are implementing admitted Linear issue $ID in $REPO under a revision-scoped fallback lease.

Title: $TITLE
URL: $URL

Description:
$DESC

Work only in this checkout. Make the smallest correct issue-scoped change. Do not weaken or skip gates.
Satisfy the issue optimization contract (stable variant identity, exposure, outcome, attribution, eligible context dimensions, hypothesis and primary metric, guardrails, privacy and consent, optimizer owner and cadence, decision writeback, and rollback or control) using the existing analytics, model-experiment, audience event, YouTube experiment, and release-to-revenue surfaces. If the work is non-product or non-optimizable, explicitly declare a justified exception instead of omitting the contract.
If scripts-typecheck exceeds the baseline, fix the new TypeScript errors; do not regenerate the baseline unless the errors are genuinely pre-existing on main.
Create commits on $BRANCH, push normally, and open a draft PR to main with validation evidence and Fixes $ID.
After required tests, review sweep, ticket evidence, and PR evidence are attached, run env REPO=$REPO GITHUB_REPOSITORY=$REPO bash $PROMOTION_SCRIPT against the exact PR head. That helper emits jovie-writer-pr-proof/v1, marks ready, and requests native auto-merge with --match-head-commit in one bounded writer action. Do not run gh pr ready directly and do not rely on auto-ready-agent-drafts or agent-tick for successful promotion.
Do not add the queue-deferred label. Native merge-queue autoenroll is the hold during hold-intake.
Do not merge, deploy, or bypass writer-owned promotion. If blocked, write BLOCKER.md with the exact reason and exit. Start now."
fi

RECEIPT="$RECEIPT_DIR/$ID.json"
RECEIPT_PATH="$RECEIPT" RECEIPT_ID="$ID" RECEIPT_ISSUE_REVISION="$ISSUE_REVISION" \
RECEIPT_BUNDLE_REVISION="$SYMPHONY_FALLBACK_BUNDLE_REVISION" RECEIPT_SELECTION="$SELECTION_JSON" \
RECEIPT_BASE_REVISION="$(git -C "$WS" rev-parse HEAD)" RECEIPT_UNIT="$SYMPHONY_FALLBACK_UNIT" python3 - <<'PY'
import hashlib, json, os, pathlib, re, tempfile, time
selection = json.loads(os.environ["RECEIPT_SELECTION"])["selected"]
identifier = os.environ["RECEIPT_ID"]
issue_revision = os.environ["RECEIPT_ISSUE_REVISION"]
base_revision = os.environ["RECEIPT_BASE_REVISION"]
bundle_revision = os.environ["RECEIPT_BUNDLE_REVISION"]
expected_unit = f"fallback-ship-{identifier}-{hashlib.sha256(issue_revision.encode()).hexdigest()[:12]}"
if (
    not re.fullmatch(r"[0-9a-f]{40}", base_revision)
    or not re.fullmatch(r"[0-9a-f]{64}", bundle_revision)
    or os.environ["RECEIPT_UNIT"] != expected_unit
):
    raise SystemExit("fallback provenance is invalid")
payload = {
    "schema": "symphony-fallback-lease/v1",
    "observedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "identifier": identifier,
    "issueRevision": issue_revision,
    "baseRevision": base_revision,
    "bundleRevision": bundle_revision,
    "unit": expected_unit,
    "provider": selection["provider"],
    "model": selection["model"],
    "modelId": selection["id"],
    "ownership": "isolated-implementation-only",
    "forbidden": ["merge", "deploy", "direct-ready", "direct-auto-merge-without-proof", "remove-queue-deferred"],
}
path = pathlib.Path(os.environ["RECEIPT_PATH"])
fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
try:
    with os.fdopen(fd, "w") as handle:
        json.dump(payload, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY

if [ "$CHANGELOG_ONLY_REMOUNT" = 1 ]; then
  merge_state="$(printf '%s' "$EXISTING_MERGE_STATE" | tr '[:lower:]' '[:upper:]')"
  if [ -z "$merge_state" ] || [ "$merge_state" = "DIRTY" ] || [ "$merge_state" = "BEHIND" ]; then
    # Live JOV-5238: set -e abort after autoresolve left no END and no grok
    # when package.json pre-push typecheck failed on the merge.
    if git -C "$WS" push origin "$BRANCH"; then
      echo "$(date -u +%FT%TZ) $ID remount_changelog_pushed" >> "$LOG"
      SKIP_GROK=1
    else
      echo "$(date -u +%FT%TZ) $ID remount_changelog_push_failed" >> "$LOG"
    fi
  fi
fi

attempt_log="$(mktemp "$LOG_DIR/.${ID}.attempt.XXXXXX")"
trap 'rm -f "$attempt_log"; release_fallback_lease' EXIT
echo "START $ID $(date -u +%FT%TZ) repo=$REPO" | tee -a "$LOG"
set +e
if [ "$SKIP_GROK" = 1 ]; then
  rc=0
else
SELECTION_JSON="$SELECTION_JSON" FALLBACK_PROMPT="$PROMPT" FALLBACK_CWD="$WS" python3 - <<'PY' 2>&1 | tee -a "$LOG" "$attempt_log"
import json, os, pathlib, subprocess
selected = json.loads(os.environ["SELECTION_JSON"])["selected"]
executor = selected["executor"]
values = {
    "cwd": os.environ["FALLBACK_CWD"],
    "model": selected["model"],
    "prompt": os.environ["FALLBACK_PROMPT"],
}
argv = [value.format(**values) for value in executor["argv"]]
executable = executor["executable"]
env = os.environ.copy()
grok = os.environ.get("GEM_GROK_EXECUTABLE") or os.environ.get("GEM_GROK_BIN") or ""
hermes = pathlib.Path(executable).name == "hermes"
if hermes and grok and os.access(grok, os.X_OK):
    # Hermes on Gem uses OpenRouter (max_tokens 65536) and 402s. Prefer included grok.
    print("rewrite_hermes_openrouter_to_grok", grok, flush=True)
    executable = grok
    argv = [
        "-m", "grok-4.6",
        "--always-approve",
        "--cwd", values["cwd"],
        "--disable-web-search",
        "--no-subagents",
        "-p", values["prompt"],
    ]
elif hermes:
    cap = os.environ.get("SYMPHONY_HERMES_MAX_TOKENS", "512")
    env["HERMES_MAX_TOKENS"] = cap
    if "--max-tokens" not in argv:
        argv = ["--max-tokens", cap, *argv]
        print(f"hermes_max_tokens={cap}", flush=True)
def run_executor(run_argv):
    return subprocess.run(
        [executable, *run_argv],
        cwd=pathlib.Path(values["cwd"]),
        env=env,
        check=False,
        capture_output=True,
        text=True,
    )

def with_model(run_argv, model):
    mapped = list(run_argv)
    for flag in ("--model", "-m"):
        if flag in mapped:
            idx = mapped.index(flag)
            if idx + 1 < len(mapped):
                mapped[idx + 1] = model
                return mapped
    return ["--model", model, *mapped]

def available_models(text):
    if "Available models:" not in text:
        return []
    rest = text.split("Available models:", 1)[1].replace("\n", " ")
    return [part.strip().rstrip(".") for part in rest.split(",") if part.strip()]

result = run_executor(argv)
sys_out = (result.stdout or "") + (result.stderr or "")
print(sys_out, end="")
cursor_model = os.environ.get("GEM_CURSOR_GROK_MODEL", "cursor-grok-4.6-high")
tried = set()
for _ in range(2):
    if result.returncode == 0 or "Cannot use this model" not in sys_out:
        break
    names = available_models(sys_out)
    nxt = None
    for cand in (cursor_model + "-fast", cursor_model, "cursor-grok-4.6-high-fast"):
        if cand in names and cand not in tried:
            nxt = cand
            break
    if nxt is None:
        break
    tried.add(nxt)
    print(f"retry_cursor_grok_model {nxt}", flush=True)
    result = run_executor(with_model(argv, nxt))
    sys_out = (result.stdout or "") + (result.stderr or "")
    print(sys_out, end="")
if "402" in sys_out and ("max_tokens" in sys_out or "can only afford" in sys_out):
    raise SystemExit(2)
raise SystemExit(result.returncode)
PY
rc=${PIPESTATUS[0]}
fi
set -e

pr_count="$(gh pr list --repo "$REPO" --head "$BRANCH" --state open --json number --jq 'length' 2>/dev/null || printf 0)"
if [ "$pr_count" -gt 0 ]; then
  pr_number="$(gh pr list --repo "$REPO" --head "$BRANCH" --state open --json number --jq '.[0].number' 2>/dev/null || true)"
  if [ -z "$pr_number" ]; then
    echo "PR exists but number could not be proven" >&2
    exit 2
  fi

  read_pr_promotion_state() {
    local owner="${REPO%%/*}"
    local name="${REPO#*/}"
    gh api graphql \
      -f query='query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){number state isDraft headRefOid body labels(first:100){nodes{name}} autoMergeRequest{enabledAt} isInMergeQueue mergeQueueEntry{id state position}}}}' \
      -f owner="$owner" \
      -f name="$name" \
      -F number="$pr_number" \
      --jq '.data.repository.pullRequest | {number, state, draft: .isDraft, head: ((.headRefOid // "") | ascii_downcase), body: (.body // ""), labels: [.labels.nodes[].name], autoMerge: (.autoMergeRequest != null), queued: (.isInMergeQueue == true and .mergeQueueEntry != null), mergeQueueEntry}'
  }

  promotion_blocker_body() { # promotion_blocker_body <phase> <reason> <attempted> <verified> <state-json>
    local writer_login
    writer_login="${GITHUB_ACTOR:-$(gh api user --jq .login 2>/dev/null || true)}"
    jq -nc \
      --arg issueId "$ID" \
      --argjson prNumber "$pr_number" \
      --arg headSha "$(jq -r '.head // ""' <<<"$5")" \
      --arg writerLogin "${writer_login:-unknown}" \
      --arg phase "$1" \
      --arg reason "$2" \
      --argjson attempted "$3" \
      --argjson verified "$4" \
      --argjson state "$5" \
      '{issueId:$issueId, prNumber:$prNumber, headSha:$headSha, writerLogin:$writerLogin, phase:$phase, reason:$reason, compensation:{attempted:$attempted, verified:$verified, state:$state}}' \
      | node "$PROMOTION_LIB" render-blocker
  }

  upsert_promotion_blocker() { # upsert_promotion_blocker <phase> <reason> <attempted> <verified> <state-json>
    local body
    body="$(promotion_blocker_body "$1" "$2" "$3" "$4" "$5")"
    GITHUB_REPOSITORY="$REPO" bash "$UPSERT_PR_COMMENT" \
      "$pr_number" "writer-owned-pr-promotion" "$body" || true
  }

  compensate_ready_unenrolled() {
    gh pr merge "$pr_number" --repo "$REPO" --disable-auto >/dev/null 2>&1 || true
    gh pr ready "$pr_number" --repo "$REPO" --undo >/dev/null 2>&1 || true
    read_pr_promotion_state
  }

  promotion_state="$(read_pr_promotion_state)"
  promotion_head="$(jq -r '.head // ""' <<<"$promotion_state")"
  writer_login="${GITHUB_ACTOR:-$(gh api user --jq .login 2>/dev/null || true)}"
  promotion_decision="$(jq -nc \
    --argjson state "$promotion_state" \
    --arg body "$(jq -r '.body // ""' <<<"$promotion_state")" \
    --arg expectedHeadSha "$promotion_head" \
    --arg writerLogin "${writer_login:-unknown}" \
    --argjson prNumber "$pr_number" \
    '{state:$state,body:$body,context:{expectedHeadSha:$expectedHeadSha,writerLogin:$writerLogin,prNumber:$prNumber}}' \
    | node "$PROMOTION_LIB" decision)"
  promotion_action="$(jq -r '.action' <<<"$promotion_decision")"
  promotion_reason="$(jq -r '.reason' <<<"$promotion_decision")"

  if [ "$promotion_action" = "already-complete" ]; then
    update_state "$IN_REVIEW_STATE_ID"
    echo "END $ID rc=$rc pr=open promotion=complete $(date -u +%FT%TZ)" | tee -a "$LOG"
    exit "$rc"
  fi

  if [ "$promotion_action" = "compensate" ]; then
    if restored_state="$(compensate_ready_unenrolled)"; then
      verified="$(jq -r '.draft == true and .autoMerge == false and .queued == false' <<<"$restored_state")"
    else
      restored_state="$promotion_state"
      verified=false
    fi
    upsert_promotion_blocker "post-agent" "$promotion_reason" true "$verified" "$restored_state"
    echo "END $ID rc=2 pr=open promotion=compensated reason=$promotion_reason $(date -u +%FT%TZ)" | tee -a "$LOG"
    exit 2
  fi

  upsert_promotion_blocker "post-agent" "writer-owned-promotion-missing:${promotion_reason}" false false "$promotion_state"
  echo "END $ID rc=2 pr=open promotion=blocked reason=$promotion_reason $(date -u +%FT%TZ)" | tee -a "$LOG"
  exit 2
fi

if [ "$changed_state" -eq 1 ] && [ -n "$ORIGINAL_STATE_ID" ]; then
  update_state "$ORIGINAL_STATE_ID"
fi
echo "END $ID rc=$rc pr=missing state=restored $(date -u +%FT%TZ)" | tee -a "$LOG"
[ "$rc" -ne 0 ] && exit "$rc"
exit 2
