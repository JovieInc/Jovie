#!/usr/bin/env python3
"""Cursor CLI wrapper that preserves live catalog ids.

PATH / GEM_CURSOR_EXECUTABLE wrapper. Keep live `*-fast` catalog ids.
Strip only bracketed `fast=`. Refuse silent Codex/Opus/auto/composer.
"""
from __future__ import annotations

import os
import pathlib
import re
import sys

VERSIONS = pathlib.Path.home() / ".local/share/cursor-agent/versions"
SILENT_ALTERNATIVE_MARKERS = frozenset({
    "opus", "newest", "auto", "codex", "composer", "claude",
    "live-cheapest-capable", "cheapest", "sonnet",
})
PASSTHROUGH = {
    "login",
    "logout",
    "status",
    "whoami",
    "about",
    "models",
    "mcp",
    "plugin",
    "worker",
    "acp",
    "update",
    "ls",
    "resume",
    "create-chat",
    "generate-rule",
    "rule",
    "help",
    "install-shell-integration",
    "uninstall-shell-integration",
    "sandbox",
    "bedrock",
}


def real_binary() -> pathlib.Path:
    override = os.environ.get("CURSOR_AGENT_REAL")
    if override:
        path = pathlib.Path(override)
        if path.is_file() and os.access(path, os.X_OK):
            return path
    if not VERSIONS.is_dir():
        raise SystemExit("cursor-agent binary not installed")
    versions = sorted((p for p in VERSIONS.iterdir() if p.is_dir()), key=lambda p: p.name)
    for folder in reversed(versions):
        candidate = folder / "cursor-agent"
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    raise SystemExit("cursor-agent binary not installed")


def lock_model(name: str) -> str:
    """Keep live catalog ids; drop only bracketed fast= parameters."""
    name = name.strip()
    match = re.match(r"^(.*)\[(.*)\]$", name)
    if not match:
        return name
    base, params = match.group(1), match.group(2)
    kept = [
        part.strip()
        for part in params.split(",")
        if part.strip() and not re.match(r"fast\s*=", part.strip(), re.I)
    ]
    return f"{base}[{','.join(kept)}]" if kept else base


def is_silent_alternative(name: str) -> bool:
    text = (name or "").strip().lower()
    if not text:
        return False
    if text in SILENT_ALTERNATIVE_MARKERS:
        return True
    parts = re.split(r"[-_\[\]=,\s/.]+", text)
    return any(part in SILENT_ALTERNATIVE_MARKERS for part in parts if part)


def refused_model(argv: list[str]):
    tokens = [arg for arg in argv if not arg.startswith("-")]
    if tokens and tokens[0] in PASSTHROUGH:
        return None
    rewritten = rewrite(argv)
    index = 0
    while index < len(rewritten):
        arg = rewritten[index]
        if arg == "--model" and index + 1 < len(rewritten):
            model = rewritten[index + 1]
            if is_silent_alternative(model):
                return model
            index += 2
            continue
        if arg.startswith("--model="):
            model = arg.split("=", 1)[1]
            if is_silent_alternative(model):
                return model
        index += 1
    return None


def rewrite(argv: list[str]) -> list[str]:
    tokens = [a for a in argv if not a.startswith("-")]
    if tokens and tokens[0] in PASSTHROUGH:
        return argv
    out: list[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--model" and i + 1 < len(argv):
            out.extend(["--model", lock_model(argv[i + 1])])
            i += 2
            continue
        if arg.startswith("--model="):
            out.append("--model=" + lock_model(arg.split("=", 1)[1]))
            i += 1
            continue
        out.append(arg)
        i += 1
    return out


def main() -> int:
    refused = refused_model(sys.argv[1:])
    if refused:
        print(f"REFUSED silent Cursor alternative: {refused}", file=sys.stderr)
        return 2
    binary = real_binary()
    os.execv(str(binary), [str(binary), *rewrite(sys.argv[1:])])
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
