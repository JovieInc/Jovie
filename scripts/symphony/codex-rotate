#!/usr/bin/env bash
# Concurrency-safe multi-account Codex launcher for Symphony.
set -euo pipefail

REAL_CODEX="${CODEX_REAL_BIN:-$HOME/.local/bin/codex}"
ACCOUNTS_ROOT="${CODEX_ACCOUNTS_ROOT:-$HOME/.codex-accounts}"
STATE_FILE="${CODEX_ACCOUNTS_STATE:-$ACCOUNTS_ROOT/state.json}"
LOG_FILE="${CODEX_ROTATE_LOG:-$ACCOUNTS_ROOT/rotate.log}"
LOCKS_DIR="${CODEX_ACCOUNT_LOCKS_DIR:-$ACCOUNTS_ROOT/locks}"
WAIT_SECONDS="${CODEX_ACCOUNT_WAIT_SECONDS:-900}"
# JOV-5031: Symphony's app-server reader enforces read_timeout_ms (5s) as an
# inactivity deadline, not a boot budget. While this launcher waits for an
# account it is silent, so the reader used to time out and abandon the port,
# orphaning the launcher behind a dead reader where it could later seize an
# account and strand it. In app-server mode the launcher emits a typed
# keepalive line on the JSON-RPC stream; the reader treats it as an ignorable
# notification and resets its inactivity clock. If the reader is gone, the
# write fails (SIGPIPE/EPIPE) and the launcher dies before it can seize an
# account — the initialization wait is cancellation-safe and the account lock
# can never strand behind a dead reader.
HEARTBEAT_SECONDS="${CODEX_ROTATE_HEARTBEAT_SECONDS:-2}"
DEFAULT_COOLDOWN_SECONDS="${CODEX_DEFAULT_COOLDOWN_SECONDS:-21600}"
# App-server JSON-RPC budget per account/rateLimits/read request.
RPC_TIMEOUT="${CODEX_ROTATE_RPC_TIMEOUT:-15}"

app_server_mode=0
for arg in "$@"; do
  if [[ "$arg" == "app-server" ]]; then
    app_server_mode=1
    break
  fi
done

mkdir -p "$LOCKS_DIR"
touch "$LOG_FILE"
chmod 600 "$LOG_FILE" 2>/dev/null || true

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG_FILE"
}

if ! command -v flock >/dev/null 2>&1; then
  log "ERROR flock unavailable"
  echo "codex-rotate: flock is required for account leasing" >&2
  exit 2
fi

if [[ ! -f "$STATE_FILE" ]]; then
  printf '%s\n' '{"active":null,"cooldowns":{},"last_error":{}}' >"$STATE_FILE"
  chmod 600 "$STATE_FILE"
fi

account_order() {
  ACCOUNTS_ROOT="$ACCOUNTS_ROOT" STATE_FILE="$STATE_FILE" python3 - <<'PY'
import json
import os
import re
import time
import fcntl
from pathlib import Path

def codex_account(path):
    """Only ChatGPT-authenticated profiles using the OpenAI provider belong here."""
    try:
        import tomllib
        auth = json.loads((path / "auth.json").read_text())
        config = tomllib.loads((path / "config.toml").read_text())
        if not isinstance(auth, dict) or auth.get("auth_mode") != "chatgpt":
            return False
        provider = config.get("model_provider", "openai")
        profile = config.get("profile")
        if profile is not None:
            selected = config.get("profiles", {}).get(profile)
            if not isinstance(selected, dict):
                return False
            provider = selected.get("model_provider", provider)
        return provider == "openai"
    except (OSError, ValueError, TypeError, AttributeError):
        return False


root = Path(os.environ["ACCOUNTS_ROOT"])
state_path = Path(os.environ["STATE_FILE"])
with open(str(state_path) + ".lock", "a+") as lock:
    fcntl.flock(lock, fcntl.LOCK_SH)
    try:
        state = json.loads(state_path.read_text())
        if not isinstance(state, dict):
            raise ValueError("account state must be an object")
        cooldowns = state.get("cooldowns", {})
        if not isinstance(cooldowns, dict):
            raise ValueError("cooldowns must be an object")
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        print("__CODEX_ROTATE_CAPACITY__:account_state_invalid")
        raise SystemExit
def account_groups(root):
    """Aliases of one ChatGPT account share cooldown and existing lease files."""
    groups = {}
    for path in sorted(root.iterdir()):
        if not path.is_dir() or not codex_account(path):
            continue
        if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", path.name)
                or path.is_symlink()
                or (path / "auth.json").is_symlink()
                or (path / "config.toml").is_symlink()):
            raise ValueError("unsafe account path")
        auth = json.loads((path / "auth.json").read_text())
        tokens = auth.get("tokens")
        identity = tokens.get("account_id") if isinstance(tokens, dict) else None
        if not isinstance(identity, str) or not identity.strip():
            raise ValueError("missing canonical account identity")
        # IDs remain private: only validated local alias names leave this process.
        groups.setdefault(identity, []).append(path.name)
    return list(groups.values())

try:
    groups = account_groups(root)
    cooldown_by_group = {}
    for aliases in groups:
        values = [cooldowns.get(name, 0) for name in aliases]
        if any(isinstance(value, bool) or not isinstance(value, int) for value in values):
            raise ValueError("invalid cooldown")
        cooldown_by_group[aliases[0]] = max(values)
except (OSError, ValueError, TypeError):
    print("__CODEX_ROTATE_CAPACITY__:account_state_invalid")
    raise SystemExit
now = int(time.time())
ready = [aliases for aliases in groups if cooldown_by_group[aliases[0]] <= now]
if not ready and groups:
    earliest_retry = min(cooldown_by_group.values())
    print(f"__CODEX_ROTATE_CAPACITY__:account_cooldown:{earliest_retry}")
    raise SystemExit
active = state.get("active")
ready.sort(key=lambda aliases: active not in aliases)
for aliases in ready:
    selected = active if active in aliases else aliases[0]
    print(selected + "\t" + " ".join(aliases))
PY
}

set_active() {
  ACCOUNT="$1" STATE_FILE="$STATE_FILE" python3 - <<'PY'
import json
import os
import fcntl
from pathlib import Path

path = Path(os.environ["STATE_FILE"])
with open(str(path) + ".lock", "a+") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        state = json.loads(path.read_text())
    except Exception:
        state = {"active": None, "cooldowns": {}, "last_error": {}}
    state["active"] = os.environ["ACCOUNT"]
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
PY
}

mark_cooldown() {
  ACCOUNT="$1" UNTIL="$2" STATE_FILE="$STATE_FILE" python3 - <<'PY'
import json
import os
import time
import fcntl
from pathlib import Path

path = Path(os.environ["STATE_FILE"])
with open(str(path) + ".lock", "a+") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        state = json.loads(path.read_text())
    except Exception:
        state = {"active": None, "cooldowns": {}, "last_error": {}}
    account = os.environ["ACCOUNT"]
    until = int(os.environ["UNTIL"])
    state.setdefault("cooldowns", {})[account] = until
    state.setdefault("last_error", {})[account] = {
        "reason": "limit_or_auth",
        "at": int(time.time()),
        "until": until,
    }
    if state.get("active") == account:
        state["active"] = None
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
PY
}

# Reset windows come from the official app-server RPC account/rateLimits/read,
# never from parsing error text: the "try again at" strings proved ~7h
# inaccurate (9/6 RCA). Transport mirrors codex_cli_artifact.initialize: one
# `codex app-server` process, newline-delimited JSON-RPC, response matched by
# id with a bounded budget. Every failure is fail-closed (bounded default
# cooldown); the account is never parked on a guessed timestamp.
reset_until_via_rpc() {
  REAL_CODEX="$REAL_CODEX" RPC_TIMEOUT="$RPC_TIMEOUT" python3 - <<'PY' 2>>"$LOG_FILE"
import json
import os
import selectors
import subprocess
import time

EXHAUSTED_PERCENT = 99.5
MAX_COOLDOWN_SECONDS = 45 * 86400


def rpc_timeout():
    try:
        value = float(os.environ.get("RPC_TIMEOUT", "15"))
    except (TypeError, ValueError):
        return 15.0
    return value if 0 < value <= 30 else 15.0


class AppServer:
    """Newline-delimited JSON-RPC over one `codex app-server` process."""

    def __init__(self):
        self.timeout = rpc_timeout()
        self.buffer = b""
        self.process = subprocess.Popen(
            [os.environ["REAL_CODEX"], "app-server"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        self.selector = selectors.DefaultSelector()
        self.selector.register(self.process.stdout, selectors.EVENT_READ)
        status, payload = self.request(1, "initialize", {
            "clientInfo": {"name": "codex-rotate", "version": "1"},
            "capabilities": {"experimentalApi": True},
        })
        if status != "ok" or not isinstance(payload, dict) or not payload.get("userAgent"):
            raise RuntimeError("initialize failed")
        self.send({"method": "initialized", "params": {}})

    def send(self, message):
        self.process.stdin.write((json.dumps(message) + "\n").encode())
        self.process.stdin.flush()

    def request(self, request_id, method, params):
        """Returns (status, payload): 'ok' | 'error' (clean refusal) | 'ambiguous'."""
        self.send({"id": request_id, "method": method, "params": params})
        deadline = time.monotonic() + self.timeout
        while time.monotonic() < deadline:
            if self.process.poll() is not None and not self.selector.select(0):
                # The server exited: drain what it sent, but never wait on a
                # pipe a surviving child still holds open.
                break
            # Cap each wait so a server dying mid-read is caught promptly.
            if not self.selector.select(min(0.1, max(0, deadline - time.monotonic()))):
                continue
            chunk = os.read(self.process.stdout.fileno(), 4096)
            if not chunk:
                break
            self.buffer += chunk
            if len(self.buffer) > 1048576:
                raise RuntimeError("response exceeds the 1MiB bound")
            while b"\n" in self.buffer:
                line, self.buffer = self.buffer.split(b"\n", 1)
                try:
                    message = json.loads(line)
                except ValueError:
                    continue
                # Server->client requests and notifications carry a method; a
                # response to us never does. Match strictly on our id.
                if not isinstance(message, dict) or "method" in message:
                    continue
                if message.get("id") != request_id:
                    continue
                if "error" in message:
                    return "error", message.get("error")
                return "ok", message.get("result")
        return "ambiguous", None

    def close(self):
        try:
            self.selector.close()
        except Exception:
            pass
        try:
            self.process.stdin.close()
        except OSError:
            pass
        self.process.terminate()
        try:
            self.process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait()


def parse_window(value):
    if value is None:
        return None
    if not isinstance(value, dict):
        raise ValueError("window must be an object or null")
    used = value.get("usedPercent")
    resets_at = value.get("resetsAt")
    if isinstance(used, bool) or not isinstance(used, (int, float)):
        raise ValueError("usedPercent must be a number")
    # resetsAt is nullable in the v2 schema: a window without a known recovery
    # instant can never supply a cooldown target.
    if resets_at is not None and (isinstance(resets_at, bool) or not isinstance(resets_at, int)):
        raise ValueError("resetsAt must be epoch seconds or null")
    return {"usedPercent": float(used), "resetsAt": resets_at}


def parse_snapshot(result):
    if not isinstance(result, dict):
        raise ValueError("rateLimits result must be an object")
    rate_limits = result.get("rateLimits")
    if not isinstance(rate_limits, dict):
        raise ValueError("rateLimits must be an object")
    reached = rate_limits.get("rateLimitReachedType")
    if reached is not None and not isinstance(reached, str):
        raise ValueError("rateLimitReachedType must be a string or null")
    return {
        "primary": parse_window(rate_limits.get("primary")),
        "secondary": parse_window(rate_limits.get("secondary")),
        "reached": reached,
    }


def binding_reset(snapshot):
    exhausted = [
        snapshot[name]["resetsAt"]
        for name in ("primary", "secondary")
        if snapshot[name] is not None
        and snapshot[name]["usedPercent"] >= EXHAUSTED_PERCENT
        and snapshot[name]["resetsAt"] is not None
    ]
    if not exhausted:
        return None
    return max(exhausted)


now = int(time.time())
try:
    server = AppServer()
except (OSError, RuntimeError):
    raise SystemExit(1)
try:
    status, payload = server.request(2, "account/rateLimits/read", {})
finally:
    server.close()
if status != "ok":
    raise SystemExit(1)
try:
    snapshot = parse_snapshot(payload)
except ValueError:
    raise SystemExit(1)
until = binding_reset(snapshot)
if until is None or until <= now or until > now + MAX_COOLDOWN_SECONDS:
    # The typed limit event contradicts the snapshot, or the reset time is
    # implausible: park on the bounded default instead of trusting it.
    raise SystemExit(1)
print(until)
PY
}

classify_provider_error() {
  STDOUT_FILE="$1" STDERR_FILE="$2" APP_SERVER_MODE="$app_server_mode" PROCESS_RC="$3" python3 - <<'PY'
import json
import os
import re


def normalized(value):
    return re.sub(r"[^a-z0-9]", "", str(value).lower())


def http_status(value):
    if not isinstance(value, dict):
        return None
    for key in ("httpStatusCode", "http_status_code", "status", "statusCode"):
        status = value.get(key)
        if isinstance(status, int) and not isinstance(status, bool):
            return status
    return None


def typed_limit_or_auth(info):
    exact = {"usagelimitexceeded", "ratelimitexceeded", "unauthorized"}
    http_variants = {
        "httpconnectionfailed",
        "responsestreamconnectionfailed",
        "responsestreamdisconnected",
        "responsetoomanyfailedattempts",
    }
    if isinstance(info, str):
        return normalized(info) in exact
    if not isinstance(info, dict):
        return False
    kind = info.get("type") or info.get("kind")
    if isinstance(kind, str):
        name = normalized(kind)
        if name in exact:
            return True
        if name in http_variants and http_status(info) == 429:
            return True
    for key, value in info.items():
        name = normalized(key)
        if name in exact:
            return True
        if name in http_variants and http_status(value) == 429:
            return True
    return False


def trusted_error(error):
    if not isinstance(error, dict):
        return False
    if typed_limit_or_auth(error.get("codexErrorInfo")):
        return True
    error_type = normalized(error.get("type", ""))
    if error_type in {
        "ratelimiterror",
        "usagelimiterror",
        "authenticationerror",
        "tokeninvalidated",
        "tokenexpired",
        "unauthorized",
    }:
        return True
    message = str(error.get("message", "")).strip().lower()
    return any(
        message.startswith(prefix)
        for prefix in (
            "you've hit your usage limit",
            "usage limit; try again at",
            "rate limit exceeded",
            "token_invalidated",
            "refresh token was revoked",
            "token_expired",
            "token is expired",
            "session has ended",
        )
    )


def app_server_error(payload):
    if not isinstance(payload, dict):
        return None
    method = payload.get("method")
    params = payload.get("params")
    if method == "error" and isinstance(params, dict):
        return params.get("error")
    if method == "turn/completed" and isinstance(params, dict):
        turn = params.get("turn")
        if isinstance(turn, dict) and turn.get("status") == "failed":
            return turn.get("error")
    # Older app-server builds emitted a typed top-level error event.
    if payload.get("type") == "error":
        return payload.get("error") if isinstance(payload.get("error"), dict) else payload
    return None


stdout = open(os.environ["STDOUT_FILE"], encoding="utf-8", errors="replace")
stderr = open(os.environ["STDERR_FILE"], encoding="utf-8", errors="replace")
if os.environ["APP_SERVER_MODE"] == "1":
    for line in stdout:
        try:
            payload = json.loads(line)
        except (TypeError, ValueError, json.JSONDecodeError):
            continue
        error = app_server_error(payload)
        if trusted_error(error):
            print(str(error.get("message", "")))
            raise SystemExit(0)
elif int(os.environ["PROCESS_RC"]) != 0:
    prefixes = (
        "you've hit your usage limit",
        "usage limit; try again at",
        "error: usage limit",
        "rate limit exceeded",
        "error: rate limit exceeded",
        "error: exceeded retry limit, last status: 429 too many requests",
        "token_invalidated",
        "error: token_invalidated",
        "refresh token was revoked",
        "error: refresh token was revoked",
        "token_expired",
        "error: token_expired",
        "token is expired",
        "error: token is expired",
        "session has ended",
        "error: session has ended",
    )
    for line in stderr:
        if line.strip().lower().startswith(prefixes):
            print(line.strip())
            raise SystemExit(0)
raise SystemExit(1)
PY
}

started_at=$(date +%s)
last_heartbeat=$started_at
account=""
account_lock_fds=()
capacity_reason=""
capacity_retry_at=""
while [[ -z "$account" ]]; do
  while IFS=$'\t' read -r candidate alias_group; do
    [[ -n "$candidate" ]] || continue
    if [[ "$candidate" == "__CODEX_ROTATE_CAPACITY__:account_cooldown:"* ]]; then
      capacity_reason="account_cooldown"
      capacity_retry_at="${candidate##*:}"
      break
    fi
    if [[ "$candidate" == "__CODEX_ROTATE_CAPACITY__:account_state_invalid" ]]; then
      capacity_reason="account_state_invalid"
      break
    fi
    # Retain every existing alias lock, so old launchers, probes and reconnects
    # cannot use a second name for this account during an incremental rollout.
    candidate_fds=()
    group_locked=1
    read -r -a aliases <<< "$alias_group"
    for alias in "${aliases[@]}"; do
      exec {candidate_fd}>"$LOCKS_DIR/$alias.lock"
      candidate_fds+=("$candidate_fd")
      if ! flock -n "$candidate_fd"; then
        group_locked=0
        break
      fi
    done
    if (( group_locked == 1 )); then
      # Recheck identity/group and cooldown after acquiring the existing locks.
      # Legitimate credential writers use those same locks.
      while IFS=$'\t' read -r current_candidate current_group; do
        if [[ "$current_candidate" == "$candidate" && "$current_group" == "$alias_group" ]]; then
          account="$candidate"
          account_lock_fds=("${candidate_fds[@]}")
          break
        fi
      done < <(account_order)
    fi
    [[ -z "$account" ]] || break
    for candidate_fd in "${candidate_fds[@]}"; do
      exec {candidate_fd}>&-
    done
  done < <(account_order)

  if [[ -n "$capacity_reason" ]]; then
    if [[ "$capacity_reason" == "account_cooldown" ]]; then
      now=$(date +%s)
      wait_seconds=$(( capacity_retry_at > now ? capacity_retry_at - now : 0 ))
      capacity="CAPACITY_UNAVAILABLE schema=symphony-provider-capacity/v1 class=provider-capacity retryable=true reason=$capacity_reason retryAt=$capacity_retry_at waitSeconds=$wait_seconds"
    else
      capacity="CAPACITY_UNAVAILABLE schema=symphony-provider-capacity/v1 class=provider-capacity retryable=true reason=$capacity_reason retryAt=unknown waitSeconds=unknown"
    fi
    log "$capacity"
    echo "codex-rotate: $capacity" >&2
    exit 75
  fi

  if [[ -n "$account" ]]; then
    break
  fi
  now=$(date +%s)
  if (( now - started_at >= WAIT_SECONDS )); then
    # Typed capacity signal (JOV-5031): exit 75 (EX_TEMPFAIL) plus an explicit
    # marker so account-busy startup is classifiable as capacity backoff
    # instead of a generic agent failure. The launcher exits before acquiring
    # any lock, so no orphan process or stranded account can outlive it.
    log "CAPACITY_UNAVAILABLE reason=account_busy seconds=$WAIT_SECONDS"
    echo "codex-rotate: CAPACITY_UNAVAILABLE reason=account_busy after ${WAIT_SECONDS}s wait" >&2
    exit 75
  fi
  if (( app_server_mode == 1 && HEARTBEAT_SECONDS > 0 && now - last_heartbeat >= HEARTBEAT_SECONDS )); then
    # JSON-RPC notification without an id: Symphony's reader ignores it and
    # resets the inactivity deadline. A dead reader fails this write and kills
    # the launcher (set -e / SIGPIPE) before it can strand an account.
    printf '{"jsonrpc":"2.0","method":"codex-rotate/account-wait","params":{"elapsedSeconds":%d}}\n' \
      "$(( now - started_at ))"
    last_heartbeat=$now
  fi
  sleep 1
done

home="$ACCOUNTS_ROOT/$account"
if [[ ! -f "$home/auth.json" || ! -f "$home/config.toml" ]]; then
  log "ERROR incomplete account=$account"
  echo "codex-rotate: account $account is missing auth.json or config.toml" >&2
  exit 2
fi

set_active "$account"
export CODEX_HOME="$home"
log "START account=$account lease_fds=${account_lock_fds[*]} args=$*"

tmp_out=$(mktemp)
tmp_err=$(mktemp)
tmp_provider_error=$(mktemp)
trap 'rm -f "$tmp_out" "$tmp_err" "$tmp_provider_error"' EXIT
set +e
# Keep the streams separate: Codex CLI owns stderr errors, while app-server owns
# structured stdout events. Mixing them lets arbitrary JSON-RPC values or tool
# text impersonate a provider failure.
"$REAL_CODEX" "$@" \
  > >(tee -a "$tmp_out") \
  2> >(tee -a "$tmp_err" >&2)
rc=$?
set -e
# Bash does not guarantee that process substitutions finish before the next
# command. Wait for both tee processes so the terminal event is present before
# classifying the account.
wait || true

if classify_provider_error "$tmp_out" "$tmp_err" "$rc" >"$tmp_provider_error"; then
  # The cooldown horizon comes from the authoritative account/rateLimits/read
  # snapshot; on any RPC failure the account parks on the bounded default.
  until="$(reset_until_via_rpc)" || until=""
  if [[ -z "$until" ]]; then
    until=$(( $(date +%s) + DEFAULT_COOLDOWN_SECONDS ))
  fi
  mark_cooldown "$account" "$until"
  log "COOLDOWN account=$account until=$until rc=$rc"
  if [[ "$rc" -eq 0 ]]; then
    rc=75
  fi
fi

log "EXIT account=$account rc=$rc"
exit "$rc"
