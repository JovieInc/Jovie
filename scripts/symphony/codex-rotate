#!/usr/bin/env bash
# Concurrency-safe multi-account Codex launcher for Symphony.
set -euo pipefail

REAL_CODEX="${CODEX_REAL_BIN:-$HOME/.local/bin/codex}"
ACCOUNTS_ROOT="${CODEX_ACCOUNTS_ROOT:-$HOME/.codex-accounts}"
STATE_FILE="${CODEX_ACCOUNTS_STATE:-$ACCOUNTS_ROOT/state.json}"
LOG_FILE="${CODEX_ROTATE_LOG:-$ACCOUNTS_ROOT/rotate.log}"
LOCKS_DIR="${CODEX_ACCOUNT_LOCKS_DIR:-$ACCOUNTS_ROOT/locks}"
WAIT_SECONDS="${CODEX_ACCOUNT_WAIT_SECONDS:-900}"
# JOV-5031: Symphony's app-server reader enforces read_timeout_ms (5s) as an
# inactivity deadline, not a boot budget. While this launcher waits for an
# account it is silent, so the reader used to time out and abandon the port,
# orphaning the launcher behind a dead reader where it could later seize an
# account and strand it. In app-server mode the launcher emits a typed
# keepalive line on the JSON-RPC stream; the reader treats it as an ignorable
# notification and resets its inactivity clock. If the reader is gone, the
# write fails (SIGPIPE/EPIPE) and the launcher dies before it can seize an
# account — the initialization wait is cancellation-safe and the account lock
# can never strand behind a dead reader.
HEARTBEAT_SECONDS="${CODEX_ROTATE_HEARTBEAT_SECONDS:-2}"
DEFAULT_COOLDOWN_SECONDS="${CODEX_DEFAULT_COOLDOWN_SECONDS:-21600}"
# App-server JSON-RPC budget per request (reset-window read, credit consume).
RPC_TIMEOUT="${CODEX_ROTATE_RPC_TIMEOUT:-15}"
# Banked reset-credit redemption (decisions/codex-banked-resets-authorized-on-exhaustion-2026-09-05;
# guardrails ops/tibo-codex-reset-credit-guardrails-2026-08-21). "0" disables.
REDEEM_RESET_CREDITS="${CODEX_REDEEM_RESET_CREDITS:-1}"
# Guardrail inputs: fresh evidence-backed drain demand plus non-secret
# paid-access lifecycle metadata are mandatory; anything missing or stale
# fails closed and the account simply cools.
CAPACITY_EVIDENCE="${CODEX_CAPACITY_EVIDENCE:-${GEM_WORKSPACE:-/home/timwhite/gem-workspace}/state/concurrency.json}"
REDEEM_EVIDENCE_MAX_AGE="${CODEX_REDEEM_EVIDENCE_MAX_AGE_SECONDS:-900}"
RECEIPTS_DIR="${CODEX_REDEMPTION_RECEIPTS_DIR:-$ACCOUNTS_ROOT/receipts}"

app_server_mode=0
for arg in "$@"; do
  if [[ "$arg" == "app-server" ]]; then
    app_server_mode=1
    break
  fi
done

mkdir -p "$LOCKS_DIR"
touch "$LOG_FILE"
chmod 600 "$LOG_FILE" 2>/dev/null || true

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG_FILE"
}

if ! command -v flock >/dev/null 2>&1; then
  log "ERROR flock unavailable"
  echo "codex-rotate: flock is required for account leasing" >&2
  exit 2
fi

if [[ ! -f "$STATE_FILE" ]]; then
  printf '%s\n' '{"active":null,"cooldowns":{},"last_error":{}}' >"$STATE_FILE"
  chmod 600 "$STATE_FILE"
fi

account_order() {
  ACCOUNTS_ROOT="$ACCOUNTS_ROOT" STATE_FILE="$STATE_FILE" python3 - <<'PY'
import json
import os
import re
import time
import fcntl
from pathlib import Path

def codex_account(path):
    """Only ChatGPT-authenticated profiles using the OpenAI provider belong here."""
    try:
        import tomllib
        auth = json.loads((path / "auth.json").read_text())
        config = tomllib.loads((path / "config.toml").read_text())
        if not isinstance(auth, dict) or auth.get("auth_mode") != "chatgpt":
            return False
        provider = config.get("model_provider", "openai")
        profile = config.get("profile")
        if profile is not None:
            selected = config.get("profiles", {}).get(profile)
            if not isinstance(selected, dict):
                return False
            provider = selected.get("model_provider", provider)
        return provider == "openai"
    except (OSError, ValueError, TypeError, AttributeError):
        return False


root = Path(os.environ["ACCOUNTS_ROOT"])
state_path = Path(os.environ["STATE_FILE"])
with open(str(state_path) + ".lock", "a+") as lock:
    fcntl.flock(lock, fcntl.LOCK_SH)
    try:
        state = json.loads(state_path.read_text())
        if not isinstance(state, dict):
            raise ValueError("account state must be an object")
        cooldowns = state.get("cooldowns", {})
        if not isinstance(cooldowns, dict):
            raise ValueError("cooldowns must be an object")
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        print("__CODEX_ROTATE_CAPACITY__:account_state_invalid")
        raise SystemExit
def account_groups(root):
    """Aliases of one ChatGPT account share cooldown and existing lease files."""
    groups = {}
    for path in sorted(root.iterdir()):
        if not path.is_dir() or not codex_account(path):
            continue
        if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", path.name)
                or path.is_symlink()
                or (path / "auth.json").is_symlink()
                or (path / "config.toml").is_symlink()):
            raise ValueError("unsafe account path")
        auth = json.loads((path / "auth.json").read_text())
        tokens = auth.get("tokens")
        identity = tokens.get("account_id") if isinstance(tokens, dict) else None
        if not isinstance(identity, str) or not identity.strip():
            raise ValueError("missing canonical account identity")
        # IDs remain private: only validated local alias names leave this process.
        groups.setdefault(identity, []).append(path.name)
    return list(groups.values())

try:
    groups = account_groups(root)
    cooldown_by_group = {}
    for aliases in groups:
        values = [cooldowns.get(name, 0) for name in aliases]
        if any(isinstance(value, bool) or not isinstance(value, int) for value in values):
            raise ValueError("invalid cooldown")
        cooldown_by_group[aliases[0]] = max(values)
except (OSError, ValueError, TypeError):
    print("__CODEX_ROTATE_CAPACITY__:account_state_invalid")
    raise SystemExit
now = int(time.time())
ready = [aliases for aliases in groups if cooldown_by_group[aliases[0]] <= now]
if not ready and groups:
    earliest_retry = min(cooldown_by_group.values())
    print(f"__CODEX_ROTATE_CAPACITY__:account_cooldown:{earliest_retry}")
    raise SystemExit
active = state.get("active")
ready.sort(key=lambda aliases: active not in aliases)
for aliases in ready:
    selected = active if active in aliases else aliases[0]
    print(selected + "\t" + " ".join(aliases))
PY
}

