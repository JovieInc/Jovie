}

# Reset windows come from the official app-server RPC account/rateLimits/read,
# never from parsing error text: the "try again at" strings proved ~7h
# inaccurate (9/6 RCA). Transport mirrors codex_cli_artifact.initialize: one
# `codex app-server` process, newline-delimited JSON-RPC, response matched by
# id with a bounded budget. Every failure is fail-closed (bounded default
# cooldown); the account is never parked on a guessed timestamp.
reset_until_via_rpc() {
  REAL_CODEX="$REAL_CODEX" RPC_TIMEOUT="$RPC_TIMEOUT" python3 - <<'PY' 2>>"$LOG_FILE"
import json
import os
import selectors
import subprocess
import time

EXHAUSTED_PERCENT = 99.5
MAX_COOLDOWN_SECONDS = 45 * 86400


def rpc_timeout():
    try:
        value = float(os.environ.get("RPC_TIMEOUT", "15"))
    except (TypeError, ValueError):
        return 15.0
    return value if 0 < value <= 30 else 15.0


class AppServer:
    """Newline-delimited JSON-RPC over one `codex app-server` process."""

    def __init__(self):
        self.timeout = rpc_timeout()
        self.buffer = b""
        self.process = subprocess.Popen(
            [os.environ["REAL_CODEX"], "app-server"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        self.selector = selectors.DefaultSelector()
        self.selector.register(self.process.stdout, selectors.EVENT_READ)
        status, payload = self.request(1, "initialize", {
            "clientInfo": {"name": "codex-rotate", "version": "1"},
            "capabilities": {"experimentalApi": True},
        })
        if status != "ok" or not isinstance(payload, dict) or not payload.get("userAgent"):
            raise RuntimeError("initialize failed")
        self.send({"method": "initialized", "params": {}})

    def send(self, message):
        self.process.stdin.write((json.dumps(message) + "\n").encode())
        self.process.stdin.flush()

    def request(self, request_id, method, params):
        """Returns (status, payload): 'ok' | 'error' (clean refusal) | 'ambiguous'."""
        self.send({"id": request_id, "method": method, "params": params})
        deadline = time.monotonic() + self.timeout
        while time.monotonic() < deadline:
            if self.process.poll() is not None and not self.selector.select(0):
                # The server exited: drain what it sent, but never wait on a
                # pipe a surviving child still holds open.
                break
            # Cap each wait so a server dying mid-read is caught promptly.
            if not self.selector.select(min(0.1, max(0, deadline - time.monotonic()))):
                continue
            chunk = os.read(self.process.stdout.fileno(), 4096)
            if not chunk:
                break
            self.buffer += chunk
            if len(self.buffer) > 1048576:
                raise RuntimeError("response exceeds the 1MiB bound")
            while b"\n" in self.buffer:
                line, self.buffer = self.buffer.split(b"\n", 1)
                try:
                    message = json.loads(line)
                except ValueError:
                    continue
                # Server->client requests and notifications carry a method; a
                # response to us never does. Match strictly on our id.
                if not isinstance(message, dict) or "method" in message:
                    continue
                if message.get("id") != request_id:
                    continue
                if "error" in message:
                    return "error", message.get("error")
                return "ok", message.get("result")
        return "ambiguous", None

    def close(self):
        try:
            self.selector.close()
        except Exception:
            pass
        try:
            self.process.stdin.close()
        except OSError:
            pass
        self.process.terminate()
        try:
            self.process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait()


def parse_window(value):
    if value is None:
        return None
    if not isinstance(value, dict):
        raise ValueError("window must be an object or null")
    used = value.get("usedPercent")
    resets_at = value.get("resetsAt")
    if isinstance(used, bool) or not isinstance(used, (int, float)):
        raise ValueError("usedPercent must be a number")
    # resetsAt is nullable in the v2 schema: a window without a known recovery
    # instant can never supply a cooldown target.
    if resets_at is not None and (isinstance(resets_at, bool) or not isinstance(resets_at, int)):
        raise ValueError("resetsAt must be epoch seconds or null")
    return {"usedPercent": float(used), "resetsAt": resets_at}


def parse_snapshot(result):
    if not isinstance(result, dict):
        raise ValueError("rateLimits result must be an object")
    rate_limits = result.get("rateLimits")
    if not isinstance(rate_limits, dict):
        raise ValueError("rateLimits must be an object")
    reached = rate_limits.get("rateLimitReachedType")
    if reached is not None and not isinstance(reached, str):
        raise ValueError("rateLimitReachedType must be a string or null")
    return {
        "primary": parse_window(rate_limits.get("primary")),
        "secondary": parse_window(rate_limits.get("secondary")),
        "reached": reached,
    }


def binding_reset(snapshot):
    exhausted = [
        snapshot[name]["resetsAt"]
        for name in ("primary", "secondary")
        if snapshot[name] is not None
        and snapshot[name]["usedPercent"] >= EXHAUSTED_PERCENT
        and snapshot[name]["resetsAt"] is not None
    ]
    if not exhausted:
        return None
    return max(exhausted)


now = int(time.time())
try:
    server = AppServer()
except (OSError, RuntimeError):
    raise SystemExit(1)
try:
    status, payload = server.request(2, "account/rateLimits/read", {})
finally:
    server.close()
if status != "ok":
    raise SystemExit(1)
try:
    snapshot = parse_snapshot(payload)
except ValueError:
    raise SystemExit(1)
until = binding_reset(snapshot)
if until is None or until <= now or until > now + MAX_COOLDOWN_SECONDS:
    # The typed limit event contradicts the snapshot, or the reset time is
    # implausible: park on the bounded default instead of trusting it.
    raise SystemExit(1)
print(until)
PY
}

