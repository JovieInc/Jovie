#!/usr/bin/env bash
set -euo pipefail

[[ "$(id -u)" -eq 0 ]] || { echo "must run as root" >&2; exit 77; }

if [[ "${1:-}" != --inside ]]; then
  exec unshare --mount --propagation private "$0" --inside
fi

helper="/usr/local/sbin/jovie-symphony-workspace"
simulation_root="$(mktemp -d /tmp/jovie-symphony-boot-simulation.XXXXXX)"
overlay_targets=(
  /srv/worktrees
  /srv/models
  /srv/cache
  /srv/scratch
  /srv/git
  /var/lib/jovie-symphony-workspaces
  /home/timwhite/symphony-elixir-workspaces
  /home/timwhite/codex-qualification
)

cleanup() {
  local index
  for ((index=${#overlay_targets[@]}-1; index>=0; index--)); do
    umount "${overlay_targets[$index]}" 2>/dev/null || true
  done
  rm -rf -- "$simulation_root"
}
trap cleanup EXIT

for target in "${overlay_targets[@]}"; do
  install -d -m 0755 "$simulation_root$target" "$target"
  mount --bind "$simulation_root$target" "$target"
done

specs=(
  "legacy:JOV-9900000"
  "legacy:JOV-9900001"
  "legacy:JOV-9900008"
  "legacy:JOV-9900002"
  "elixir:JOV-9900010"
  "qualification:qualification-boot-proof"
)
logical_root_for_namespace() {
  case "$1" in
    legacy) printf '/srv/worktrees/jovie\n' ;;
    elixir) printf '/home/timwhite/symphony-elixir-workspaces\n' ;;
    qualification) printf '/home/timwhite/codex-qualification\n' ;;
    *) return 1 ;;
  esac
}
for spec in "${specs[@]}"; do
  namespace="${spec%%:*}"
  issue="${spec#*:}"
  logical="$(logical_root_for_namespace "$namespace")/$issue"
  install -d -o timwhite -g timwhite -m 0755 "$logical"
  "$helper" prepare "$logical" >/dev/null
  install -d -o timwhite -g timwhite -m 0755 "$logical/.git"
  "$helper" activate "$logical"
done

before_restore="$($helper status)"
[[ "$(grep -c 'mounted=true' <<<"$before_restore")" -eq 6 ]] || { echo "activation count mismatch" >&2; exit 1; }

for spec in "${specs[@]}"; do
  namespace="${spec%%:*}"
  issue="${spec#*:}"
  umount "$(logical_root_for_namespace "$namespace")/$issue"
done
lost_mounts="$($helper status)"
[[ "$(grep -c 'mounted=false' <<<"$lost_mounts")" -eq 6 ]] || { echo "lost-mount simulation failed" >&2; exit 1; }

"$helper" restore-all
after_restore="$($helper status)"
[[ "$(grep -c 'mounted=true' <<<"$after_restore")" -eq 6 ]] || { echo "restore-all count mismatch" >&2; exit 1; }

for spec in "${specs[@]}"; do
  namespace="${spec%%:*}"
  issue="${spec#*:}"
  logical="$(logical_root_for_namespace "$namespace")/$issue"
  route="$($helper route "$namespace" "$issue")"
  backing="$(awk -F= '$1 == "backing" {print $2}' <<<"$route")"
  [[ "$(stat -Lc '%d:%i' "$logical")" == "$(stat -Lc '%d:%i' "$backing")" ]] || {
    echo "restored inode mismatch: $issue" >&2
    exit 1
  }
  "$helper" cleanup "$logical"
  [[ ! -e "$logical" && ! -e "$backing" ]] || { echo "cleanup residual: $issue" >&2; exit 1; }
done

[[ -z "$($helper status)" ]] || { echo "manifest residual after cleanup" >&2; exit 1; }
printf 'boot_simulation=pass\nbuckets=0,1,2,3\nrestore_all=pass\ncleanup=pass\nnamespace=private\n'
