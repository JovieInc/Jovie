#!/usr/bin/env bash
set -euo pipefail

# Symphony starts one app-server per leased issue. The admission controller
# writes a verified symphony-routing/v1 receipt to the Linear workpad before
# the lease exists; this launcher re-fetches that receipt, semantically
# re-verifies it against the current issue and the model registry, binds live
# codex-rotate capacity, and materializes it atomically into the workspace.
# Any gap fails closed (exit 78) rather than silently using a volume model.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
workspace="${SYMPHONY_WORKSPACE:-$PWD}"
issue="${SYMPHONY_ISSUE_IDENTIFIER:-$(basename "$workspace")}"

# Symphony treats read_timeout_ms as an inactivity deadline while waiting for
# the app-server initialize response. Pickup and routing both consult Linear,
# so a healthy preflight can exceed that five-second window and be killed as a
# false response_timeout before codex-rotate starts. Keep the JSON-RPC stream
# alive during preflight; codex-rotate takes over the same responsibility while
# it waits for an account lease.
preflight_heartbeat_pid=""
stop_preflight_heartbeat() {
  if [ -n "$preflight_heartbeat_pid" ]; then
    kill "$preflight_heartbeat_pid" 2>/dev/null || true
    wait "$preflight_heartbeat_pid" 2>/dev/null || true
    preflight_heartbeat_pid=""
  fi
}
for arg in "$@"; do
  if [ "$arg" = "app-server" ]; then
    heartbeat_seconds="${SYMPHONY_ROUTER_HEARTBEAT_SECONDS:-2}"
    if [ "$heartbeat_seconds" -gt 0 ] 2>/dev/null; then
      parent_pid="$$"
      (
        trap 'exit 0' TERM INT
        trap 'kill -TERM "$parent_pid" 2>/dev/null || true; exit 0' PIPE
        started_at="$(date +%s)"
        while sleep "$heartbeat_seconds"; do
          printf '{"jsonrpc":"2.0","method":"symphony-router/preflight","params":{"elapsedSeconds":%d}}\n' \
            "$(( $(date +%s) - started_at ))" || {
              kill -TERM "$parent_pid" 2>/dev/null || true
              exit 0
            }
        done
      ) &
      preflight_heartbeat_pid="$!"
      trap stop_preflight_heartbeat EXIT TERM INT
    fi
    break
  fi
done

# One implementation owner per issue: the fallback sidecar takes the same
# lease before it starts grok/cursor/kimi. If that lock is held, refuse Codex.
# Pickup-check GCs stale leftover locks and refuses In Review / Done / open PR
# with a typed reason so a leftover file cannot keep running=0 forever.
EXHAUSTED="${SYMPHONY_CODEX_EXHAUSTED:-$SCRIPT_DIR/symphony-codex-exhausted.py}"
if [ -f "$EXHAUSTED" ]; then
  python3 "$EXHAUSTED" pickup-check "$issue" || exit 78
fi
LEASE_DIR="${SYMPHONY_FALLBACK_LEASE_DIR:-$HOME/.local/state/symphony-fallback/leases}"
mkdir -p "$LEASE_DIR"
LOCK_FILE="$LEASE_DIR/$issue.lock"
if [ "${SYMPHONY_ISSUE_LEASE_FD:-}" != "9" ]; then
  exec 9>>"$LOCK_FILE"
fi
if ! python3 - "$LOCK_FILE" <<'PYLOCK'
import fcntl, os, sys
try:
    descriptor, path = os.fstat(9), os.stat(sys.argv[1])
    if (descriptor.st_dev, descriptor.st_ino) != (path.st_dev, path.st_ino):
        raise OSError("inherited issue claim has a different inode")
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    raise SystemExit(1)
PYLOCK
then
  echo 'SYMPHONY_LAUNCHER_FAILURE schema=symphony-launcher-failure/v1 class=issue-lease-busy retryable=true reason="issue claim unavailable"' >&2
  exit 75
fi
export SYMPHONY_ISSUE_LEASE_FD=9

if [ "${SYMPHONY_ROUTING_USE_MATERIALIZED:-0}" = "1" ]; then
  model="$(node - "$workspace/.symphony-routing.json" "$SCRIPT_DIR/config/model-registry.json" "$issue" <<'JS'
const fs = require('node:fs');
const [receiptPath, registryPath, issue] = process.argv.slice(2);
const receipt = JSON.parse(fs.readFileSync(receiptPath, 'utf8'));
const registry = JSON.parse(fs.readFileSync(registryPath, 'utf8'));
const allowed = new Set(
  registry.models
    .filter(entry => entry.provider === 'codex')
    .map(entry => entry.model)
);
if (
  receipt.schema !== 'symphony-routing/v1' ||
  receipt.issue !== issue ||
  typeof receipt.model !== 'string' ||
  !allowed.has(receipt.model)
) {
  throw new Error('materialized routing receipt is invalid');
}
process.stdout.write(`${receipt.model}\n`);
JS
)" || {
    echo "SYMPHONY_LAUNCHER_FAILURE schema=symphony-launcher-failure/v1 class=materialized-route-invalid retryable=false maxAttempts=1 reason=\"invalid local route for $issue\"" >&2
    exit 78
  }
else
  model="$(node "$SCRIPT_DIR/../backlog-orchestrator/symphony-routing.mjs" launch \
    --workspace "$workspace" \
    --issue "$issue")"
fi

stop_preflight_heartbeat
trap - EXIT TERM INT
# The tracker credential is needed only for receipt verification. Never pass it
# into the coding-agent process, even when the host injects it for preflight.
unset LINEAR_API_KEY
exec "${SYMPHONY_CODEX_ROTATE:-$HOME/.local/bin/codex-rotate}" \
  --config shell_environment_policy.inherit=all \
  --config "model=\"${model}\"" \
  "$@"
