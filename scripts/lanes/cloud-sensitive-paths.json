{
  "schema": "jovie.cloud-sensitive-paths/v1",
  "note": "JOV-10357 fail-closed deny policy for Codex Cloud candidate patches. Loaded by scripts/lanes/cloud_lane.py; a missing or invalid file holds everything. Rules match the NFKC + casefold policy key of the exact Git path bytes. prefixes match the full path start; names match any single path component (basename); regexes search the full casefolded path. Mode, type, size and .git-component rules live in cloud_lane.py, not here.",
  "deny": {
    "prefixes": [
      ".github/",
      ".codex/",
      ".claude/",
      ".husky/",
      ".cursor/",
      "migrations/",
      "drizzle/",
      "infra/",
      "terraform/",
      "canon/",
      "scripts/lanes/",
      "scripts/agent/"
    ],
    "names": [
      "codeowners",
      ".gitattributes",
      ".gitmodules",
      ".npmrc",
      ".nvmrc",
      ".node-version",
      "agents.md",
      "codex.md",
      "claude.md",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package-lock.json",
      "yarn.lock",
      "npm-shrinkwrap.json",
      "pyproject.toml",
      "poetry.lock",
      "go.mod",
      "go.sum",
      "vercel.json",
      "turbo.json"
    ],
    "regexes": [
      "(^|/)\\.env[^/]*$",
      "(^|/)\\.envrc$",
      "(^|/)\\.dev\\.vars[^/]*$",
      "(^|/)\\.yarnrc[^/]*$",
      "(^|/)bun\\.lock[^/]*$",
      "(^|/)requirements[^/]*\\.txt$",
      "(^|/)cargo\\.(toml|lock)$",
      "(^|/)gemfile[^/]*$",
      "(^|/)wrangler\\.[^/]+$",
      "(^|/)dockerfile[^/]*$",
      "\\.sql$",
      "(^|/)[0-9]{4}_",
      "(^|/)(auth|better-auth|session|login|signin|signup|oauth)([./]|$)",
      "(^|/)middleware\\.[^/]+$",
      "(^|/)(billing|stripe|payments?|checkout|subscriptions?|invoices?|pricing)([./]|$)",
      "(^|/)(secrets?|credentials?|doppler)([./]|$)",
      "\\.pem$",
      "\\.key$",
      "^scripts/lib/source-admission-policy\\.mjs$",
      "^scripts/pr-fleet-rules\\.mjs$",
      "^scripts/ci[^/]*",
      "^scripts/tests/test_cloud_lane",
      "^scripts/tests/test_lane_runner",
      "^scripts/tests/test_pr_events"
    ]
  }
}
