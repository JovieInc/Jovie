  "hyperagent": {
    "label": "hyperagent",
    "model": "z-ai/glm-5.3",
    "slots": 2,
    "health": ["hyperagent", "models", "--json"],
    "healthy": "glm-5\\.3",
    "cmd": ["hyperagent", "--model", "z-ai/glm-5.3", "-p", "{prompt}"],
    "enabled": false
  }
