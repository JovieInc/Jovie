{
  "devin": {
    "label": "devin",
    "model": "swe-2-medium",
    "slots": 4,
    "health": ["devin", "auth", "status"],
    "healthy": "Logged in",
    "cmd": [
      "devin",
      "-p",
      "--prompt-file",
      "{prompt_file}",
      "--model",
      "swe-2-medium",
      "--permission-mode",
      "dangerous",
      "--respect-workspace-trust",
      "false"
    ]
  },
  "codex": {
    "label": "codex",
    "model": "codex-default",
    "slots": 3,
    "health": ["python3", "{here}/codex_lane.py", "health"],
