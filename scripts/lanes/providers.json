      "python3",
      "{here}/codex_lane.py",
      "run",
      "--prompt-file",
      "{prompt_file}",
      "--cwd",
      "{cwd}"
    ]
  },
  "claude": {
    "label": "claude",
    "model": "sonnet",
    "slots": 2,
    "health": ["claude", "auth", "status"],
