{
  "schema": "jovie.queue-drift-guards/v1",
  "purpose": "Every checked-in baseline and what happens to it when two green PRs combine. scripts/lib/__tests__/queue-drift-guards.test.mjs fails when a tracked baseline is missing here.",
  "guards": [
    {
      "id": "design-noise",
      "baseline": "apps/web/design-noise.baseline.json",
      "semantic": "shrink-only",
      "check": "node apps/web/scripts/lint-design-noise.mjs",
      "tighten": "node apps/web/scripts/lint-design-noise.mjs --tighten"
    },
    {
      "id": "marketing-route-source-invariants",
      "baseline": "apps/web/tests/unit/marketing/marketing-route-source-invariants.baseline.json",
      "semantic": "shrink-only",
      "check": "pnpm --filter @jovie/web exec vitest run --config vitest.config.fast.mts tests/unit/marketing/marketing-route-source-invariants.test.ts",
      "tighten": "TIGHTEN_BASELINES=1 pnpm --filter @jovie/web exec vitest run --config vitest.config.fast.mts tests/unit/marketing/marketing-route-source-invariants.test.ts"
    },
    {
      "id": "offer-claims",
      "baseline": "scripts/invariants/offer-claims/baseline.json",
      "semantic": "shrink-only",
      "check": "node scripts/invariants/offer-claims/check.mjs",
      "tighten": "node scripts/invariants/offer-claims/check.mjs --tighten"
    },
    {
      "id": "stat-claims",
      "baseline": "scripts/invariants/stat-claims/baseline.json",
      "semantic": "shrink-only",
      "check": "node scripts/invariants/stat-claims/check.mjs",
      "tighten": "node scripts/invariants/stat-claims/check.mjs --tighten"
    },
    {
      "id": "size-500",
      "baseline": "scripts/company-guards/size-baseline.json",
      "semantic": "shrink-only",
      "check": "node scripts/company-guards/size-ratchet.mjs --no-raise origin/main",
      "tighten": "node scripts/company-guards/size-ratchet.mjs --tighten"
    }
  ],
  "combineSafe": {
