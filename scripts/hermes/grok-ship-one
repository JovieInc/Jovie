#!/usr/bin/env bash
# Ship one already-admitted Linear issue through the canonical model-router fallback.
set -euo pipefail

ID="${1:?issue identifier required}"
case "$ID" in
  JOV-[0-9]*) TEAM=JOV; REPO=JovieInc/Jovie ;;
  LYB-[0-9]*) TEAM=LYB; REPO=JovieInc/LogYourBody ;;
  *) echo "unsupported issue identifier" >&2; exit 2 ;;
esac

export PATH="$HOME/.local/bin:$PATH:/usr/bin:/bin"
set -a
# shellcheck disable=SC1091
[ -f "$HOME/.config/symphony/linear.env" ] && . "$HOME/.config/symphony/linear.env"
set +a
: "${LINEAR_API_KEY:?LINEAR_API_KEY is required}"

BRANCH="fallback/${ID}-fix"
WS_ROOT="${GROK_SHIP_WS_ROOT:-$HOME/grok-ship-workspaces}/$TEAM"
WS="$WS_ROOT/$ID"
LOG_DIR="${GROK_SHIP_LOG_DIR:-$HOME/grok-ship-logs}"
LOG="$LOG_DIR/$ID.log"
LEASE_DIR="${SYMPHONY_FALLBACK_LEASE_DIR:-$HOME/.local/state/symphony-fallback/leases}"
RECEIPT_DIR="${SYMPHONY_FALLBACK_RECEIPT_DIR:-$HOME/.local/state/symphony-fallback/receipts}"
mkdir -p "$LOG_DIR" "$WS_ROOT" "$LEASE_DIR" "$RECEIPT_DIR"
: "${SYMPHONY_FALLBACK_SELECTION_B64:?router selection is required}"
: "${SYMPHONY_FALLBACK_ISSUE_REVISION:?issue revision is required}"
: "${SYMPHONY_FALLBACK_BUNDLE_REVISION:?bundle revision is required}"
: "${SYMPHONY_FALLBACK_UNIT:?fallback unit is required}"
exec 9>"$LEASE_DIR/$ID.lock"
if ! flock -n 9; then
  echo "$(date -u +%FT%TZ) $ID duplicate_lease" >> "$LOG"
  exit 0
fi

SELECTION_JSON="$(SELECTION_B64="$SYMPHONY_FALLBACK_SELECTION_B64" python3 - <<'PY'
import base64, json, os
try:
    payload = json.loads(base64.b64decode(os.environ["SELECTION_B64"], validate=True))
    selected = payload["selected"]
    executor = selected["executor"]
    valid = (
        payload.get("schema_version") == 1
        and payload.get("deterministic_first") is True
        and selected.get("provider") != "codex"
        and isinstance(selected.get("id"), str)
        and isinstance(selected.get("model"), str)
        and isinstance(executor.get("executable"), str)
        and isinstance(executor.get("argv"), list)
        and all(isinstance(value, str) for value in executor["argv"])
    )
except (KeyError, TypeError, ValueError):
    valid = False
if not valid:
    raise SystemExit("invalid router selection")
print(json.dumps(payload, separators=(",", ":")))
PY
)"

REMOUNT=0
EXISTING_NUMBER=""
if VERDICT_JSON="$(symphony-codex-exhausted open-pr-verdict "$ID" 2>/dev/null)"; then
  VERDICT="$(python3 -c 'import json,sys; print((json.loads(sys.argv[1]) or {}).get("verdict") or "none")' "$VERDICT_JSON")"
  EXISTING_HEAD="$(python3 -c 'import json,sys; print((json.loads(sys.argv[1]) or {}).get("head") or "")' "$VERDICT_JSON")"
  EXISTING_NUMBER="$(python3 -c 'import json,sys; print((json.loads(sys.argv[1]) or {}).get("number") or "")' "$VERDICT_JSON")"
else
  VERDICT=none
  EXISTING_HEAD=""
fi
if [ "$VERDICT" = skip ]; then
  echo "$(date -u +%FT%TZ) $ID open_pr_exists" >> "$LOG"
  exit 0
fi
if [ "$VERDICT" = remount ] && [ -n "$EXISTING_HEAD" ]; then
  BRANCH="$EXISTING_HEAD"
  REMOUNT=1
  echo "$(date -u +%FT%TZ) $ID remount_ci_red pr=$EXISTING_NUMBER head=$BRANCH" >> "$LOG"
fi

# Single admission source of truth: delegate the admission decision to the
# controller's check-admission command, which uses the SAME predicate as the
# reconcile selector (current admission-gate/v1 receipt, no blocked/human hold).
# Remount of an existing DIRTY/CI-red head skips the receipt so leftover
# GitHub work is not starved after Linear's receipt list goes empty.
# exit 0 = admitted (meta JSON on stdout); 1 = not admitted; 2 = unverifiable.
if [ "$REMOUNT" = 1 ]; then
  admission_args=(check-admission "$ID" --remount)
else
  admission_args=(check-admission "$ID")
fi
if ADMISSION_OUT="$(symphony-codex-exhausted "${admission_args[@]}" 2>&1)"; then
  META="$ADMISSION_OUT"
else
  admission_rc=$?
  echo "$(date -u +%FT%TZ) $ID admission_rc=$admission_rc: $(printf '%s' "$ADMISSION_OUT" | tail -n 1)" >> "$LOG"
  if [ "$admission_rc" -eq 2 ]; then
    echo "admission verification failed (Linear unreachable or bundle not installed)" >&2
    exit 2
  fi
  echo "issue is not admitted" >&2
  exit 0
fi

json_value() {
  python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get(sys.argv[2]) or "")' "$META" "$1"
}

TITLE="$(json_value title)"
URL="$(json_value url)"
DESC="$(json_value description)"
ISSUE_UUID="$(json_value id)"
ORIGINAL_STATE_ID="$(json_value original_state_id)"
ORIGINAL_STATE_NAME="$(json_value original_state_name)"
IN_PROGRESS_STATE_ID="$(json_value in_progress_state_id)"
IN_REVIEW_STATE_ID="$(json_value in_review_state_id)"
ISSUE_REVISION="$(json_value issue_revision)"
if [ "$ISSUE_REVISION" != "$SYMPHONY_FALLBACK_ISSUE_REVISION" ]; then
  echo "issue revision changed before lease acquisition" >&2
  exit 2
fi

GEM_FLEET_GATE_RECEIPT="${GEM_FLEET_GATE_RECEIPT:-$HOME/gem-workspace/state/gem-priority-gate/latest.json}" \
python3 - <<'PY'
import json, os, pathlib
try:
    receipt = json.loads(pathlib.Path(os.environ["GEM_FLEET_GATE_RECEIPT"]).read_text())
except (OSError, ValueError):
    raise SystemExit("fleet gate unavailable")
admission = receipt.get("workAdmission")
if (
    receipt.get("schema") != "jovie-fleet-gate/v1"
    or receipt.get("state") not in ("GREEN", "AMBER")
    or not isinstance(admission, dict)
    or admission.get("allowed") is not True
):
    raise SystemExit("fleet gate blocks isolated work")
PY

if [ ! -d "$WS/.git" ]; then
  if [ -e "$WS" ] && [ -n "$(find "$WS" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
    echo "workspace exists without git: $WS" >&2
    exit 2
  fi
  git clone --depth 1 "https://github.com/$REPO.git" "$WS"
fi
if [ "$REMOUNT" != 1 ] && [ -n "$(git -C "$WS" status --porcelain)" ]; then
  echo "workspace has uncommitted changes: $WS" >&2
  exit 2
fi
if [ "$REMOUNT" = 1 ]; then
  # Depth-1 fetches of main and the PR head do not share a merge-base, so
  # `git merge origin/main` fails with unrelated histories and the PR stays DIRTY.
  git -C "$WS" fetch origin "refs/heads/${BRANCH}:refs/remotes/origin/${BRANCH}"
  git -C "$WS" fetch origin main
  git -C "$WS" checkout -B "$BRANCH" "origin/$BRANCH"
  git -C "$WS" reset --hard "origin/$BRANCH"
  if [ "$(git -C "$WS" rev-parse --is-shallow-repository 2>/dev/null || printf true)" = "true" ]; then
    git -C "$WS" fetch --unshallow origin || git -C "$WS" fetch --deepen=200 origin
  fi
  if ! git -C "$WS" merge-base HEAD origin/main >/dev/null 2>&1; then
    git -C "$WS" fetch --deepen=500 origin
  fi
  git -C "$WS" merge --no-edit origin/main
else
  git -C "$WS" fetch --depth 1 origin main
  git -C "$WS" checkout -B "$BRANCH" origin/main
fi

update_state() {
  local state_id="$1"
  ISSUE_UUID="$ISSUE_UUID" STATE_ID="$state_id" python3 - <<'PY'
import json, os, urllib.request
query = "mutation($id:String!,$input:IssueUpdateInput!){issueUpdate(id:$id,input:$input){success}}"
request = urllib.request.Request(
    os.environ.get("LINEAR_API_URL", "https://api.linear.app/graphql"),
    data=json.dumps({"query": query, "variables": {"id": os.environ["ISSUE_UUID"], "input": {"stateId": os.environ["STATE_ID"]}}}).encode(),
    headers={"Authorization": os.environ["LINEAR_API_KEY"], "Content-Type": "application/json"},
)
with urllib.request.urlopen(request, timeout=20) as response:
    payload = json.load(response)
if payload.get("errors") or not ((payload.get("data") or {}).get("issueUpdate") or {}).get("success"):
    raise SystemExit("state update failed")
PY
}

changed_state=0
original_state_lower="$(printf '%s' "$ORIGINAL_STATE_NAME" | tr '[:upper:]' '[:lower:]')"
if [ "$original_state_lower" != "in progress" ]; then
  update_state "$IN_PROGRESS_STATE_ID"
  changed_state=1
fi

if [ "$REMOUNT" = 1 ]; then
  PROMPT="You are fixing failing CI on existing PR ${EXISTING_NUMBER:-unknown} ($BRANCH) for Linear issue $ID in $REPO.

Title: $TITLE
URL: $URL

Description:
$DESC

Work only in this checkout of $BRANCH. Do not open a second PR. Do not reset to main. If the branch is behind or conflicting with origin/main, finish the merge/rebase onto origin/main, then push to the existing head.
Fix the failing checks. If scripts-typecheck exceeds the baseline, fix the new TypeScript errors; do not regenerate the baseline unless the errors are genuinely pre-existing on main.
Do not weaken or skip gates. Do not merge, deploy, promote, or remove queue-deferred. If blocked, write BLOCKER.md with the exact reason and exit. Start now."
else
  PROMPT="You are implementing admitted Linear issue $ID in $REPO under a revision-scoped fallback lease.

Title: $TITLE
URL: $URL

Description:
$DESC

Work only in this checkout. Make the smallest correct issue-scoped change. Do not weaken or skip gates.
If scripts-typecheck exceeds the baseline, fix the new TypeScript errors; do not regenerate the baseline unless the errors are genuinely pre-existing on main.
Create commits on $BRANCH, push normally, and open a ready PR to main with validation evidence, Fixes $ID, and the queue-deferred hold.
Do not merge, deploy, promote, or remove queue-deferred. If blocked, write BLOCKER.md with the exact reason and exit. Start now."
fi

RECEIPT="$RECEIPT_DIR/$ID.json"
RECEIPT_PATH="$RECEIPT" RECEIPT_ID="$ID" RECEIPT_ISSUE_REVISION="$ISSUE_REVISION" \
RECEIPT_BUNDLE_REVISION="$SYMPHONY_FALLBACK_BUNDLE_REVISION" RECEIPT_SELECTION="$SELECTION_JSON" \
RECEIPT_BASE_REVISION="$(git -C "$WS" rev-parse HEAD)" RECEIPT_UNIT="$SYMPHONY_FALLBACK_UNIT" python3 - <<'PY'
import hashlib, json, os, pathlib, re, tempfile, time
selection = json.loads(os.environ["RECEIPT_SELECTION"])["selected"]
identifier = os.environ["RECEIPT_ID"]
issue_revision = os.environ["RECEIPT_ISSUE_REVISION"]
base_revision = os.environ["RECEIPT_BASE_REVISION"]
bundle_revision = os.environ["RECEIPT_BUNDLE_REVISION"]
expected_unit = f"fallback-ship-{identifier}-{hashlib.sha256(issue_revision.encode()).hexdigest()[:12]}"
if (
    not re.fullmatch(r"[0-9a-f]{40}", base_revision)
    or not re.fullmatch(r"[0-9a-f]{64}", bundle_revision)
    or os.environ["RECEIPT_UNIT"] != expected_unit
):
    raise SystemExit("fallback provenance is invalid")
payload = {
    "schema": "symphony-fallback-lease/v1",
    "observedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "identifier": identifier,
    "issueRevision": issue_revision,
    "baseRevision": base_revision,
    "bundleRevision": bundle_revision,
    "unit": expected_unit,
    "provider": selection["provider"],
    "model": selection["model"],
    "modelId": selection["id"],
    "ownership": "isolated-implementation-only",
    "forbidden": ["merge", "deploy", "promote", "remove-queue-deferred"],
}
path = pathlib.Path(os.environ["RECEIPT_PATH"])
fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
try:
    with os.fdopen(fd, "w") as handle:
        json.dump(payload, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY

attempt_log="$(mktemp "$LOG_DIR/.${ID}.attempt.XXXXXX")"
trap 'rm -f "$attempt_log"' EXIT
echo "START $ID $(date -u +%FT%TZ) repo=$REPO" | tee -a "$LOG"
set +e
SELECTION_JSON="$SELECTION_JSON" FALLBACK_PROMPT="$PROMPT" FALLBACK_CWD="$WS" python3 - <<'PY' 2>&1 | tee -a "$LOG" "$attempt_log"
import json, os, pathlib, subprocess
selected = json.loads(os.environ["SELECTION_JSON"])["selected"]
executor = selected["executor"]
values = {
    "cwd": os.environ["FALLBACK_CWD"],
    "model": selected["model"],
    "prompt": os.environ["FALLBACK_PROMPT"],
}
argv = [value.format(**values) for value in executor["argv"]]
executable = executor["executable"]
env = os.environ.copy()
grok = os.environ.get("GEM_GROK_EXECUTABLE") or os.environ.get("GEM_GROK_BIN") or ""
hermes = pathlib.Path(executable).name == "hermes"
if hermes and grok and os.access(grok, os.X_OK):
    # Hermes on Gem uses OpenRouter (max_tokens 65536) and 402s. Prefer included grok.
    print("rewrite_hermes_openrouter_to_grok", grok, flush=True)
    executable = grok
    argv = [
        "-m", "grok-4.6",
        "--always-approve",
        "--cwd", values["cwd"],
        "--disable-web-search",
        "--no-subagents",
        "-p", values["prompt"],
    ]
elif hermes:
    cap = os.environ.get("SYMPHONY_HERMES_MAX_TOKENS", "512")
    env["HERMES_MAX_TOKENS"] = cap
    if "--max-tokens" not in argv:
        argv = ["--max-tokens", cap, *argv]
        print(f"hermes_max_tokens={cap}", flush=True)
result = subprocess.run(
    [executable, *argv],
    cwd=pathlib.Path(values["cwd"]),
    env=env,
    check=False,
    capture_output=True,
    text=True,
)
sys_out = (result.stdout or "") + (result.stderr or "")
print(sys_out, end="")
if "402" in sys_out and ("max_tokens" in sys_out or "can only afford" in sys_out):
    raise SystemExit(2)
raise SystemExit(result.returncode)
PY
rc=${PIPESTATUS[0]}
set -e

pr_count="$(gh pr list --repo "$REPO" --head "$BRANCH" --state open --json number --jq 'length' 2>/dev/null || printf 0)"
if [ "$pr_count" -gt 0 ]; then
  pr_number="$(gh pr list --repo "$REPO" --head "$BRANCH" --state open --json number --jq '.[0].number' 2>/dev/null || true)"
  if [ -z "$pr_number" ]; then
    echo "PR exists but number could not be proven" >&2
    exit 2
  fi
  # Do not add queue-deferred. That label hard-gates native autoenroll during
  # hold-intake (production-unbound), which is the common AMBER lane while
  # Production Controller FIFO catches up. Native MQ is the hold.
  if [ "$(gh pr view "$pr_number" --repo "$REPO" --json isDraft --jq '.isDraft')" = "true" ]; then
    gh pr ready "$pr_number" --repo "$REPO"
  fi
  update_state "$IN_REVIEW_STATE_ID"
  echo "END $ID rc=$rc pr=open $(date -u +%FT%TZ)" | tee -a "$LOG"
  exit "$rc"
fi

if [ "$changed_state" -eq 1 ] && [ -n "$ORIGINAL_STATE_ID" ]; then
  update_state "$ORIGINAL_STATE_ID"
fi
echo "END $ID rc=$rc pr=missing state=restored $(date -u +%FT%TZ)" | tee -a "$LOG"
[ "$rc" -ne 0 ] && exit "$rc"
exit 2
