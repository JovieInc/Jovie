#!/usr/bin/env bash
set -euo pipefail

logical="${1:-}"
helper="/usr/local/sbin/jovie-symphony-workspace"
clone_tool="/home/timwhite/.local/bin/jovie-workspace-clone"
cache_hook="/home/timwhite/.local/bin/symphony-nvme-package-cache"
node_bin="/home/timwhite/.nvm/versions/node/v22.23.2/bin"
cache_receipts="/srv/git/receipts/workspace-mounts"

[[ -n "$logical" ]] || { echo "workspace path required" >&2; exit 64; }
logical="$(realpath -m "$logical")"
issue="$(basename "$logical")"
[[ "$issue" =~ ^JOV-[0-9]+$ ]] || { echo "invalid issue workspace: $logical" >&2; exit 65; }
[[ -x "$node_bin/node" ]] || { echo "required Node 22.23.2 runtime missing: $node_bin/node" >&2; exit 69; }

export PATH="$node_bin:/usr/local/bin:/usr/bin:/bin"
[[ "$(node --version)" == "v22.23.2" ]] || { echo "Node runtime mismatch: $(node --version)" >&2; exit 69; }
[[ "$(pnpm --version)" == "9.15.4" ]] || { echo "pnpm runtime mismatch: $(pnpm --version)" >&2; exit 69; }

sudo -n "$helper" prepare "$logical"
cleanup_on_error() {
  status="${1:-1}"
  sudo -n "$helper" abort "$logical" || true
  exit "$status"
}
if "$clone_tool" "$logical"; then
  :
else
  cleanup_on_error "$?"
fi
if [[ ! -f "$cache_hook" || -L "$cache_hook" ]]; then
  echo "trusted cache hook missing: $cache_hook" >&2
  cleanup_on_error 70
fi
if (
    cd "$logical"
    SYMPHONY_ISSUE_IDENTIFIER="$issue" \
    SYMPHONY_TRUSTED_HOOK_PHASE=after_create \
    SYMPHONY_NVME_RECEIPT_DIR="$cache_receipts" \
      bash "$cache_hook" after-create
  ); then
  :
else
  cleanup_on_error "$?"
fi
if sudo -n "$helper" activate "$logical"; then
  :
else
  cleanup_on_error "$?"
fi
