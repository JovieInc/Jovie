[Unit]
Description=Gem Symphony HUD on tty1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{JOVIE_REPO}}
ExecStart={{JOVIE_REPO}}/scripts/hermes/gem-checkin-tty1.sh --width 430 --height 90
Restart=always
RestartSec=2
StandardInput=null
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=no
TTYVTDisallocate=yes
Environment=PYTHONUNBUFFERED=1
Environment=TERM=linux
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
EnvironmentFile=-%h/.config/symphony/linear.env

[Install]
WantedBy=default.target
