{
  "schemaVersion": 2,
  "projectId": "jovie",
  "maxTargets": 9,
  "sourceExtensions": [".ts"],
  "excludedPathSegments": [
    ".git",
    ".deepsec",
    ".agents",
    ".claude",
    ".codex",
    "node_modules",
    "vendor",
    "dist",
    "build",
    ".next",
    ".vercel",
    "coverage",
    "generated",
    "fixtures",
    "__fixtures__"
  ],
  "scanner": { "package": "deepsec", "version": "2.3.10" },
  "modelAuth": "gateway",
  "providerFallback": false,
  "gatewayTags": ["security-scan", "deepsec"],
  "models": {
    "cheap": {
      "gatewayId": "zai/glm-5.3-flash",
      "agent": "pi",
      "model": "zai/glm-5.3-flash",
      "reasoning": "high"
    },
    "frontierSource": "https://vercel.com/ai-gateway/leaderboards/deepsecbench/results.json",
    "frontierTopN": 3,
    "pricingSource": "https://ai-gateway.vercel.sh/v1/models"
  },
  "billing": {
    "route": "ai-gateway",
    "hardCap": true,
    "monthlyCapUsd": 200,
    "runCapUsd": { "pr": 2, "weekly": 15, "frontier": 75 },
    "minRunUsd": 0.25,
    "costSafetyFactor": 1.75,
    "prMaxFiles": 40,
    "maxNewIssuesPerRun": 25,
    "onUnknownPrice": "skip",
    "onCapReached": "stop-partial"
  },
  "execution": {
    "status": "advisory",
    "blocking": false,
    "workspace": "fresh-temp",
    "dotenv": false,
    "prSources": "same-repo-only",
    "prCodeExecution": "none",
    "rejectEnv": [
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_AUTH_TOKEN",
      "VERCEL_OIDC_TOKEN",
      "VERCEL_TOKEN",
      "OPENAI_BASE_URL",
      "ANTHROPIC_BASE_URL",
      "NODE_OPTIONS",
      "NODE_PATH",
      "DEEPSEC_INSIDE_SANDBOX"
    ],
    "triage": false,
    "sourceWriteAccess": "ephemeral-runner-only"
  }
}
