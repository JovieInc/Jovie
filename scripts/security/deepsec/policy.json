{
  "schemaVersion": 1,
  "projectId": "jovie",
  "maxTargets": 9,
  "sourceExtensions": [".ts"],
  "excludedPathSegments": [
    ".git",
    ".deepsec",
    ".agents",
    ".claude",
    ".codex",
    "node_modules",
    "vendor",
    "dist",
    "build",
    ".next",
    ".vercel",
    "coverage",
    "generated",
    "fixtures",
    "__fixtures__"
  ],
  "modelAuth": "local",
  "agent": "codex",
  "model": "gpt-5.5",
  "providerFallback": false,
  "billing": {
    "route": "prepaid-codex-subscription",
    "dollarBudgetUsd": null,
    "hardCap": false,
    "stopOnExhaustion": true
  },
  "execution": {
    "status": "disabled",
    "scanEnabled": false,
    "workspace": "fresh-temp",
    "dotenv": false,
    "envAllowlist": [
      "HOME",
      "PATH",
      "TMPDIR",
      "LANG",
      "LC_ALL",
      "RUNNER_TEMP",
      "DEEPSEC_DATA_ROOT",
      "DEEPSEC_SOURCE_ROOT"
    ],
    "rejectEnv": [
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_AUTH_TOKEN",
      "AI_GATEWAY_API_KEY",
      "VERCEL_OIDC_TOKEN",
      "VERCEL_TOKEN",
      "VERCEL_TEAM_ID",
      "VERCEL_PROJECT_ID",
      "OPENAI_BASE_URL",
      "ANTHROPIC_BASE_URL",
      "NODE_OPTIONS",
      "NODE_PATH",
      "DEEPSEC_INSIDE_SANDBOX"
    ],
    "requireCodexSubscriptionProof": true,
    "requireCodexExecutableProvenance": true,
    "requirePinnedBundledCodexPathProof": true,
    "rejectPathWrapperQualification": true,
    "requireCodexVersionAndSha256Proof": true,
    "requireSpawnedCodexArgvProof": true,
    "onCodexProofFailure": "hold",
    "requireSourceWriteDenialProof": true,
    "localIsolationProofRequired": true,
    "requireRunScopedTempPaths": true,
    "requireAuthReadIsolationProof": true,
    "requireAuthFileReadIsolationProof": true,
    "requireSnapshotContentGate": true,
    "onProofFailure": "hold",
    "sandbox": false,
    "network": "codex-subscription-only",
    "toolNetwork": "disabled",
    "triage": false,
    "sourceWriteAccess": "denied",
    "allowPathFallback": false
  }
}
