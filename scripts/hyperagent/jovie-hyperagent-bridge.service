[Unit]
Description=Jovie mesh board bridge to Hyperagent (canon MESH-SWARM.md)
After=network-online.target
StartLimitIntervalSec=0

[Service]
Environment=HYPERAGENT_BIN=%h/.jovie/mesh/hyperagent-bridge/lib/jovie-hyperagent/hyperagent.py
Environment=HYPERAGENT_MODEL=fable-5.1
ExecStart=/usr/bin/doppler run --project agent-mesh --config prd --no-fallback -- /usr/bin/python3 %h/.jovie/mesh/hyperagent-bridge/hyperagent-bridge.py
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
