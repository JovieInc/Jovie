    "summer-planner": {
      "kind": "capacity-role",
      "role": "planner"
    },
    "drafting-terra": {
      "kind": "capacity-family",
      "family": "openai:terra"
    },
    "drafting-sol": {
      "kind": "capacity-family",
      "family": "openai:sol"
    },
    "judge-screen": {
      "kind": "judge-tier",
      "tier": "screen"
    },
    "judge-confirm": {
      "kind": "judge-tier",
      "tier": "confirm"
    }
  },
