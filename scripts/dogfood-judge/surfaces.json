      "name": "PITCH_MODEL"
    },
    "title": {
      "kind": "ts-const",
      "file": "apps/web/lib/constants/ai-models.ts",
      "name": "TITLE_MODEL"
    },
    "album-art": {
      "kind": "ts-const",
      "file": "apps/web/lib/constants/ai-models.ts",
      "name": "ALBUM_ART_GATEWAY_IMAGE_MODEL"
