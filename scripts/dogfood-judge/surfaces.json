{
  "schema": "jovie.dogfood-judge-surfaces/v1",
  "description": "Inventory of surfaces the LLM dogfood judge watches. Coverage = surfaces with a current passing receipt / all surfaces here. Summer owns the expansion queue: when every judged surface is green, the next queued surface by ROI score is promoted (node scripts/dogfood-judge/cli.mjs coverage --next). Model bindings name where each surface's model id lives so a model change invalidates exactly the receipts it affects.",
  "judge": {
    "tiers": {
      "screen": "claude-sonnet-5-5",
      "confirm": "claude-opus-5-5"
    },
    "transport": "claude CLI (subscription lane); no gateway or raw API key path",
    "maxReceiptAgeDays": 7
  },
  "roiWeights": {
    "goldenPath": 30,
    "revenue": 2,
    "traffic": 1
  },
  "bindingSources": {
    "chat": {
      "kind": "ts-const",
      "file": "apps/web/lib/constants/ai-models.ts",
      "name": "CHAT_MODEL"
    },
    "chat-light": {
      "kind": "ts-const",
      "file": "apps/web/lib/constants/ai-models.ts",
      "name": "CHAT_MODEL_LIGHT"
    },
    "insight": {
      "kind": "ts-const",
      "file": "apps/web/lib/constants/ai-models.ts",
      "name": "INSIGHT_MODEL"
    },
    "pitch": {
      "kind": "ts-const",
