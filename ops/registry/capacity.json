{
  "schema": "jovie.capacity-registry/v1",
  "description": "Agent capacity facts in one place: per provider and account, the plan and price (promo and until when), usage model, last-known remaining quota or credits with source and timestamp, and the policy and delegation cost rules agents follow. Metadata only: accounts are an id plus a 12-hex email hash, never a secret. Joins canon/agent-identities.json (agents) and ops/registry/spend.json (spendIds, credits.spendId). Live overlay: scripts/lanes/capacity_live.py. Generated view: canon/CAPACITY.md.",
  "updatedAt": "2026-10-25T01:30:00Z",
  "thresholds": {
    "liveMaxAgeHours": 24,
    "manualMaxAgeDays": 8,
    "routingMaxAgeMinutes": 120
  },
  "policies": {
    "preserve-shared-pool": {
      "paceRouting": "back-off-when-ahead",
      "rule": "Shared pool: lanes lease one account per run. Do not delegate work that can run on an uncapped own model. Below 30% weekly remaining on the pool, send non-lane agents only Codex-free work."
    },
    "burn-before-reset": {
      "paceRouting": "free-when-behind",
      "rule": "Capped quota: spend it fully before each reset; unused quota at reset is lost. Route eligible work here first while under pace."
    },
    "use-full-quota": {
      "paceRouting": "free-when-behind",
      "rule": "Promo-priced plan: use the whole quota every week; the discount ends in December 2026."
    },
    "uncapped-own-model": {
      "rule": "No usage cap on the agent's own model; use it first. Delegating to another provider spends that provider's quota."
    },
    "spend-credits-before-expiry": {
      "rule": "Given credits, not bought: spend them before they expire, paced to balance divided by days left, within the per-run and per-turn caps."
    },
    "pay-as-you-go": {
      "rule": "Real cash or prepaid credit: cheapest model that clears the capability floor; honour the caps in the spend registry."
    },
    "preserve-frontier": {
      "rule": "Subscription capacity for frontier work only (money and auth critical); cheaper lanes take the rest."
    },
    "unavailable": {
      "rule": "Not routable: lane disabled, plan lapsed or unverified. Do not route work here."
    }
  },
