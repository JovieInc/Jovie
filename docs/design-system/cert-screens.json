      "page": "apps/web/app/claim/page.tsx",
      "route": "/claim",
      "stage": "claim"
    },
    "onboarding/start": {
      "page": "apps/web/app/(dynamic)/start/page.tsx",
      "route": "/start",
      "stage": "start"
    },
    "chat/app-chat": {
      "page": "apps/web/app/app/(shell)/chat/page.tsx",
      "route": "/app/chat",
      "stage": "chat"
    },
    "public-profile/profile": {
      "page": "apps/web/app/[username]/page.tsx",
      "route": "/tim",
      "stage": "reach"
    },
    "smartlink/release": {
      "page": "apps/web/app/[username]/[slug]/page.tsx",
      "route": "/tim/release",
      "stage": "reach"
    },
    "checkout/pricing": {
      "page": "apps/web/app/(marketing)/pricing/page.tsx",
      "route": "/pricing",
      "stage": "paid"
