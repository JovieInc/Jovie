{
  "schema": "jovie.cert-screens/v1",
  "note": "Every component a listed screen's page can render must pass these criteria. debt holds what failed when a screen was enrolled; it only shrinks. Enroll and refresh with scripts/component-cert-screens.mjs, never by hand. Golden Path screens come from docs/pen-stills/golden-path/manifest.json.",
  "criteria": [
    "ds-owner",
    "tokens",
    "states",
    "tests",
    "a11y",
    "frontend-rules",
    "forced-caps"
  ],
  "screens": {
    "landing/homepage": {
      "page": "apps/web/app/(home)/page.tsx",
      "route": "/",
      "stage": "reach"
    },
    "signup-signin/signin": {
      "page": "apps/web/app/(auth)/signin/page.tsx",
      "route": "/signin",
      "stage": "start"
    },
    "signup-signin/request-access": {
      "page": "apps/web/app/waitlist/page.tsx",
      "route": "/waitlist",
      "stage": "waitlist"
    },
    "claim/claim": {
      "page": "apps/web/app/claim/page.tsx",
      "route": "/claim",
      "stage": "claim"
    },
    "onboarding/start": {
      "page": "apps/web/app/(dynamic)/start/page.tsx",
      "route": "/start",
      "stage": "start"
    },
    "chat/app-chat": {
      "page": "apps/web/app/app/(shell)/chat/page.tsx",
      "route": "/app/chat",
      "stage": "chat"
    },
    "public-profile/profile": {
      "page": "apps/web/app/[username]/page.tsx",
      "route": "/tim",
      "stage": "reach"
    },
    "smartlink/release": {
      "page": "apps/web/app/[username]/[slug]/page.tsx",
      "route": "/tim/release",
      "stage": "reach"
    },
    "checkout/pricing": {
      "page": "apps/web/app/(marketing)/pricing/page.tsx",
      "route": "/pricing",
      "stage": "paid"
    },
    "checkout/billing-success": {
      "page": "apps/web/app/billing/success/page.tsx",
      "route": "/billing/success",
      "stage": "paid"
    }
  },
  "debt": {
    "apps/web/app/app/(shell)/chat/ChatEntityRightPanelHost.tsx": "a11y,ds-owner,states,tests",
    "apps/web/app/app/(shell)/chat/ChatPageClient.tsx": "a11y,states,tests",
    "apps/web/app/r/[slug]/ReleaseLandingPage.tsx": "a11y,ds-owner,states,tests,tokens",
    "apps/web/components/atoms/JovieMarkElectric.tsx": "a11y,states,tokens",
    "apps/web/components/features/dashboard/organisms/profile-contact-sidebar/ProfileAboutTab.tsx": "a11y,ds-owner,frontend-rules,states,tests,tokens",
    "apps/web/components/features/dashboard/organisms/profile-contact-sidebar/SuggestedDspMatches.tsx": "a11y,ds-owner,frontend-rules,states,tests",
    "apps/web/components/features/profile/artist-notifications-cta/ProfileInlineNotificationsCTA.tsx": "a11y,ds-owner,states,tests,tokens",
    "apps/web/components/features/profile/artist-notifications-cta/ProfileMobileNotificationsFlow.tsx": "a11y,ds-owner,frontend-rules,states,tests,tokens",
    "apps/web/components/features/profile/artist-notifications-cta/shared.tsx": "a11y,ds-owner,frontend-rules,states,tests,tokens",
    "apps/web/components/features/profile/pac/ProfilePacCard.tsx": "a11y,ds-owner,frontend-rules,states,tests,tokens",
    "apps/web/components/features/profile/templates/ProfileDesktopSurface.tsx": "a11y,ds-owner,states,tokens",
    "apps/web/components/features/profile/views/ReleasesView.tsx": "a11y,frontend-rules,states,tests,tokens",
    "apps/web/components/jovie/JovieChat.tsx": "a11y,ds-owner,frontend-rules,states,tests",
    "apps/web/components/jovie/components/ChatInput.tsx": "a11y,ds-owner,frontend-rules,states,tests",
    "apps/web/components/molecules/drawer/SidebarLinkRow.tsx": "states,tokens",
    "apps/web/components/organisms/CmdKPalette.tsx": "a11y,ds-owner,frontend-rules,states",
    "apps/web/components/organisms/UnifiedSidebar.tsx": "a11y,ds-owner,states,tests"
  }
}
