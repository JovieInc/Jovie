  "waivers": {
    "apps/web/components/jovie/components/ChatComposerToolbar.tsx": {
      "long-content": "The toolbar renders icon-only controls with fixed aria labels and takes no user text, so no content can overflow."
    },
    "apps/web/components/jovie/components/ChatPitchCard.tsx": {
      "offline": "No offline UI exists: the card never fetches, and its only async call is navigator.clipboard.writeText, whose rejection takes the toast.error('Failed to copy') path covered by ChatPitchCard.test.tsx."
    },
    "apps/web/components/jovie/components/SuggestedPrompts.tsx": {
      "empty": "The component always appends the static feedback pill unless featuredOnly is set, and featured skills are a fixed list, so no reachable input renders an empty list.",
      "offline": "No offline UI exists: the pills render static copy and the only async work is the analytics track() call, which fails silently."
    },
    "apps/web/components/jovie/components/picker-rows.tsx": {
      "empty": "PickerRow renders exactly one row for one item and no collection; the empty list state belongs to the palette that maps over items.",
      "permission-denied": "No permission-gated UI exists: a row only renders the item and callbacks it is given."
    },
    "apps/web/components/molecules/OptimizedImage.tsx": {
      "offline": "No offline UI exists: the component never fetches itself, and an image that cannot load takes the onError fallback covered by OptimizedImage.test.tsx."
    },
    "apps/web/components/molecules/WrappedSocialLink.tsx": {
      "empty": "The component renders one link and no collection, so there is no empty state.",
      "offline": "No offline UI exists: the wrap request failing offline takes the onError branch that falls back to the original URL, which WrappedSocialLink.test.tsx covers."
    },
    "apps/web/components/organisms/billing/PlanComparisonSection.tsx": {
      "long-content": "Plan names, taglines and features come from the fixed PLAN_FEATURES registry, so no user-supplied content can overflow the cards."
    }
  }
