{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": [
    "files",
    "exports",
    "types",
    "nsExports",
    "nsTypes",
    "enumMembers",
    "duplicates",
    "unlisted",
    "binaries",
    "unresolved"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,mjs}"]
    },
    "apps/web": {
      "entry": [
        "instrumentation.{ts,js}",
        "next.config.{js,ts}",
        "sentry.*.config.ts",
        "scripts/**/*.{ts,mjs,js}"
      ],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,css,mdx}"],
      "ignore": [
        ".next/**",
        "drizzle/migrations/**",
        "drizzle.config.ts",
        ".storybook/**",
        "lib/db/schema/**"
      ],
      "ignoreDependencies": [
        "@radix-ui/react-avatar",
        "@radix-ui/react-toggle",
        "@radix-ui/react-toggle-group",
        "@opentelemetry/sdk-trace-base",
        "@sentry/node"
      ],
      "playwright": {
        "config": [
          "playwright.config.ts",
          "playwright.synthetic.config.ts",
          "playwright.config.nightly.ts",
          "playwright.config.noauth.ts",
          "playwright.config.headed.ts"
        ],
        "entry": ["tests/e2e/**/*.spec.ts"]
      },
      "storybook": {
        "config": [".storybook/main.ts"],
        "entry": ["**/*.stories.{ts,tsx}"]
      },
      "vitest": {
        "config": [
          "vitest.config.mts",
          "vitest.config.ci.mts",
          "vitest.config.fast.mts",
          "vitest.config.minimal.mts",
          "vitest.config.mjs"
        ],
        "entry": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}"]
      },
      "next": {
        "entry": ["next.config.{js,ts}", "instrumentation.{ts,js}"]
      },
      "eslint": {
        "config": ["eslint.config.js", "eslint-server-boundaries.config.js"]
      },
      "drizzle": false
    },
    "apps/desktop": {
      "entry": ["src/**/*.ts", "scripts/**/*.{js,mjs,cjs}"],
      "project": ["src/**/*.ts", "scripts/**/*.{js,mjs,cjs}"]
    },
    "apps/should-i-make": {
      "entry": ["next.config.{js,ts}"],
      "project": ["**/*.{ts,tsx,js,jsx,css}"],
      "ignore": [".next/**"],
      "ignoreDependencies": ["@fontsource-variable/inter"],
      "next": {
        "entry": ["next.config.{js,ts}"]
      }
    },
    "packages/ui": {
      "entry": ["atoms/*.{ts,tsx}", "lib/*.ts", "theme/*.ts"],
      "project": ["**/*.{ts,tsx}"],
      "vitest": {
        "config": ["vitest.config.mts"],
        "entry": ["**/*.test.{ts,tsx}"]
      }
    },
    "apps/ovie": {
      "ignoreDependencies": [
        "@jovie/ui",
        "@jovie/web",
        "@statsig/statsig-node-core",
        "server-only",
        "tailwindcss",
        "tw-animate-css"
      ]
    }
  }
}
