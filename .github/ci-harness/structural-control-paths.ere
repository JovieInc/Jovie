# Paths whose change runs the ci-fast structural control lane on source PRs.
# One ERE alternative per line; blank lines and # comments are ignored.
# Read by the "Decide structural lane" step in .github/workflows/ci.yml, which
# joins the lines with | and appends the invariant scan roots (JOV-6837).
# One alternative per line keeps concurrent additions from conflicting.

^scripts/lib/(rolling-ci-failure-disposition\.mjs$|__tests__/rolling-ci-failure-disposition\.test\.mjs$)
^scripts/(hooks/pre-push-gate\.sh$|security/scan-secrets\.sh$|lib/__tests__/pre-push-gate\.test\.mjs$)
^apps/web/(app/api/internal/ovie/summer-bottleneck/|lib/ovie/summer-admissions\.ts$)
^packages/agent-transport-contracts/
^scripts/lib/__tests__/symphony-health-contract\.test\.mjs$
^\.github/
^\.claude/rules/(ci-branching|release|testing|gstack)\.md
^AGENTS\.md
^CODEX\.md
^canon/invariants\.jsonl
^apps/web/scripts/optical-grid-scanners\.ts$
^scripts/invariants/
^scripts/verification/
^scripts/automation-verify\.sh$
^scripts/run-affected-tests\.mjs$
^scripts/backlog-orchestrator/(admission-gate|context-gate|deterministic-gates|gbrain-client|gate-next-hold|shipping-lead-gate|summer-shipping-lead-contract|ownership-inventory|symphony-(routing|official-runtime))
^scripts/backlog-orchestrator/__tests__/(backlog-orchestrator|pre-lease-gates|gate-next-hold|shipping-lead-gate|summer-shipping-lead-contract|ownership-inventory|symphony-(routing|official-runtime))\.test\.mjs$
^scripts/doc-freshness-lint
^scripts/(drain-pr-queue\.sh|drain-pr-remediate\.mjs|merge-queue-backend\.mjs|ownerless-recovery-sweeper\.mjs)
^scripts/lib/(ci-|merge-queue|ownerless-recovery-policy|pr-check-failures|pre-land-changelog|resolve-merge-group-path-diff|upsert-pr-comment|product-lane-(classifier|finalize)|production-lane-range)
^scripts/lib/__tests__/(automation-verify|ci-fast-workflow-contract|gbrain-runtime-assets|merge-group-workflow-contract|production-release-supersession|merge-queue-backend|merge-queue-guard|ownerless-recovery-policy|pre-land-changelog|pr-check-failures|product-lane-classifier|production-lane-range)\.test\.mjs
^scripts/ci-
^scripts/brand-scrub\.py
^scripts/lanes/
^scripts/fleet-gate/
^scripts/tests/test_(lane_runner|agent_workflow_hygiene|brand_scrub|gh_retry|runner_routing|vercel_prebuilt_deploy)\.py

# Typed company composition must run its real coverage gate on future edits too.
^scripts/security/deepsec-(policy|loop|run)(\.test)?\.mjs$
^scripts/security/deepsec/
^scripts/summer-commissioning/

# Evidence collection changes must execute the existing native-queue
# behavioral tests and per-file coverage, including test-only edits.
^scripts/native-queue-eval\.mjs$
^scripts/lib/native-queue-(eval|group-evidence|policy-evidence)\.mjs$
^scripts/lib/__tests__/native-queue-(collector|eval|group-evidence|policy-evidence)\.test\.mjs$

# FX remediation policy, dispatcher, and finisher must run their real
# per-file coverage suite when the implementation or tests change.
^scripts/lib/(fx-remediation-lane|rolling-ci-dispatch|rolling-ci-fx(-finish)?)\.mjs$
^scripts/lib/__tests__/(fx-remediation-lane|rolling-ci-dispatch|rolling-ci-fx(-finish)?)\.test\.mjs$

# Conflict event policy, entrypoint, and proof changes always run the
# existing structural control selector with exact-path coverage.
^scripts/pr-conflict-handler\.mjs$
^scripts/lib/(pr-conflict-(handler|event)|github-open-prs-rest)\.mjs$
^scripts/lib/__tests__/(pr-conflict-(handler|event)|github-open-prs-rest)\.test\.mjs$

# Inputs apps/web/tests/unit/ci reads beyond .github/: web Unit Tests
# skip PRs, so these contracts run here (#18718).
^(\.env\.example|\.nvmrc|config/node-runtime-policy\.json|docs/REPO-POLICY\.md|scripts/(ci/|node-runtime-policy\.mjs$|lib/playwright-png\.mjs$)|apps/web/(next\.config\.js|vercel\.json|vitest\.config[^/]*\.mts|playwright[^/]*\.config[^/]*\.ts)$)
