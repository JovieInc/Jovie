# Engineering wins ledger. One JSON object per line (jovie.win/v1). Validate: node scripts/wins-ledger.mjs validate. Never hand-edit statuses; they are computed from receipts.
{"schema":"jovie.win/v1","id":"win-2026-10-29-release-starvation-fix","date":"2026-10-29","area":"release","theme":"release-reliability","claim":"Non-Web builds no longer yield to an unfinished main, so production keeps shipping under constant merges.","prs":[{"repo":"JovieInc/Jovie","number":23603,"mergedAt":"2026-10-29T07:56:11Z"}],"metrics":[{"name":"Production deploys in a simulated 12 h merge stream","unit":"deploys","better":"higher","before":0,"after":29,"source":"staging-supersession-policy.test.mjs starvation contract","query":"node --test .github/scripts/staging-supersession-policy.test.mjs"},{"name":"Longest gap between production deploys (simulated)","unit":"min","better":"lower","before":720,"after":67,"source":"staging-supersession-policy.test.mjs starvation contract","query":"node --test .github/scripts/staging-supersession-policy.test.mjs"}],"story":"Merges landed about every 8 minutes and a CI run took 15 or more, so main had always moved by the time a non-Web build finished. Each finished build yielded to a newer one that had not finished either, and production stayed on an old commit for hours. The release controller now yields only to a successor that has passed CI or staging.","verifyLink":"https://github.com/JovieInc/Jovie/pull/23603","receipts":[],"notes":"Numbers are from a deterministic simulation (12 h stream, merges every 6 min, 16 min CI), not production. Not re-measured on production yet."}
{"schema":"jovie.win/v1","id":"win-2026-10-29-merge-gate-runner-pool","date":"2026-10-29","area":"queue","theme":"merge-throughput","claim":"Merge-group gate jobs moved to a fixed self-hosted pool so they stop queueing behind PR CI.","prs":[{"repo":"JovieInc/Jovie","number":23586,"mergedAt":"2026-10-29T14:22:48Z"}],"metrics":[{"name":"Merge-group gate job start wait p50","unit":"s","better":"lower","before":141,"after":null,"source":"gh api actions/runs/ID/jobs (started_at - created_at)","query":"gh api repos/JovieInc/Jovie/actions/runs/<merge_group run>/jobs"}],"story":"Required merge-group checks waited a median of 141 seconds for a hosted runner while the same jobs ran in seconds once started. The light gate jobs now run on a fixed pool.","verifyLink":"https://github.com/JovieInc/Jovie/pull/23586","receipts":[{"metric":"Merge-group gate job start wait p50","value":116.5,"at":"2026-10-29T16:50:00Z","evidence":"https://github.com/JovieInc/Jovie/pull/23586#ledger-recheck","sha":null,"note":"n=60 jobs on gem-linux* from merge_group runs after 14:25Z, p95 439 s. The pool was saturated, so the gain did not hold."}],"notes":"The task brief cited 3 s p50 after the change; no PR or metric source for that figure was found, so it is not recorded."}
{"schema":"jovie.win/v1","id":"win-2026-10-29-auto-requeue-dropped-green-prs","date":"2026-10-29","area":"queue","theme":"merge-throughput","claim":"Green PRs that GitHub dropped on a flaky merge group are re-enqueued automatically.","prs":[{"repo":"JovieInc/Jovie","number":23655,"mergedAt":"2026-10-29T17:09:57Z"}],"metrics":[{"name":"Re-queue lag after a flaky merge-group drop (max seen)","unit":"min","better":"lower","before":24,"after":null,"source":"queue-timings dequeues block","query":"scripts/lanes/queue_timings dequeues.autoRequeues"}],"story":"A flaky merge-group failure with no implicated path left the green PR dropped until the next push to main, up to 24 minutes.","verifyLink":"https://github.com/JovieInc/Jovie/pull/23655","receipts":[],"notes":"PR open at ledger time."}
{"schema":"jovie.win/v1","id":"win-2026-10-29-preflight-ci-parity","date":"2026-10-29","area":"ci","theme":"merge-throughput","claim":"Local preflight now covers the checks that cost one PR four CI rounds, and a ratchet keeps it in step with CI.","prs":[{"repo":"JovieInc/Jovie","number":23657,"mergedAt":null}],"metrics":[{"name":"CI rounds on the PR that exposed the gaps","unit":"rounds","better":"lower","before":4,"after":null,"source":"PR 23573 history","query":"gh pr view 23573 --json statusCheckRollup"}],"story":"Four separate CI failures passed local preflight: generator drift, second-order drift, changed-line coverage and a design guard narrowed to four tests.","verifyLink":"https://github.com/JovieInc/Jovie/pull/23657","receipts":[],"notes":"PR open at ledger time."}
{"schema":"jovie.win/v1","id":"win-2026-10-29-repo-size-headroom","date":"2026-10-29","area":"repo","theme":"merge-throughput","claim":"Tracked repo size dropped by 10.29 MiB by deleting dead migration snapshots instead of raising the budget.","prs":[{"repo":"JovieInc/Jovie","number":23653,"mergedAt":"2026-10-29T17:09:57Z"}],"metrics":[{"name":"Tracked repo size","unit":"MiB","better":"lower","before":197.49,"after":187.19,"source":"scripts/repo-hygiene-guard.mjs","query":"node scripts/repo-hygiene-guard.mjs"}],"story":"The repo was 197.49 MiB against a 198 MiB budget, so any PR adding files would fail.","verifyLink":"https://github.com/JovieInc/Jovie/pull/23653","receipts":[],"notes":"PR open at ledger time."}
{"schema":"jovie.win/v1","id":"win-2026-10-29-sparse-checkout-reset","date":"2026-10-29","area":"ci","theme":"release-reliability","claim":"Fixed-pool runners reset stale sparse checkouts, ending Production Controller exit-127 failures.","prs":[{"repo":"JovieInc/Jovie","number":23648,"mergedAt":"2026-10-29T15:32:41Z"},{"repo":"JovieInc/Jovie","number":23656,"mergedAt":null}],"metrics":[],"story":"Putting gate jobs on a shared workspace left a sparse checkout behind, and the next full checkout failed with a missing script. Every pooled job now resets sparse state first.","verifyLink":"https://github.com/JovieInc/Jovie/pull/23648","receipts":[],"notes":"No before/after number in either PR body; MTTR not measured. #23656 open at ledger time."}
{"schema":"jovie.win/v1","id":"win-2026-10-29-summer-triage-low-effort","date":"2026-10-29","area":"summer","theme":"ai-quality","claim":"Summer triage calls use low reasoning effort so the model stops spending its output cap on thinking.","prs":[{"repo":"JovieInc/summer-config","number":357,"mergedAt":"2026-10-29T05:58:33Z"},{"repo":"JovieInc/summer-config","number":363,"mergedAt":"2026-10-29T07:06:24Z"}],"metrics":[],"story":"The model returned an empty answer after spending its whole output cap on reasoning. One shared client now defaults every call to low effort.","verifyLink":"https://github.com/JovieInc/summer-config/pull/363","receipts":[],"notes":"Private repo; no before/after number in the PR bodies. Not linkable in public copy."}
{"schema":"jovie.win/v1","id":"win-2026-10-29-helpfulness-score","date":"2026-10-29","area":"ai","theme":"ai-quality","claim":"Jovie's helpfulness eval score rose from 43 to 85 after fixing reply persistence and time awareness.","prs":[{"repo":"JovieInc/Jovie","number":23550,"mergedAt":"2026-10-29T05:50:44Z"},{"repo":"JovieInc/Jovie","number":23552,"mergedAt":"2026-10-29T07:34:03Z"},{"repo":"JovieInc/Jovie","number":23556,"mergedAt":"2026-10-29T07:36:16Z"}],"metrics":[{"name":"Helpfulness eval score (25 cases)","unit":"points","better":"higher","before":43,"after":85,"source":"apps/web/tests/eval/helpfulness/run.ts","query":"pnpm --filter @jovie/web eval:helpfulness"},{"name":"Eval pass rate","unit":"%","better":"higher","before":8,"after":80,"source":"apps/web/tests/eval/helpfulness/run.ts","query":"pnpm --filter @jovie/web eval:helpfulness"}],"story":"24 of 25 replies were stored as a fallback because the model wrote em dashes, and the prompt carried no date, so an upcoming single read as already released. A deterministic repair, a date line and a one-next-step rule fixed both.","verifyLink":"https://github.com/JovieInc/Jovie/pull/23552","receipts":[],"notes":"Eval runs were taken on the branch before merge; not re-run after deploy."}
{"schema":"jovie.win/v1","id":"win-2026-10-29-prod-golden-path-cert","date":"2026-10-29","area":"release","theme":"release-reliability","claim":"Every verified production promotion is now certified against the golden path, 8 of 8 surfaces.","prs":[{"repo":"JovieInc/Jovie","number":23495,"mergedAt":"2026-10-29T03:44:23Z"},{"repo":"JovieInc/Jovie","number":23627,"mergedAt":"2026-10-29T12:02:08Z"}],"metrics":[{"name":"Golden-path surfaces certified on the served production commit","unit":"surfaces","better":"higher","before":0,"after":8,"source":"postdeploy-probes Golden Path Certification job","query":"gh run view <postdeploy-probes run> --log | grep certified"}],"story":"Nothing certified the authenticated golden path on production. Receipts sat on an older commit while another was served. Certification now runs after each Production Verified and reports one verdict.","verifyLink":"https://github.com/JovieInc/Jovie/actions/runs/40913733980","receipts":[{"metric":"Golden-path surfaces certified on the served production commit","value":8,"at":"2026-10-29T16:43:43Z","evidence":"https://github.com/JovieInc/Jovie/actions/runs/40913733980","sha":"1c2b4345087193392aa517e7d1aceacb5f8d5434","note":"Log: certified: all surfaces passed on the served SHA."}],"notes":null}
{"schema":"jovie.win/v1","id":"win-2026-10-29-model-registry-single-source","date":"2026-10-29","area":"ci","theme":"source-of-truth","claim":"OpenAI model ids live in one registry with a daily sync and a CI guard against new hardcoded ids.","prs":[{"repo":"JovieInc/Jovie","number":23619,"mergedAt":"2026-10-29T13:35:20Z"}],"metrics":[],"story":"Model ids were copied across capacity pricing, lane routing and app constants. One registry now feeds them and a shrink-only ratchet blocks new hardcoded ids.","verifyLink":"https://github.com/JovieInc/Jovie/pull/23619","receipts":[],"notes":"12 grandfathered sites; no before count recorded, so no measurable gain."}
