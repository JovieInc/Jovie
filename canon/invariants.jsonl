{"id":"JOV-INV-012","title":"User-facing outputs require an optimization contract","statement":"Every shipped user-facing page, link, asset, campaign, recommendation, or content variant has a complete optimization contract on existing analytics surfaces; non-product or non-optimizable work must declare a justified exception instead of omitting the contract.","scope":{"products":["Jovie"],"surfaces":["product-canon","plan-gate","implementation-prompt","analytics"]},"authority":{"owner":"Product","approvedBy":"Founder"},"effective":{"date":"2026-08-28","version":1},"precedence":1000,"policy":{"key":"product.optimization.contract","value":{"userFacingOutputsRequireContract":true,"allowedExceptions":["non-product","non-optimizable"],"exceptionRequiresJustification":true,"telemetrySurfaces":["analytics","model-experiments","audience-events","youtube-experiments","release-to-revenue"],"parallelAnalyticsStack":false,"learningHierarchy":["platform","medium-or-channel","country-or-locale","genre-or-cohort","artist-plus-career-era-or-lifecycle","content-variant","consented-audience-segment","fan"],"broaderEvidenceIsPriorOnly":true,"objectives":{"primary":["artist-business-outcome","durable-fan-value"],"intermediate":["engagement"],"guardrails":["complaint","trust","brand"]},"autoPromote":"bounded-reversible-after-evidence","gated":["identity-or-brand-permanence","legal-or-privacy","external-publication","material-spend"]}},"enforcementConsumers":[{"name":"Optimization contract validator","path":"scripts/invariants/optimization-contract.mjs"},{"name":"Plan-gate receipt","path":"scripts/backlog-orchestrator/plan-gate.mjs"},{"name":"Fallback implementation prompt","path":"scripts/hermes/grok-ship-one"},{"name":"Codex implementation prompt","path":"scripts/hermes/lib/codex-issue-shipper.ts"}],"evidence":{"tests":[{"path":"scripts/invariants/optimization-contract.test.mjs","name":"accepts a complete product optimization contract"},{"path":"scripts/invariants/optimization-contract.