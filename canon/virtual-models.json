  "views": ["portrait", "three-quarter", "full-body-front", "profile"],
  "castingBoard": {
    "status": "recertified",
    "recertifiedAt": "2026-09-29",
    "compCard": {
      "background": "neutral seamless or simple low-detail studio wall",
      "lighting": "controlled soft studio light with consistent exposure and white balance",
      "styling": "minimal; no editorial concept or scene storytelling",
      "wardrobe": "simple fitted solids with a clean silhouette and no distracting branding",
      "grooming": "clean and consistent across every view",
      "framing": [
        {
          "view": "portrait",
          "requirement": "straight or slight three-quarter head-and-shoulders portrait with the complete head in frame"
        },
        {
          "view": "three-quarter",
          "requirement": "head through mid-thigh with neutral posture and the complete head in frame"
        },
        {
          "view": "full-body-front",
          "requirement": "complete head-to-toe front view with margin above the head and below both feet; never crop the head"
        },
        {
          "view": "profile",
          "requirement": "clean head-and-shoulders side profile with the complete head in frame"
        }
      ],
      "reject": [
        "street or editorial imagery",
        "environmental storytelling",
        "dramatic wardrobe, props, or lighting that drives selection",
        "cropped head or feet in the full-body view"
      ]
    },
    "selectionGates": [
      {
        "id": "premium-aspirational-quality",
        "independent": true,
        "requirement": "exceptional commercial presence, finish, and memorability at an extremely aspirational bar"
      },
      {
        "id": "icp-resonance",
        "independent": true,
        "requirement": "credible resonance with ambitious independent recording artists and creator-operators"
      }
    ],
    "similarityReview": {
      "method": "machine-assisted controlled-vocabulary Jaccard review followed by visual review",
      "axes": ["mouth", "face", "hair", "build", "presence"],
      "nearDuplicateThreshold": 0.6,
      "visualReview": "passed-with-required-modifications",
      "reviewedPairs": ["C05:C06"],
      "requirement": "reject sibling candidates even when only a combination of mouth, face, hair, build, and presence makes them feel duplicated"
    },
    "groupScenes": {
      "priority": ["icp-fit", "individual-distinguishability"],
      "allowedDifferentiators": [
        "mouth shape",
        "facial geometry",
        "hair silhouette",
        "build silhouette",
        "height",
        "posture",
        "expression",
        "wardrobe silhouette",
        "activity",
        "prop assignment",
        "camera blocking"
      ],
      "forbiddenDifferentiation": "Do not manufacture demographic variety or use protected characteristics as differentiation tokens.",
      "uniqueHighSignalStyling": [
        "hero hair silhouette",
        "hero wardrobe silhouette",
        "signature accessory",
        "high-salience prop",
        "accent placement"
      ]
    }
  },
  "generationPolicy": {
    "personaBriefOrder": "A complete persona brief must be approved before image generation or scene design.",
    "personaFields": [
      "role",
      "scene",
      "lifestyleContext",
      "aestheticVocabulary",
      "likelyEnvironment",
      "aspiration",
      "icpTags"
    ],
    "worldCoherence": {
      "requiredParts": [
        "character",
        "wardrobe",
        "environment",
        "props",
        "activity",
        "lighting"
      ],
      "requirement": "Every part must imply one specific, coherent world; a generic stock environment is rejected by default."
    },
    "nosePiercing": "No septum or bull-ring. If a nose piercing is justified, use one subtle side-nostril stud or ring.",
    "photography": {
      "qualityBar": "extremely aspirational premium commercial casting",
      "realismRule": "Realistic means physically credible, never average, ordinary, or under-cast.",
      "requirements": [
        "plausible camera position, focal length, perspective, and depth of field",
        "an identifiable motivated light source with coherent falloff and exposure",
        "material-specific texture, roughness, translucency, and specular response",
        "anatomically plausible pose, contact, weight, scale, and occlusion",
        "truthful skin texture and local specular response without plastic smoothing"
      ]
    },
    "compositePhysics": {
      "directionalCoherence": "gaze, pose, travel, gesture, props, fabric, and environmental motion must agree with the scene's declared vectors",
      "lightCoherence": "light direction, shadow direction and softness, color spill, reflections, and practical sources must describe one physically possible setup",
      "reflectionCoherence": "every visible reflection or highlight must resolve to a source with matching direction, color, intensity, and material response"
    }
  },
