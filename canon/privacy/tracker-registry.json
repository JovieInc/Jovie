      "policy_names": ["Instantly", "Leadsy"],
      "status": "disabled",
      "approved": "2026-10-31",
      "approved_by": "pre-existing; disabled fail-closed",
      "rationale": "Website visitor-identification pixel. Component returns null in all states. Visitor de-anonymisation is the highest-risk class; re-enabling needs counsel sign-off (open question in the counsel brief). CSP entries should be removed.",
      "code": ["apps/web/components/providers/InstantlyPixel.tsx"]
    },
    {
      "id": "qrserver",
      "category": "content",
      "products": ["jovie"],
      "hosts": ["api.qrserver.com"],
      "policy_names": ["goQR", "QR Server"],
      "status": "live",
      "approved": "2026-10-31",
      "approved_by": "retroactive registration 2026-10-31",
      "rationale": "QR code images on artist profiles. Sends the visitor IP and referrer to goQR.me. Prefer first-party QR generation (open follow-up)."
    },
    {
      "id": "stripe",
      "category": "processor",
