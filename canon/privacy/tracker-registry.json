      "policy_names": ["Google Analytics"],
      "status": "inactive",
      "approved": "2026-10-31",
      "approved_by": "pre-existing (JOV-3664)",
      "rationale": "gtag with Consent Mode in the root layout. Inactive in production (no measurement ID; no request observed 2026-10-31). Re-activating needs an input-page exclusion first: the root layout covers signin, signup and chat.",
      "code": ["apps/web/components/providers/GoogleAnalytics.tsx"]
    },
    {
      "id": "instantly-leadsy",
      "category": "pixel",
