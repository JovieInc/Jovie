{
  "schema": "jovie.tracker-registry/v1",
  "owner": "summer",
  "canon": "gbrain decisions/company/privacy-tracking-compliance-guidelines-2026-10-31",
  "notes": "Approved third parties a page may load, and the surfaces the privacy inventory crawls. Behaviour config: a new tracker, SDK, pixel or data flow needs an entry with a rationale before it ships. Categories: pixel (ads/retargeting), analytics (third-party measurement), replay (session replay), chat-widget, ads, processor (needed to deliver a feature, e.g. payments, bot checks, error reporting), content (images, audio, fonts, embeds). Pixel, analytics, replay, chat-widget and ads categories are banned on input pages.",
  "first_party_domains": ["jov.ie", "logyourbody.com"],
  "policies": {
    "jovie-privacy": "https://jov.ie/legal/privacy",
    "jovie-cookies": "https://jov.ie/legal/cookies",
    "lyb-privacy": "https://www.logyourbody.com/privacy"
  },
  "banned_claims": [
    "we (do not|don't|never) track",
    "no third[- ]party tracking scripts",
    "we never share",
    "we (do not|don't|never) share (your )?(data|information)",
    "never (sold|sell|selling)"
  ],
  "vendors": [
    {
      "id": "meta",
      "category": "pixel",
      "products": ["jovie"],
      "hosts": ["facebook.net", "facebook.com"],
      "policy_names": ["Meta", "Facebook"],
      "status": "live",
      "approved": "2026-10-31",
      "approved_by": "tim (privacy guideline 2026-10-31)",
      "rationale": "Browser Meta pixel on public artist profiles and approved editorial pages; builds the retargeting audience (JOV-5078). Opt-out model in the US, consent bar in EU/UK. Never on input pages.",
      "code": ["apps/web/components/features/tracking/MetaPixel.tsx"]
    },
    {
      "id": "google-analytics",
