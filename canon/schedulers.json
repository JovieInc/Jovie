{
  "schema": "jovie-shared-schedulers/v1",
  "_comment": "One shared scheduler per platform (Tim 2026-10-31, memory feedback_event_driven): N jobs polling on the same schedule become one job running N tasks; every check is event-driven unless no event exists, then a slow fail-safe. A live timer-driven entry in canon/automation-registry.jsonl declares clock.scheduler (an id below) and clock.whyNotEvent. `grandfathered` are timers that predate the rule; the list only shrinks (validateScheduling in scripts/lib/automation-registry.mjs).",
  "platforms": {
    "vercel": {
      "id": "vercel:frequent",
      "status": "live",
      "source": "apps/web/app/api/cron/frequent/route.ts",
      "how": "Add a sub-job to /api/cron/frequent (or daily-maintenance); do not add a vercel.json cron."
    },
    "gem": {
      "id": "gem:lanes-tick",
      "status": "live",
      "source": "scripts/lanes/install.sh",
      "how": "Add a task to the lanes tick or a Clock(...) row in scripts/lanes/continuity_clock.py; do not add a systemd timer."
    },
    "github": {
      "id": "github:production-continuity",
      "status": "live",
      "source": ".github/workflows/production-continuity.yml",
      "how": "Follow Production Continuity Guard with workflow_run (see automation-liveness.yml); do not add a schedule:."
    },
    "summer": {
      "id": "summer:heartbeat",
      "status": "live",
      "source": "JovieInc/summer-config apps/summer/agent/schedules/summer-heartbeat.ts",
      "how": "Add an event catch-up to the heartbeat; do not add an Eve schedule."
    },
    "mac": {
      "id": "mac:ops-tick",
      "status": "planned",
      "source": "scripts/capacity/install-launchd.sh",
      "how": "One launchd agent that runs registered tasks; until it lands, a new Mac timer must say why in clock.whyNotEvent."
    },
    "cloudflare": {
      "id": "cloudflare:cron-hub",
      "status": "planned",
      "source": "workers/cron-hub (not built)",
      "how": "One cron Worker that dispatches registered tasks; until it lands, a new Worker cron must say why in clock.whyNotEvent."
    }
  },
