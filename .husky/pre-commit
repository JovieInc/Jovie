#!/usr/bin/env sh
# Host-wide heavy-task semaphore (scripts/heavy-task.sh): lint-staged, eslint and the proxy guard of many
# concurrent agent commits took a shared host to load 43. Re-run this hook once under a slot; hosted CI skips it.
if [ -z "${HEAVY_TASK_HELD:-}" ] && [ -z "${CI:-}" ] && [ -f scripts/heavy-task.sh ]; then
  exec bash scripts/heavy-task.sh sh "$0" "$@"
fi
set -e  # Required: ensures check-conflict-markers.sh failure actually blocks commits
# Universal gate ladder (JOV-3210): conflict → secrets → proxy → lint.
# Source of truth: scripts/gate-ladder/ladder.json (`pnpm gate-ladder:validate`).
# Typecheck runs in CI (turbo typecheck --affected) per JOV-5058, not per commit.

bash scripts/check-conflict-markers.sh
bash scripts/security/scan-secrets.sh pre-commit
node scripts/repo-hygiene-guard.mjs --staged
pnpm run skill-governance:check -- --staged
pnpm run next:proxy-guard
pnpm exec lint-staged --no-stash

# Bind the final staged rule bodies to their reviewed integrity record.
if git diff --cached --name-only --diff-filter=ACMD | grep -qE '^\.claude/rules/.*\.md$|^scripts/agent-context/rule-scopes\.(json|mjs)$'; then
  node scripts/agent-context/rule-scopes.mjs --staged
fi

# iOS adapter: when Swift sources are staged, run the portable best-practices lint.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^apps/ios/.*\.swift$'; then
  echo "[gate-ladder] ios format-lint rung (staged Swift)"
  pnpm run ios:lint
fi
