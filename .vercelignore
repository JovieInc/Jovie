.cache/
**/.cache/
.next/
**/.next/
.turbo/
**/.turbo/
node_modules/
**/node_modules/
scripts/
*.mjs
*.cjs
cleanup_old_branches*.sh

# The docs project needs its Nextra wrapper to compile MDX app routes.
!apps/docs/next.config.mjs
# Docs prebuild (`scripts/validate-articles.mjs`) and the registry modules the
# app and next.config import. `scripts/` and `*.mjs` exclude them; un-ignore
# the directory before the files. Test modules and visual-proof-assets.mjs
# stay excluded — nothing in the docs build imports that audit helper.
!apps/docs/scripts/
!apps/docs/scripts/*.mjs
apps/docs/scripts/*.test.mjs
!apps/docs/lib/article-metadata.mjs
!apps/docs/lib/article-registry.mjs
!apps/docs/lib/article-structure.mjs
!apps/docs/lib/help-analytics.mjs
!apps/docs/lib/help-center-home.mjs
!apps/docs/lib/help-center-seo.mjs
!apps/docs/lib/help-nav.mjs
!apps/docs/lib/help-search.mjs

# Build-critical web postbuild script
!apps/web/scripts/
!apps/web/scripts/sync-standalone-assets.mjs
!apps/web/scripts/ensure-sharp-runtime-traces.mjs
!apps/web/scripts/resolve-package-json.mjs
!apps/web/scripts/stage-runtime-data.mjs
!apps/web/scripts/fix-standalone-loopback-hostname.mjs

# Source-deploy fallback still needs these runtime directories from apps/web.
!apps/web/scripts/
!apps/web/scripts/sync-standalone-assets.mjs
!apps/web/content/
!apps/web/content/**
!apps/web/lib/docs/
!apps/web/lib/docs/**
!apps/web/lib/chat/knowledge/topics/
!apps/web/lib/chat/knowledge/topics/**
!apps/web/lib/e2e/
!apps/web/lib/e2e/**
!apps/web/lib/submission-agent/artifacts/
!apps/web/lib/submission-agent/artifacts/**

# Runtime data read from source at request time. Re-open only these exact files
# through the documentation and tooling exclusions above.
!CHANGELOG.md
!/docs/
/docs/*
!/docs/FEATURE_REGISTRY.md
!/scripts/
/scripts/*
!apps/eve-pilot/identities/jovie/instructions.md
!apps/eve-pilot/identities/summer/instructions.md

# The HUD reads this at runtime; allow only the ledger, not test artifacts.
!apps/web/tests/
apps/web/tests/*
!apps/web/tests/quarantine.json
