+                ?.closest('button, a') === element,
+            hitAtRight:
+              document
+                .elementFromPoint(rect.right - 1, rect.top + rect.height / 2)
+                ?.closest('button, a') === element,
+          };
+        });
+        // The canonical focus ring is 2px plus a 2px offset.
+        for (const inset of [
