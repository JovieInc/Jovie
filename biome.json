{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "maxSize": 3000000,
    "includes": [
      "**/*",
      "!!.claude",
      "!apps/web/drizzle/migrations/**",
      "!**/.context/**",
      "!.agents/skills/gstack/**",
      "!.claude/skills/gstack/**",
      "!!storybook-static",
      "!**/*.html",
      "!**/.next",
      "!apps/web/public/pitch/**",
      "!apps/web/styles/generated/**",
      "!apps/web/lib/design/generated/**",
      "!apps/web/design/oklch-palette.json",
      "!apps/web/typecheck-tests-baseline.json",
      "!scripts/shared-ui-visual-arbitrary.baseline.json",
      "!apps/web/tests/unit/design-system/source-identity.baseline.json",
      "!packages/action-contracts/generated/**",
      "!**/*.a11y-red.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "a11y": {
        "noAccessKey": "error",
        "noAriaHiddenOnFocusable": "error",
        "noAriaUnsupportedElements": "error",
        "noAutofocus": "error",
        "noDistractingElements": "error",
        "noHeaderScope": "error",
        "noInteractiveElementToNoninteractiveRole": "error",
        "noLabelWithoutControl": "error",
        "noNoninteractiveElementInteractions": "error",
        "noNoninteractiveElementToInteractiveRole": "error",
        "noNoninteractiveTabindex": "error",
        "noPositiveTabindex": "error",
        "noRedundantAlt": "error",
        "noRedundantRoles": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "useAltText": "error",
        "useAnchorContent": "error",
        "useAriaActivedescendantWithTabindex": "error",
        "useAriaPropsForRole": "error",
        "useAriaPropsSupportedByRole": "error",
        "useButtonType": "error",
        "useFocusableInteractive": "error",
        "useGenericFontNames": "error",
        "useHeadingContent": "off",
        "useHtmlLang": "error",
        "useIframeTitle": "error",
        "useKeyWithClickEvents": "error",
        "useKeyWithMouseEvents": "error",
        "useMediaCaption": "error",
        "useSemanticElements": "error",
        "useValidAnchor": "error",
        "useValidAriaProps": "error",
        "useValidAriaRole": "error",
        "useValidAriaValues": "error",
        "useValidAutocomplete": "error",
        "useValidLang": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noConstAssign": "error",
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noInvalidConstructorSuper": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noDuplicateObjectKeys": "error",
        "noDebugger": "error",
        "noFallthroughSwitchClause": "error",
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noArrayIndexKey": "warn"
      },
      "complexity": {
        "noUselessFragments": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "style": {
        "useConst": "error",
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "global": "Use 'globalThis' instead of 'global' for cross-environment compatibility",
              "alert": "Use sonner's toast.error() or toast.success() — native alert() is blocking and unstyled. See AGENTS.md §4f.",
              "confirm": "Use <ConfirmDialog> from @/components/molecules/ConfirmDialog — native confirm() is blocking and unstyled. See AGENTS.md §4f.",
              "prompt": "Use <Dialog> with a controlled input — native prompt() is blocking and unstyled. See AGENTS.md §4f."
            }
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "simple-icons": "Use SocialIcon from @/components/atoms/SocialIcon. Do not import simple-icons directly."
            },
            "patterns": [
              {
                "group": ["simple-icons/*"],
                "message": "Use SocialIcon from @/components/atoms/SocialIcon. Do not import simple-icons/* directly."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.stories.tsx",
        "**/tests/**",
        "**/.storybook/**",
        "**/scripts/**",
        "**/*TableUnified.tsx",
        "**/*ProfilesUnified.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noRestrictedGlobals": "off"
          },
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "useAltText": "off"
          }
        }
      }
    },
    {
      "includes": ["**/lib/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "globals": [
      "describe",
      "it",
      "expect",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "vi",
      "test"
    ],
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "arrowParentheses": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
