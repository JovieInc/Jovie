+  }
+
+  @Test func midnightAndRevalidationCannotRegroupUntilReopen() {
+    let values = [conversation("current"), conversation("older", updatedAt: "2026-10-07T12:00:00Z")]
+    let snapshot = capture(values)
+    let tomorrow = now.addingTimeInterval(86400)
+    let changed = [conversation("older", updatedAt: "2026-10-09T00:20:00Z"), values[0]]
+    #expect(capture(changed, current: snapshot, at: tomorrow) == snapshot)
+    let frozen = AppShellDrawerRecentPolicy.groups(conversations: changed, snapshot: snapshot, scope: snapshot.scope)
+    #expect(frozen.map { $0.conversations.map(\.id) } == [["current"], ["older"]])
+    let reopened = capture(changed, at: tomorrow)
