+    let loaded = capture([conversation("late", updatedAt: "2026-10-07T23:59:00Z")], current: empty)
+    #expect(loaded.entries.map(\.id) == ["late"])
+    #expect(loaded.entries.map(\.bucket) == [.earlier])
+    #expect(capture([conversation("replacement")], current: loaded) == loaded)
+  }
+
+  @Test func boundedMembershipPreservesOrderAndLiveStatus() {
+    let values = (0..<8).map { conversation("c-\($0)") }
+    let snapshot = capture([values[0]] + values)
+    #expect(snapshot.entries.map(\.id) == Array(values.prefix(5).map(\.id)))
+    let updated = [conversation("c-0", status: "running")] + Array(values.dropFirst().reversed())
+    let visible = AppShellDrawerRecentPolicy.visible(conversations: updated, snapshot: snapshot, scope: snapshot.scope)
+    #expect(visible.map(\.id) == snapshot.entries.map(\.id))
+    #expect(visible.first?.latestTurnStatus == "running")
+    #expect(capture(updated, current: snapshot) == snapshot)
+  }
+
+  @Test func groupsUseDeviceDayIncludingFractionalAndOffsetDates() {
+    let values = [conversation("yesterday", updatedAt: "2026-10-07T23:00:00Z"),
+                  conversation("today", updatedAt: "2026-10-08T02:20:00.123+02:00")]
+    let snapshot = capture(values)
+    let groups = AppShellDrawerRecentPolicy.groups(conversations: values, snapshot: snapshot, scope: snapshot.scope)
+    #expect(groups.map(\.id) == [.today, .earlier])
+    #expect(groups.map { $0.conversations.map(\.id) } == [["today"], ["yesterday"]])
+    var local = utc
+    local.timeZone = TimeZone(identifier: "America/Los_Angeles")!
