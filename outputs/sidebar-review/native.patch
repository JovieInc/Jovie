+  }
+  private let now = ISO8601DateFormatter().date(from: "2026-10-08T00:30:00Z")!
+  private var utc: Calendar {
+    var calendar = Calendar(identifier: .gregorian)
+    calendar.timeZone = TimeZone(secondsFromGMT: 0)!
+    return calendar
+  }
+  private func conversation(
+    _ id: String, updatedAt: String = "2026-10-08T00:20:00Z",
+    createdAt: String = "2026-10-07T12:00:00Z", status: String = "completed"
+  ) -> MobileConversationSummary {
+    MobileConversationSummary(id: id, title: id, createdAt: createdAt, updatedAt: updatedAt,
+                              latestMessageRole: "assistant", latestTurnStatus: status)
+  }
+  private func capture(
+    _ values: [MobileConversationSummary], scope: String? = "account:customer",
+    current: AppShellDrawerRecentPolicy.Snapshot? = nil, at date: Date? = nil
+  ) -> AppShellDrawerRecentPolicy.Snapshot {
+    AppShellDrawerRecentPolicy.capture(conversations: values, scope: scope, current: current,
+                                      now: date ?? now, calendar: utc)
+  }
+
+  @Test func lateFirstLoadUsesArrivalDayAndFreezesOnce() {
+    let empty = capture([], at: now.addingTimeInterval(-3600))
+    #expect(empty.entries.isEmpty)
