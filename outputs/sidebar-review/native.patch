+    ),
+  ].map(match => ({ id: match[1], label: match[2], href: match[3] }));
+  expect(destinations).toEqual(
+    ADMIN_NAV_REGISTRY.map(({ id, label, href }) => ({ id, label, href }))
+  );
+  const nativePrefixes =
+    swift.match(/static let pathPrefixes = \[([\s\S]*?)\]/)?.[1] ?? '';
+  expect(
+    [...nativePrefixes.matchAll(/"([^"]+)"/g)].map(match => match[1])
+  ).toEqual(IOS_WEB_ONLY_APP_PATH_PREFIXES);
+  for (const { href } of ADMIN_NAV_REGISTRY) {
+    expect(
+      href === '/hud' ||
+        IOS_WEB_ONLY_APP_PATH_PREFIXES.some(
+          prefix => href === prefix || href.startsWith(`${prefix}/`)
+        )
+    ).toBe(true);
