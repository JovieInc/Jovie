{
  "schemaVersion": 1,
  "registryId": "jovie-continuous-audit-registry",
  "owner": "Summer",
  "implementationOwner": "Symphony",
  "status": "pilot",
  "policy": {
    "objective": "Progressively audit every meaningful code path and operational surface with bounded deterministic evidence first and qualified model review only where it adds signal.",
    "coverageIntervalDays": 90,
    "noRawModelClaims": true,
    "deduplicationKey": "familyId:partitionId:ruleId:primaryLocation:claimDigest",
    "requiredResolutionStates": [
      "fixed",
      "disproven",
      "deferred-with-expiry",
      "blocked"
    ],
    "proofTiers": ["source", "ci", "queue", "deploy", "runtime"],
    "proofTierStatuses": [
      "verified",
      "observed",
      "availability-only",
      "not-collected",
      "not-applicable"
    ],
    "providerSubstitution": "forbidden",
    "externalScheduleStatus": "proposal-only",
    "customerDataAllowed": false,
    "secretMaterialAllowed": false
  },
  "providerCatalog": [
    {
      "id": "deterministic",
      "qualificationState": "qualified",
      "models": ["none"],
      "capabilities": ["static-analysis", "tests", "metrics", "receipts"],
      "readBoundary": "repo-and-public-metadata",
      "egress": "none-except-declared-public-metadata-probes",
      "costClass": "no-model-spend"
    },
    {
      "id": "codex",
      "qualificationState": "conditional",
      "modelRegistry": "scripts/symphony/config/model-registry.json",
      "requiredCapabilities": ["review", "architecture", "root-cause"],
      "readBoundary": "sanitized-selected-scope",
      "egress": "provider-only-after-run-qualification",
      "costClass": "subscription-included",
      "perRunQualificationRequired": true
    },
    {
      "id": "cursor",
      "qualificationState": "conditional",
      "modelRegistry": "scripts/symphony/config/model-registry.json",
      "requiredCapabilities": ["review", "architecture"],
      "readBoundary": "sanitized-selected-scope",
      "egress": "provider-only-after-run-qualification",
      "costClass": "subscription-included",
      "perRunQualificationRequired": true
    },
    {
      "id": "grok",
      "qualificationState": "conditional",
      "modelRegistry": "scripts/symphony/config/model-registry.json",
      "requiredCapabilities": ["review", "architecture", "root-cause"],
      "readBoundary": "sanitized-selected-scope",
      "egress": "provider-only-after-run-qualification",
      "costClass": "subscription-included",
      "perRunQualificationRequired": true
    },
    {
      "id": "kimi",
      "qualificationState": "conditional",
      "modelRegistry": "scripts/symphony/config/model-registry.json",
      "requiredCapabilities": ["review", "code"],
      "readBoundary": "sanitized-selected-scope",
      "egress": "provider-only-after-run-qualification",
      "costClass": "subscription-included",
      "perRunQualificationRequired": true
    },
    {
      "id": "hyperagent",
      "qualificationState": "unqualified",
      "models": [],
      "requiredCapabilities": ["review", "architecture", "root-cause"],
      "readBoundary": "sanitized-selected-scope",
      "egress": "blocked-until-qualified",
      "costClass": "unknown-until-qualified",
      "perRunQualificationRequired": true,
      "failClosed": true,
      "substitutionPolicy": "forbidden",
      "qualificationBaseline": null,
      "qualificationReceiptsRequired": [
        "authentication-success",
        "exact-provider-and-model-identity",
        "read-boundary-acknowledgement",
        "no-secret-or-customer-data-egress",
        "explicit-cost-cap",
        "deterministic-fixture-eval-at-or-above-0.9",
        "structured-output-schema-pass"
      ]
    }
  ],
  "providerQualificationSchema": {
    "requiredFields": [
      "provider",
      "model",
      "modelRegistryEntryId",
      "modelCapabilities",
      "modelQuality",
      "costTier",
      "authenticatedAt",
      "modelIdentityVerified",
      "readBoundaryAcknowledged",
      "secretScanPassed",
      "customerDataExcluded",
      "costCapCents",
      "fixtureEvalPassRate",
      "structuredOutputPassed",
      "receiptLocator"
    ],
    "minimumFixtureEvalPassRate": 0.9,
    "maximumReceiptAgeHours": 24
  },
  "findingSchema": {
    "id": "continuous-audit-finding/v1",
    "requiredFields": [
      "fingerprint",
      "familyId",
      "partitionId",
      "ruleId",
      "title",
      "claim",
      "severity",
      "riskScore",
      "primaryLocation",
      "evidence",
      "source",
      "acceptance",
      "resolution"
    ],
    "severityLevels": {
      "critical": { "minimumRiskScore": 90, "responseHours": 1 },
      "high": { "minimumRiskScore": 70, "responseHours": 24 },
      "medium": { "minimumRiskScore": 40, "responseHours": 168 },
      "low": { "minimumRiskScore": 1, "responseHours": 720 }
    },
    "acceptanceStates": ["candidate", "validated", "disproven"],
    "evidenceRequired": {
      "minimumDirectItems": 1,
      "modelClaimMayBeSoleEvidence": false,
      "requiredItemFields": [
        "tier",
        "kind",
        "direct",
        "locator",
        "observedAt",
        "summary"
      ]
    }
  },
  "selectionPolicy": {
    "baseWeight": 1,
    "changedPathMultiplier": 4,
    "highRiskMultiplier": 3,
    "recentIncidentMultiplier": 3,
    "overdueMultiplier": 2,
    "crossModelSampleRate": 0.2,
    "crossModelMinimumForCritical": 1,
    "sameProviderFamilyCountsAsIndependent": false
  },
  "auditFamilies": [
    {
      "id": "security",
      "name": "Security",
      "scope": {
        "partitions": [
          "trust-boundaries",
          "workflows-and-actions",
          "dependencies"
        ],
        "partitionStrategy": "changed trust boundary plus rotating security slice"
      },
      "providerEligibility": {
        "deterministicFirst": true,
        "allowedProviders": [
          "deterministic",
          "codex",
          "grok",
          "cursor",
          "hyperagent"
        ],
        "requiredModelCapabilities": ["review", "root-cause"],
        "minimumQuality": 82,
        "crossCheck": "different-provider-required-for-critical"
      },
      "readBoundary": {
        "allow": [
          "tracked source",
          "sanitized lockfile metadata",
          "public advisory metadata"
        ],
        "deny": [
          "secret values",
          "customer rows",
          "cookies",
          "tokens",
          "private runtime payloads"
        ]
      },
      "costBudget": {
        "deterministicMinutes": 20,
        "modelRuns": 2,
        "maxInputTokensPerRun": 40000,
        "maxOutputTokensPerRun": 6000,
        "maxSpendCents": 0
      },
      "deterministicProbes": [
        "bash scripts/security/verify-gitleaks-coverage.sh",
        "pnpm run skill-governance:check",
        "python3 .github/scripts/test-security-suppression-audit.py"
      ],
      "evidenceSchema": {
        "schemaRef": "continuous-audit-finding/v1",
        "requiredKinds": ["test-output", "source-location", "advisory"],
        "requiredProofTiers": ["source", "ci", "queue", "deploy", "runtime"]
      },
      "riskRubric": {
        "baseDimensions": [
          "exploitability",
          "blast-radius",
          "data-sensitivity",
          "reversibility"
        ],
        "criticalOverrides": [
          "credential exposure",
          "cross-tenant access",
          "remote code execution",
          "payment bypass"
        ]
      },
      "recurrence": {
        "events": [
          "security-sensitive-change",
          "new-advisory",
          "suppression-change"
        ],
        "cadenceProposal": "daily-delta-weekly-rotation",
        "coverageWindowDays": 30,
        "scheduleStatus": "proposal-only"
      },
      "acceptanceState": {
        "state": "draft",
        "owner": "Security",
        "acceptedAt": null
      }
    },
