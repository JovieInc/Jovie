{
  "name": "@jovie/cli",
  "private": false,
  "type": "module",
  "description": "Jovie for AI agents: extract public creator data, create Spotify artist profiles, and read public artist data. CLI + MCP server + agent skill.",
  "keywords": [
    "mcp",
    "mcp-server",
    "agent",
    "ai-agent",
    "skill",
    "music",
    "artist",
    "spotify",
    "link-in-bio",
    "cli"
  ],
  "mcpName": "io.github.JovieInc/jovie",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JovieInc/Jovie.git",
    "directory": "packages/jovie-cli"
  },
  "bugs": {
    "url": "https://github.com/JovieInc/Jovie/issues"
  },
  "homepage": "https://jov.ie/cli",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "bin": {
    "jovie": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "chaos:gate": "node scripts/chaos-blackbox.mjs --bin dist/cli.js --profile pr && node scripts/chaos-mutation-proof.mjs --dist dist",
    "dev": "tsx src/cli.ts",
    "lint": "biome check .",
    "pack:dry": "tsx scripts/pack-dry.ts",
    "test": "vitest run",
    "test:ci": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:fast": "node scripts/test-fast.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.2"
  }
}
