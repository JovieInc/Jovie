{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.JovieInc/jovie",
  "title": "Jovie",
  "description": "Create a music artist's Jovie profile from a Spotify URL and read public artist data.",
  "websiteUrl": "https://jov.ie/cli",
  "repository": {
    "url": "https://github.com/JovieInc/Jovie",
    "source": "github",
    "subfolder": "packages/jovie-cli"
  },
  "version": "0.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@jovie/cli",
      "version": "0.0.0",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
    }
  ]
}
