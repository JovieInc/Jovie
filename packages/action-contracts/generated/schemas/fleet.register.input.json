{
  "title": "fleet.register input v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "runtimeClass": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "capabilities": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "tools": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "connectors": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "offline"
      ]
    },
    "specialization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "workerId",
    "runtimeClass",
    "capabilities",
    "tools",
    "connectors",
    "availability"
  ],
  "additionalProperties": false
}
