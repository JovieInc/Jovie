{
  "title": "release.create invocation v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "context": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "web",
            "ios",
            "electron",
            "app_intent",
            "widget",
            "cli",
            "mcp",
            "chat_tool",
            "extension"
          ]
        },
        "clientVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "profileId",
        "channel"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "releaseType": {
          "type": "string",
          "enum": [
            "single",
            "ep",
            "album",
            "compilation",
            "live",
            "mixtape",
            "music_video",
            "other"
          ]
        },
        "releaseDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "revealDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "genres": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "explicit": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "releaseType"
      ],
      "additionalProperties": false
    },
    "confirmationToken": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "idempotencyKey",
    "context",
    "input"
  ],
  "additionalProperties": false
}
