{
  "title": "fleet.register output v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "worker": {
      "type": "object",
      "properties": {
        "workerId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "runtimeClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "capabilities": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "tools": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "connectors": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "busy",
            "offline"
          ]
        },
        "specialization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "fleet:register",
              "fleet:read",
              "work:next",
              "work:claim",
              "work:report",
              "defect:report"
            ]
          }
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "required": [
        "workerId",
        "runtimeClass",
        "capabilities",
        "tools",
        "connectors",
        "availability",
        "scopes",
        "registeredAt",
        "updatedAt",
        "revoked"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "worker"
  ],
  "additionalProperties": false
}
