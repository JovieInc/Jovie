{
  "title": "defect.report invocation v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "context": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "web",
            "ios",
            "electron",
            "app_intent",
            "widget",
            "cli",
            "mcp",
            "chat_tool",
            "extension"
          ]
        },
        "clientVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "profileId",
        "channel"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "leaseId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "apiCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "ref",
              "summary"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "leaseId",
        "title",
        "command",
        "apiCode",
        "details",
        "evidence"
      ],
      "additionalProperties": false
    },
    "confirmationToken": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "idempotencyKey",
    "context",
    "input"
  ],
  "additionalProperties": false
}
