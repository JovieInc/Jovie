{
  "title": "release.create input v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "releaseType": {
      "type": "string",
      "enum": [
        "single",
        "ep",
        "album",
        "compilation",
        "live",
        "mixtape",
        "music_video",
        "other"
      ]
    },
    "releaseDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "revealDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "genres": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "explicit": {
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "releaseType"
  ],
  "additionalProperties": false
}
