* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
.claude/skills/vercel-composition-patterns/** -whitespace
.claude/skills/vercel-react-best-practices/** -whitespace
# pnpm patches of tab-indented upstream files contain a diff-prefix space
# before those tabs. That is patch syntax, not a whitespace defect.
*.patch -whitespace
# Regenerate from scripts/artist-launch-policy.mjs; never edit the inventory.
docs/product/generated/artist-launch-inventory.json linguist-generated=true

# JOV-8754: vendored third-party GitHub Actions stay byte-identical to upstream
# (integrity-checked by scripts/vendor-actions.mjs); skip whitespace checks.
.github/actions/vendor/** -whitespace

# Visual-test baselines live in Git LFS so they stop counting against the
# tracked-bytes budget (docs/ci/repository-health.md). CI fetches them only in
# browser-test jobs, through .github/actions/lfs-pull, from a cache keyed by
# their pointers. repo-hygiene-guard rejects one committed as a plain blob.
apps/web/tests/e2e/__snapshots__/**/*.png filter=lfs diff=lfs merge=lfs -text
# UI judge calibration captures (JOV-7713). Read by scripts/invariants/ui-escape-holdout.test.mjs,
# which checks them by their LFS oid when only the pointer is checked out.
docs/screenshots/ui-escape-holdout/*.png filter=lfs diff=lfs merge=lfs -text
# Product screenshot catalog (served at /product-screenshots/* through the
# apps/web/public symlinks). Deploy, Playwright and Storybook jobs pull them
# through .github/actions/lfs-pull; materialize-vercel-static refuses to deploy
# a pointer. The two onboarding captures stay plain blobs because
# ArtistProfileHowItWorks.tsx imports them at build time.
apps/web/screenshot-catalog/current/*.png filter=lfs diff=lfs merge=lfs -text
apps/web/screenshot-catalog/current/onboarding-dsp-desktop.png -filter -diff -merge binary
apps/web/screenshot-catalog/current/onboarding-handle-desktop.png -filter -diff -merge binary
