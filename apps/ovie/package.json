{
  "name": "@jovie/ovie",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "node scripts/routes.mjs && next dev --port 3105",
    "build": "node scripts/routes.mjs && NODE_OPTIONS=--max-old-space-size=8192 next build --turbopack",
    "start": "next start --port 3105",
    "certify:shell": "node scripts/app-shell-invariants.mjs",
    "typecheck": "node scripts/routes.mjs && next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "biome check ."
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@jovie/ui": "workspace:*",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "@jovie/web": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "@statsig/statsig-node-core": "^0.23.1",
    "workflow": "4.8.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "^6.0.3",
    "vitest": "5.0.3",
    "babel-plugin-react-compiler": "19.1.0-rc.3"
  }
}
