{
  "name": "@jovie/ovie",
  "version": "26.8.2",
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "node scripts/routes.mjs && next dev --port 3105",
    "build": "node scripts/routes.mjs && NODE_OPTIONS=--max-old-space-size=8192 next build --turbopack",
    "start": "next start --port 3105",
    "typecheck": "node scripts/routes.mjs && next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "biome check ."
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@jovie/ui": "workspace:*",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "@jovie/web": "workspace:*",
    "@tailwindcss/postcss": "^4.2.2",
    "tailwindcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "@statsig/statsig-node-core": "^0.22.0",
    "workflow": "4.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "babel-plugin-react-compiler": "19.1.0-rc.3"
  }
}
