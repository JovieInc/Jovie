{
  "schema": "jovie-native-design-system/v1",
  "palette": "apps/web/design/ziawi-color-sot.json",
  "semantics": "apps/web/styles/design-system.css",
  "theme": "apps/ios/Jovie/DesignSystem/JovieTheme.swift",
  "bindings": [
    ["backgroundBase", "elevations.dark.canvas"],
    ["surface0", "elevations.dark.shell"],
    ["surface1", "elevations.dark.card"],
    ["surface2", "elevations.dark.elevated"],
    ["surface3", "elevations.dark.floating"],
    ["accentBlue", "accents.hex.ion"],
    ["accentPurple", "accents.hex.ultra"],
    ["accentPink", "accents.hex.pulse"],
    ["accentMint", "accents.hex.mint"],
    ["accentOrange", "accents.hex.orange"],
    ["statusDanger", "accents.hex.red"],
    ["textPrimary", "--color-text-primary-token"],
    ["textSecondary", "--color-text-secondary-token"],
    ["textTertiary", "--color-text-tertiary-token"],
    ["textInverse", "--noir-ion-text-inverse"],
    ["buttonPrimaryBackground", "--color-btn-primary-bg"],
    ["borderSubtle", "--color-border-subtle"],
    ["borderDefault", "--color-border-default"],
    ["borderStrong", "--color-border-strong"],
    ["imageForeground", "--noir-ion-text-strong"]
  ],
  "strictSources": ["apps/ios/Jovie/App/RootView.swift"],
  "exceptions": [
    {
      "path": "apps/ios/Jovie/DesignSystem/JovieTheme.swift",
      "maximum": 1,
      "reason": "QR plate must remain a known white substrate for encoded black modules; semantic app surfaces never consume this exception.",
      "owner": "JovieColor",
      "statement": "static let qrSurface = Color.white"
    }
  ],
  "paintDebt": "apps/ios/scripts/native-color-debt.json",
  "aliases": {
    "accent": "accentBlue",
    "errorText": "textPrimary",
    "release": "JovieColor.accentBlue",
    "artist": "JovieColor.accentPurple",
    "track": "JovieColor.accentBlue",
    "event": "JovieColor.accentOrange"
  }
}
