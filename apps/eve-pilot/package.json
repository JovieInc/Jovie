{
  "name": "@jovie/eve-pilot",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "smoke": "vitest run --config vitest.config.ts tests/eve-framework-smoke.test.ts",
    "start": "eve start",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@vercel/blob": "2.8.2",
    "ai": "7.0.144",
    "braintrust": "3.37.2",
    "eve": "0.72.1",
    "just-bash": "3.6.0",
    "microsandbox": "0.7.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vercel": "59.23.2",
    "vite": "8.1.6",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "patchedDependencies": {
      "eve@0.72.1": "patches/eve@0.72.1.patch"
    },
    "overrides": {
      "fast-uri": "3.1.8",
      "proxy-addr": "2.0.8",
      "source-map-js": "1.2.2",
      "brace-expansion@^1.1.7": "1.1.21",
      "brace-expansion@^5.0.0": "5.0.12",
      "smol-toml": "1.9.0",
      "undici@^6.0.0": "6.28.1",
      "undici@^7.0.0": "7.29.1",
      "@tootallnate/once": "2.0.1",
      "js-yaml@^4.0.0": "4.3.2",
      "qs@^6.0.0": "6.16.0",
      "tar@^7.0.0": "7.5.22",
      "undici@^5.0.0": "6.28.1",
      "vite": "8.1.6",
      "minimatch@10.1.1": "10.2.6"
    }
  }
}
