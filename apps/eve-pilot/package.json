{
  "name": "@jovie/eve-pilot",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "smoke": "vitest run --config vitest.config.ts tests/eve-framework-smoke.test.ts",
    "start": "eve start",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@vercel/blob": "2.8.1",
    "ai": "7.0.122",
    "braintrust": "3.36.0",
    "eve": "0.71.3",
    "just-bash": "3.6.0",
    "microsandbox": "0.7.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vercel": "59.23.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "eve@0.71.3": "patches/eve@0.71.3.patch"
    },
    "overrides": {
      "fast-uri": "3.1.8",
      "proxy-addr": "2.0.8",
      "source-map-js": "1.2.2",
      "brace-expansion@^1.1.7": "1.1.21",
      "brace-expansion@^5.0.0": "5.0.12",
      "smol-toml": "1.9.0",
      "undici@^6.0.0": "6.28.1",
      "undici@^7.0.0": "7.29.1"
    }
  }
}
