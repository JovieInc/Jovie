{
  "name": "@jovie/eve-pilot",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "smoke": "vitest run --config vitest.config.ts tests/eve-framework-smoke.test.ts",
    "start": "eve start",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@vercel/blob": "2.8.0",
    "ai": "7.0.107",
    "braintrust": "3.34.0",
    "eve": "0.63.0",
    "just-bash": "3.4.2",
    "microsandbox": "0.7.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "6.0.3",
    "vercel": "59.23.2",
    "vitest": "5.0.1"
  }
}
