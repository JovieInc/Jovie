{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "tsBuildInfoFile": ".cache/tsbuildinfo-stories",
    "skipLibCheck": true
  },
  "include": [
    "app/**/*.stories.ts",
    "app/**/*.stories.tsx",
    "components/**/*.stories.ts",
    "components/**/*.stories.tsx",
    "tests/fixtures/storybook-a11y-runner/*.stories.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "types/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".next/**"]
}
