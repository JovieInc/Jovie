      "reviewTrigger": "Remove when a semantic nested-guide color token reproduces this seam contrast."
    },
    {
      "rule": "arbitrary-shadow",
      "file": "packages/ui/atoms/button.tsx",
      "match": "shadow-[inset_0_1px_0_rgba(255,255,255,0.04),0_1px_1px_rgba(0,0,0,0.08)]",
