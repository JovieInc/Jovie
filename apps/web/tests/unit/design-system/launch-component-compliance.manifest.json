  "rules": [
    {
      "id": "raw-color",
      "pattern": "(?:(?:[a-z0-9-]+:)*(?:bg|text|border|ring|fill|stroke|outline|divide|accent|caret|decoration|from|via|to|placeholder)-\\[(?:#|rgba?\\(|hsla?\\(|oklch\\(|lch\\(|color(?:-mix)?\\()[^\\]]*\\]|(?:[a-z0-9-]+:)*(?:bg|text|border|ring|fill|stroke|outline|divide|accent|caret|decoration|from|via|to|placeholder)-(?:black|white|slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose)(?:-\\d{2,3})?(?:\\/\\d+)?|(?:color|backgroundColor|borderColor|outlineColor|fill|stroke)\\s*:\\s*['\"`](?:#|rgba?\\(|hsla?\\(|oklch\\(|lch\\(|color(?:-mix)?\\()[^'\"`]*['\"`])",
      "flags": "g",
      "maxDebt": 4
    },
    {
      "id": "arbitrary-shadow",
      "pattern": "(?:shadow|drop-shadow)-\\[[^\\]]+\\]|boxShadow\\s*:\\s*['\"`][^'\"`]+['\"`]",
      "flags": "g",
      "maxDebt": 2
    },
    {
      "id": "raw-button-clone",
      "pattern": "<button(?=[\\s/>])",
      "flags": "g",
      "maxDebt": 1
    },
    {
      "id": "local-loading-primitive",
      "pattern": "\\banimate-(?:spin|pulse)\\b|\\b(?:Loader2|LoaderCircle)\\b",
      "flags": "g",
      "maxDebt": 0
    }
  ],
  "exceptions": [
    {
      "rule": "raw-color",
      "file": "apps/web/components/shell/SidebarNavItem.tsx",
      "match": "bg-[color-mix(in_oklab,var(--linear-app-content-surface)_92%,white_8%)]",
      "maxOccurrences": 1,
      "owner": "app-shell",
      "reason": "The primary sidebar row mixes an existing semantic surface token for reviewed idle contrast.",
      "reviewTrigger": "Remove when a semantic sidebar-primary idle surface token reproduces this contrast."
    },
    {
