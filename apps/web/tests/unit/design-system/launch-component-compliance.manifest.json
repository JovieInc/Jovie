      "rule": "raw-button-clone",
      "file": "apps/web/components/shell/SidebarNavItem.tsx",
      "match": "<button",
      "maxOccurrences": 1,
      "owner": "app-shell",
      "reason": "This canonical primitive renders the native button consumed by shell navigation.",
