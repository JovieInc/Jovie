{
  "toolsListHash": "87e4a522b0ed1415e0ca53e123958ef35b15b35f4eeff2fe72cc35d3cafe32f6",
  "tools": [
    {
      "name": "artist.search_or_import",
      "title": "Find artist",
      "description": "Resolve a public Spotify/Apple artist identity or return ranked name candidates. Select an exact ID before drafting. Returns a private, seven-day draft_token; retain it for workspace.create_draft. Creates no account and does not publish.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "provider": {
            "type": "string",
            "enum": [
              "spotify",
              "apple_music"
            ]
          },
          "acquisition": {
            "default": {
              "first_touch": {}
            },
            "type": "object",
            "properties": {
              "agent_source": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "client": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "installation_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "referral_token": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "session_or_run_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "intent": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "first_touch": {
                "default": {},
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "medium": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "campaign": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "term": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "referrer": {
                    "type": "string",
                    "maxLength": 500,
                    "format": "uri"
                  },
                  "landingPath": {
                    "type": "string",
                    "maxLength": 500,
                    "format": "starts_with",
                    "pattern": "^\\/.*"
                  },
                  "claimId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "runId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "candidateId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "offerVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "first_touch"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "input",
          "acquisition"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Find artist",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "workspace.create_draft",
      "title": "Create artist draft",
      "description": "Create or resume an unpublished visibility draft using the exact artist_id and draft_token from artist.search_or_import. Retrying the same token resumes the same draft; a token for another artist is rejected. Returns claim_url: show it to the user so they can sign in on Jovie and claim the draft; the artist is matched to its Spotify identity and stays private until the user publishes. Never share draft_token. Never claims ownership, publishes or purchases.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "artist_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "draft_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "artist_id",
          "draft_token"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Create artist draft",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "release.prepare_launch",
      "title": "Prepare release launch",
      "description": "Resolve public release facts and create or resume an unpublished artist, release-page, and smart-link draft. Requires the draft capability. Returns only unresolved questions plus claim_url; when next_action is send_user_claim_url, show claim_url to the user so they can claim it on Jovie, where it stays private until they publish. Never claims, publishes, or purchases.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "draft_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "draft_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "release_url": {
            "type": "string",
            "maxLength": 1000,
            "format": "uri"
          },
          "upc": {
            "type": "string",
            "pattern": "^\\d{8,20}$"
          },
          "release_metadata": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "artist_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "release_date": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "artwork_url": {
                "type": "string",
                "maxLength": 1000,
                "format": "uri"
              },
              "upc": {
                "type": "string",
                "pattern": "^\\d{8,20}$"
              },
              "dsp_links": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 1000,
                  "format": "uri"
                }
              }
            },
            "additionalProperties": false
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "draft_id",
          "draft_token",
          "goal"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Prepare release launch",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    }
  ]
}
