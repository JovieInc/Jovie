{
  "schema": "jovie-domain-write-registry/v1",
  "doc": "One place per domain write. Direct DB writes to coreTables belong in a listed module (scripts/domain-write-guard.mjs). Every chat/MCP tool maps to a domain function, a read, a generator, or a named debt (apps/web/lib/domain/write-registry.test.ts). Rule: .claude/rules/domain-writes.md",
  "sideEffects": {
    "socialLinks": ["invalidateSocialLinksCache", "invalidateProfileCache"]
  },
  "sideEffectWaivers": {
    "apps/web/app/[username]/s/[platform]/route.ts": "click counter increment; no public-profile content changes",
    "apps/web/app/api/track/route.ts": "click counter increment; no public-profile content changes"
  },
  "coreTables": {
    "creatorProfiles": "creator_profiles",
    "discogReleases": "discog_releases",
    "discogTracks": "discog_tracks",
    "discogRecordings": "discog_recordings",
    "socialLinks": "social_links",
    "tourDates": "tour_dates",
    "audienceMembers": "audience_members",
    "notificationSubscriptions": "notification_subscriptions",
    "waitlistEntries": "waitlist_entries",
    "userProfileClaims": "user_profile_claims",
    "creatorClaimInvites": "creator_claim_invites",
    "users": "users"
  },
  "domains": [
    {
      "id": "release.catalog",
      "entity": "release",
      "module": "apps/web/lib/discography/queries.ts",
      "exports": [
        "upsertRelease",
        "upsertTrack",
        "upsertRecording",
        "upsertReleaseTrack",
        "purgeOrphanRecordings"
      ],
      "tables": ["discogReleases", "discogTracks", "discogRecordings"]
    },
    {
      "id": "release.metadata",
      "entity": "release",
      "module": "apps/web/lib/chat/release-writes.ts",
      "exports": [
        "updateOwnedReleaseMetadata",
        "updateOwnedReleaseGeneratedPitches"
      ],
      "tables": ["discogReleases"]
    },
    {
      "id": "profile.fields",
      "entity": "profile",
      "module": "apps/web/lib/services/profile/mutations.ts",
      "exports": [
        "updateProfileById",
        "updateProfileByClerkId",
        "holdLeadBuiltProfileInTx",
        "publishProfile"
      ],
      "tables": ["creatorProfiles"]
    },
    {
      "id": "social-links",
      "entity": "link",
      "module": "apps/web/lib/services/social-links/mutations.ts",
      "exports": ["createLink", "updateLink", "deleteLink", "reorderLinks"],
      "tables": ["socialLinks"]
    },
    {
      "id": "tour-dates",
      "entity": "tour date",
      "module": "apps/web/lib/events/insert.ts",
      "exports": ["insertEvent", "bulkInsertSyncedEvents"],
      "tables": ["tourDates"]
    },
    {
      "id": "subscriptions",
      "entity": "contact/audience/subscription",
      "module": "apps/web/lib/notifications/domain.ts",
      "exports": [
        "subscribeToNotificationsDomain",
        "verifyEmailOtpDomain",
        "unsubscribeFromNotificationsDomain",
        "updateNotificationPreferencesDomain"
      ],
      "tables": ["notificationSubscriptions", "audienceMembers"]
    },
    {
      "id": "waitlist.admission",
      "entity": "waitlist/admission",
      "module": "apps/web/lib/waitlist/approval.ts",
      "exports": [
        "approveWaitlistEntryInTx",
        "disapproveWaitlistEntryInTx",
        "stampWaitlistAcquisitionId"
      ],
      "tables": ["waitlistEntries", "creatorProfiles"]
    },
    {
      "id": "claim.finalize",
      "entity": "claim",
      "module": "apps/web/lib/claim/finalize.ts",
      "exports": [
        "reservePrebuiltProfileForUser",
        "claimPrebuiltProfileForUser"
      ],
      "tables": ["creatorProfiles", "userProfileClaims"]
    },
    {
      "id": "billing.status",
      "entity": "subscription/payment",
      "module": "apps/web/lib/stripe/customer-sync/update-status.ts",
      "exports": ["updateUserBillingStatus"],
      "tables": ["users"]
    },
    {
      "id": "merch.cards",
      "entity": "merch",
      "module": "apps/web/lib/merch/service.ts",
      "exports": [
        "createMerchGeneration",
        "selectMerchDesign",
        "publishMerchCard",
        "updateMerchCardDetails",
        "updateMerchCardStatus",
        "reorderMerchCards"
      ],
      "tables": []
    },
    {
      "id": "tasks",
      "entity": "tasks",
      "module": "apps/web/app/app/(shell)/dashboard/tasks/task-actions.ts",
      "exports": ["createTask"],
      "tables": []
    },
    {
      "id": "feedback.submit",
      "entity": "feedback",
      "module": "apps/web/lib/chat/submit-feedback.ts",
      "exports": ["submitChatFeedback"],
      "tables": []
    },
    {
      "id": "agent.draft-claim",
      "entity": "agent draft claim",
      "module": "apps/web/lib/agent-acquisition/draft-claim.server.ts",
      "exports": ["claimAgentDraft"],
      "tables": ["creatorProfiles"]
    },
    {
      "id": "agent.draft",
      "entity": "agent draft",
      "module": "apps/web/lib/agent-acquisition/draft-store.ts",
      "exports": ["createAgentDraft"],
      "tables": []
    },
    {
      "id": "youtube.thumbnail-review",
      "entity": "youtube",
      "module": "apps/web/lib/youtube-library/thumbnail-review.ts",
      "exports": ["registerThumbnailCandidateReview"],
      "tables": []
    },
    {
      "id": "leads.lead-claim-token",
      "entity": "lead claim token",
      "module": "apps/web/lib/leads/lead-claim-token.ts",
      "exports": ["persistLeadClaimToken"],
      "tables": ["creatorProfiles"]
    }
  ],
  "agentTools": {
