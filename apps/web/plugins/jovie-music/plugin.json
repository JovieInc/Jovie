{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "jovie-music",
  "version": "0.1.0",
  "description": "Search and fetch public music artist identities with provider provenance through Jovie.",
  "author": { "name": "Jovie", "url": "https://jov.ie" },
  "homepage": "https://jov.ie/developers",
  "repository": "https://github.com/JovieInc/Jovie",
  "keywords": ["music", "artists", "identity", "search"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Jovie Music",
        "shortDescription": "Find public artist identities and sources",
        "developerName": "Jovie",
        "category": "Productivity",
        "capabilities": ["Read"],
        "websiteURL": "https://jov.ie",
        "privacyPolicyURL": "https://jov.ie/privacy",
        "termsOfServiceURL": "https://jov.ie/terms",
        "defaultPrompt": [
          "Find Radiohead's artist identity and cite the source."
        ]
      }
    }
  }
}
