    "validate:articles": "node scripts/validate-articles.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
