{
  "name": "@jovie/docs",
  "version": "26.10.0",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/materialize-proof.mjs && pnpm run validate:articles",
    "build": "next build",
    "postbuild": "node scripts/build-pagefind.mjs",
    "start": "next start",
